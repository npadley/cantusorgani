---
import ChantPair from "../../components/ChantPair.astro";
import HymnChantLinks from "../../components/HymnChantLinks.astro";
import { hymnPairingsFor } from "../../lib/hymnpairings";
import ServiceRail from "../../components/ServiceRail.astro";
import SourceBlock from "../../components/SourceBlock.astro";
import { exportSegments } from "../../lib/exportParts";
import Layout from "../../components/Layout.astro";
import MovementNav from "../../components/MovementNav.astro";
import RecordStatusNotice from "../../components/RecordStatusNotice.astro";
import SystemStack from "../../components/SystemStack.astro";
import TypesetSwitch from "../../components/TypesetSwitch.astro";
import VespersDates from "../../components/VespersDates.astro";
import { allPieces, citedBy, jumpTargets, pagesLabel, relatedHymnSettings, volumeLabel } from "../../lib/catalog";
import { pieceHref } from "../../lib/indexes";
import type { Piece } from "../../lib/catalog";
import { hasTypeset } from "../../lib/typeset";
import { musicView } from "../../lib/music";
import { massSources } from "../../lib/references";
import { lineupsUsing } from "../../lib/vespers";
import { editionPolicy } from "../../lib/identities";

export function getStaticPaths() {
  return allPieces().map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

interface Props { readonly piece: Piece }
const { piece } = Astro.props;
// A Kyriale Mass lives at /kyriale/<n>/; its /piece/ address only redirects,
// so there is one page for it (and one search result).
const home = pieceHref(piece);
if (home !== `/piece/${piece.slug}/`) return Astro.redirect(home, 301);
const heading = piece.incipit ?? piece.title;
const printedElsewhere = citedBy(piece);
const policy = editionPolicy(piece.volume);
const relatedHymns = policy.show_related_hymns ? relatedHymnSettings(piece) : [];
// A whole Mass cited by an empty feast entry is read here, using the lender's
// original assets and part headings. A single-part citation must not substitute
// a different feast's entire Mass for the music printed here.
const referenceLinks = piece.reference ? massSources(piece) : [];
// VII's antiphon aliases link to a containing score; they do not borrow the
// whole litany or psalm as an antiphon export.
const referencedMusic = policy.borrow_whole_reference && piece.systems.length === 0 && piece.parts.length === 0 ? referenceLinks : [];
const scorePieces = referencedMusic.length > 0 ? referencedMusic : [piece];
const exportParts = exportSegments(scorePieces);
const musicPieces = scorePieces.map((p) => musicView(p));
const systemCount = musicPieces.reduce((n, p) => n + p.systems.length, 0);
// A Vesperale section prints only the day's own chants; the full order of
// Vespers, psalms and Magnificat included, is on the dated pages.
const vespersDays = piece.division === "vesperale" || piece.genre === "hymn" ? lineupsUsing(piece.slug) : [];
---

<Layout
  title={heading}
  description={`${piece.title} — Gregorian chant organ accompaniment from ${volumeLabel(piece)}, ${pagesLabel(piece)}.`}
  skipTo={systemCount > 0 ? "music" : undefined}
>
  <div class="reader-layout">
  <ServiceRail pieces={scorePieces} title={piece.title} occasion={piece}>
    <div slot="reader-tools">
      {musicPieces.map(p => <MovementNav piece={p} variant="tools" />)}
      <TypesetSwitch show={musicPieces.some(p => hasTypeset(p))} />
      {piece.jgabcUrl && (
        <p class="chant-proper ui small no-print">
          <a href={piece.jgabcUrl} target="_blank" rel="noopener">Chant for the whole Proper<span class="sr-only"> (jgabc, opens in new tab)</span></a>
          <span class="muted"> · jgabc</span>
        </p>
      )}
    </div>
  </ServiceRail>
  <article class="reading-column">
    <header class="head">
      <p class="crumb small muted ui"><a href="/">Cantus Organi</a> · {piece.section}</p>
      <h1>{heading}</h1>
      <p class="meta ui small muted">
        {piece.label}{piece.incipit ? ` · ${piece.title}` : ""}
        · printed {pagesLabel(piece)}
        · {systemCount} system{systemCount === 1 ? "" : "s"}{referencedMusic.length > 0 ? " shown below" : ""}
      </p>
    </header>

    <RecordStatusNotice piece={piece} />
    {piece.sourceNote && <p class="notice ui" role="status">{piece.sourceNote}</p>}
    {piece.reference && (
      <div class="notice ui small">
        <p>The book gives this music by reference: <q>{piece.reference}</q></p>
        {(referenceLinks.length > 0 || printedElsewhere.length > 0) && (
          <p>Music: {(referenceLinks.length > 0 ? referenceLinks : printedElsewhere).map((p, i) => (
            <>{i > 0 && " · "}<a href={pieceHref(p)}>{p.incipit ?? p.title}</a> ({volumeLabel(p)}, {pagesLabel(p)})</>
          ))}</p>
        )}
      </div>
    )}
    {vespersDays.length > 0 && (
      <div class="no-print">
        <p class="notice ui small">This page is the book's music as printed. For the whole of Vespers in the
          order sung — psalms, chapter, hymn, Magnificat and Marian antiphon — open a date below.</p>
        <VespersDates days={vespersDays} />
      </div>
    )}
    {musicPieces.map((p, i) => <MovementNav piece={p} variant="links" anchorPrefix={musicPieces.length > 1 ? `source-${i + 1}-` : ""} />)}
    {relatedHymns.length > 0 && <aside class="notice ui no-print">
      <h2>{policy.related_hymns_heading}</h2>
      <p class="small">Other settings of these hymn incipits. Follow each source's printed verses and usage.</p>
      <ul>{relatedHymns.map((p) => <li><a href={pieceHref(p)}>{p.title}</a> · {pagesLabel(p)}</li>)}</ul>
    </aside>}
    <HymnChantLinks slug={piece.slug} />
    {musicPieces.map((p, i) => <>
      {musicPieces.length > 1 && <h2>{p.incipit ?? p.title} · {volumeLabel(p)}, {pagesLabel(p)}</h2>}
      <SystemStack piece={p} exportParts={exportParts} id={i === 0 ? "music" : `music-${i + 1}`} anchorPrefix={musicPieces.length > 1 ? `source-${i + 1}-` : ""} />
    </>)}
    <SourceBlock pieces={scorePieces} />
    {/* Headings carry their own chant links; the old pairing box would be a second set. */}
    {!hymnPairingsFor(piece.slug).length && !musicPieces.some((p) => jumpTargets(p).some((t) => t.chantUrl)) && <ChantPair piece={piece} />}
    <p class="edit-link small muted ui no-print">
      <a href={`/corrections/?target=piece:${piece.slug}`}>Report an error</a> ·
      <a href={`/admin/edit/?target=piece:${piece.slug}`}>Edit</a> <span>(editors)</span>
    </p>
  </article>
  </div>
</Layout>

<style>
  @media print { .reader-layout { display: block; } }
  .reading-column { min-width: 0; }
  @media screen and (width < 62rem) {
    .reader-layout { display: flex; flex-direction: column; }
    .reader-layout > :global(.service-rail) { order: 1; }
  }
  @media screen and (min-width: 62rem) {
    .reader-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: var(--s-4); align-items: start; }
    .reading-column { grid-column: 2; grid-row: 1; }
    .reader-layout > :global(.service-rail) { grid-column: 1; grid-row: 1; }
  }
  .edit-link { margin: var(--s-5) 0 0; padding-top: var(--s-2); border-top: 1px solid var(--rule); }
  .edit-link a { color: var(--ink-muted); }
  .head { margin-bottom: var(--s-4); }
  .crumb { margin: 0 0 var(--s-1); }
  .crumb a { color: var(--ink-muted); }
  h1 { margin: 0 0 var(--s-1); }
  .meta { margin: 0; }
  .chant-proper { margin: 0 0 var(--s-3); }
  .chant-proper a { min-height: var(--tap-min); display: inline-flex; align-items: center; }
</style>
