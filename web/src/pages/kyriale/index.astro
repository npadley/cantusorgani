---
import Layout from "../../components/Layout.astro";
import PieceList from "../../components/PieceList.astro";
import { allPieces } from "../../lib/catalog";
import { kyrialeIndex } from "../../lib/indexes";

const groups = kyrialeIndex(allPieces());
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "");
---

<Layout title="Kyriale" description="The eighteen Ordinaries of the Mass, the Credos and chants ad libitum, with organ accompaniment.">
  <div class="prose">
    <p class="crumb small muted ui"><a href="/">Cantus Organi</a></p>
    <h1>Kyriale</h1>
    <p class="muted">
      The Ordinary of the Mass from Nova Organi Harmonia, part V. To find the
      Mass for a particular day, use the <a href="/calendar/">calendar</a>.
    </p>
  </div>

  <nav class="toc ui small" aria-label="On this page">
    {groups.map((g) => <a href={`#${slug(g.heading)}`}>{g.heading}</a>)}
  </nav>

  {groups.map((g) => (
    <section>
      <h2 id={slug(g.heading)}>{g.heading}</h2>
      <PieceList pieces={g.pieces} numbered={g.heading === "Ordinaries of the Mass"} />
    </section>
  ))}
</Layout>

<style>
  .crumb { margin: 0 0 var(--s-1); }
  .crumb a { color: var(--ink-muted); }
  .toc { display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); margin: var(--s-4) 0; }
  .toc a { min-height: var(--tap-min); display: inline-flex; align-items: center; }
  h2 { margin-top: var(--s-5); padding-bottom: var(--s-2); border-bottom: 1px solid var(--rule); scroll-margin-top: var(--s-4); }
</style>
