---
import PieceNeighbours from "../../components/PieceNeighbours.astro";
import MoreFor from "../../components/MoreFor.astro";
import ChantPair from "../../components/ChantPair.astro";
import ServiceRail from "../../components/ServiceRail.astro";
import SourceBlock from "../../components/SourceBlock.astro";
import { exportSegments } from "../../lib/exportParts";
import Layout from "../../components/Layout.astro";
import RecordStatusNotice from "../../components/RecordStatusNotice.astro";
import MovementNav from "../../components/MovementNav.astro";
import SystemStack from "../../components/SystemStack.astro";
import TypesetSwitch from "../../components/TypesetSwitch.astro";
import { neighbours, moreFor } from "../../lib/indexes";
import { allPieces, ordinaryMasses } from "../../lib/catalog";
import type { Piece } from "../../lib/catalog";
import { hasTypeset } from "../../lib/typeset";

export function getStaticPaths() {
  return ordinaryMasses().map((piece) => ({
    params: { mass: piece.label.toLowerCase() },
    props: { piece },
  }));
}

interface Props { readonly piece: Piece }
const { piece } = Astro.props;
const navigation = neighbours(allPieces(), piece);
const more = moreFor(allPieces(), { piece });
const exportParts = exportSegments([piece]);
---

<Layout
  title={`Missa ${piece.label} — ${piece.incipit ?? piece.title}`}
  description={`Missa ${piece.label} (${piece.incipit ?? piece.title}) with organ accompaniment, Nova Organi Harmonia part V.`}
  skipTo="music"
>
  <div class="reader-layout">
  <ServiceRail pieces={[piece]} title={`Missa ${piece.label}`}>
    <div slot="reader-tools">
      <MovementNav piece={piece} variant="tools" />
      <TypesetSwitch show={hasTypeset(piece)} />
    </div>
  </ServiceRail>
  <article class="reading-column">
    <header class="head">
      <p class="crumb small muted ui">
        <a href="/">Cantus Organi</a> · <a href="/kyriale/">Kyriale</a>
      </p>
      <h1>Missa {piece.label}</h1>
      <p class="lede">{piece.incipit ?? piece.title}</p>
      <p class="meta ui small muted">
        {piece.title} · printed pp. {piece.printedPages[0]}–{piece.printedPages[1]}
        · {piece.systems.length} systems
      </p>
    </header>

    <RecordStatusNotice piece={piece} />

    <MovementNav piece={piece} variant="links" />

    <SystemStack piece={piece} exportParts={exportParts} id="music" />
    <SourceBlock piece={piece} />
    <ChantPair piece={piece} />
    <PieceNeighbours {...navigation} />
    <MoreFor {...more} />
    <p class="edit-link small muted ui no-print">
      <a href={`/corrections/?target=piece:${piece.slug}`}>Report an error</a> ·
      <a href={`/admin/edit/?target=piece:${piece.slug}`}>Edit</a> <span>(editors)</span>
    </p>
  </article>
  </div>
</Layout>

<style>
  @media print { .reader-layout { display: block; } }
  .reading-column { min-width: 0; }
  @media screen and (width < 62rem) {
    .reader-layout { display: flex; flex-direction: column; }
    .reader-layout > :global(.service-rail) { order: 1; }
  }
  @media screen and (min-width: 62rem) {
    .reader-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: var(--s-4); align-items: start; }
    .reading-column { grid-column: 2; grid-row: 1; }
    .reader-layout > :global(.service-rail) { grid-column: 1; grid-row: 1; }
  }
  .edit-link { margin: var(--s-5) 0 0; padding-top: var(--s-2); border-top: 1px solid var(--rule); }
  .edit-link a { color: var(--ink-muted); }
  .head { margin-bottom: var(--s-4); }
  .crumb { margin: 0 0 var(--s-1); }
  .crumb a { color: var(--ink-muted); }
  h1 { margin: 0; }
  .lede { font-size: var(--step-1); margin: 0 0 var(--s-1); font-style: italic; }
  .meta { margin: 0; }
</style>
