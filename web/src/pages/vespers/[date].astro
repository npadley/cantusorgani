---
import VespersPage from "../../components/VespersPage.astro";
import { loadLineup } from "../../lib/vespers";
import type { LineupDay } from "../../lib/vespers";

// II Vespers of each date with a lineup (on the Vigil of Christmas, that
// evening's I Vespers of Christmas).
export function getStaticPaths() {
  return [...loadLineup().days.values()].map((day) => ({ params: { date: day.date }, props: { day } }));
}
interface Props { readonly day: LineupDay }
const { day } = Astro.props;
---
<VespersPage day={day} />
