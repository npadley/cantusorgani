---
import ExportBar from "../../components/ExportBar.astro";
import Layout from "../../components/Layout.astro";
import LineupStack from "../../components/LineupStack.astro";
import { hasNotation } from "../../lib/chants";
import { observance } from "../../lib/liturgy";
import { consoleLine, exportLineup, loadLineup, sections } from "../../lib/vespers";
import type { LineupDay } from "../../lib/vespers";

// A page for each Sunday with a full Vespers lineup: II Vespers of that date.
// (/vespers/<date>/i/ is kept for I Vespers, sung the evening before.)
export function getStaticPaths() {
  return [...loadLineup().days.values()].map((day) => ({ params: { date: day.date }, props: { day } }));
}

interface Props { readonly day: LineupDay }
const { day } = Astro.props;
const o = observance(day.office);
const title = o?.titleEn ?? day.office;
const [y, m, d] = day.date.split("-").map(Number);
const longDate = new Date(Date.UTC(y ?? 1970, (m ?? 1) - 1, d ?? 1)).toLocaleDateString("en-GB", {
  weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
});
const secs = sections(day);
const nav = secs.filter((s) => s.nav !== null);
const notation = day.items.some((i) => !i.repeat && hasNotation(i.chant));
const [flex, name] = day.office.split(":");
---

<Layout title={`Vespers: ${title}`} skipTo="initium"
        description={`Sunday Vespers for the ${title}, in the order sung — organ accompaniment from Nova Organi Harmonia.`}>
  <div class="prose">
    <p class="crumb small muted ui">
      <a href="/">Cantus Organi</a> · <a href="/calendar/">Calendar</a> · <a href={`/day/${flex}/${name}/`}>{title}</a>
    </p>
    <h1>{title}</h1>
    {o && <p class="lede">{o.titleLa} · ad Vesperas</p>}
    <p class="meta ui small muted">{day.vespers} Vespers · {longDate} · 1962 rubrics · Nova Organi Harmonia VIII</p>
    <p class="console ui">{consoleLine(day)}</p>
  </div>

  <nav class="order ui no-print" aria-label="Order of Vespers">
    {nav.map((s) => <a href={`#${s.anchor}`}>{s.nav}</a>)}
  </nav>
  {notation && (
    <label class="chant-toggle ui small no-print">
      <input type="checkbox" data-chant-toggle />
      Show the chant with each antiphon and hymn
    </label>
  )}

  <LineupStack day={day} />

  <ExportBar pieces={[]} segments={exportLineup(day)} title={`Vespers — ${title}, ${longDate}`} />
</Layout>

<style>
  .crumb { margin: 0 0 var(--s-1); }
  .crumb a { color: var(--ink-muted); }
  .lede { font-style: italic; font-size: var(--step-1); margin: 0 0 var(--s-1); }
  .meta { margin: 0 0 var(--s-2); }
  .console { margin: 0 0 var(--s-3); font-weight: 600; }
  .order {
    display: flex; flex-wrap: wrap; gap: 0 var(--s-2); align-items: center;
    margin: 0 0 var(--s-3); padding-bottom: var(--s-2); border-bottom: 1px solid var(--rule);
    scroll-margin-top: var(--s-4);
  }
  .order a {
    min-height: var(--tap-min); display: inline-flex; align-items: center; padding: 0 var(--s-2);
  }
  .chant-toggle {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: var(--tap-min); margin: 0 0 var(--s-3); cursor: pointer;
  }
  .chant-toggle input { width: 1.25rem; height: 1.25rem; margin: 0; }
</style>

<script>
  import { initChantNotation } from "../../scripts/chantNotation";
  initChantNotation();
</script>
