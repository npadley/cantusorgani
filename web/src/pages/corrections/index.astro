---
import Layout from "../../components/Layout.astro";
import { CORRECTIONS_ENDPOINT, TURNSTILE_SITE_KEY } from "../../lib/config";
import { allPieces, pagesLabel } from "../../lib/catalog";

// A section the page misses or names wrongly: fixed by an editor on the
// admin's Sections screen, for Propers and Kyriale Masses alike.
const SECTIONS_HINT = "which system, and what the book prints there, e.g. system 12: the Gradual starts here (Grad. II)";

// The field list is the same vocabulary the Worker accepts. A free-text field
// name would be rejected at the boundary anyway, so offering one would only
// waste the submitter's time.
const FIELDS = [
  { value: "title", label: "Title", hint: "e.g. In Festis Solemnibus 1" },
  { value: "incipit", label: "Incipit", hint: "e.g. Kyrie fons bonitatis" },
  { value: "mode", label: "Mode", hint: "I to VIII (or 1 to 8)" },
  { value: "genre", label: "Genre", hint: "kyrie, gloria, credo, …" },
  { value: "printedPages", label: "Printed pages", hint: "e.g. 5-10" },
  { value: "sections", label: "A part is missing or mislabelled", hint: SECTIONS_HINT },
] as const;

const pieces = allPieces();
const configured = CORRECTIONS_ENDPOINT.length > 0 && TURNSTILE_SITE_KEY.length > 0;
---

<Layout
  title="Corrections"
  description="Report an error in the Cantus Organi catalogue."
>
  <div class="prose">
    <h1>Corrections</h1>
    <p>
      This catalogue was assembled from a 1942 printed index and automatic
      matching, and parts of it have never been checked by a person. If something
      is wrong, telling us is the fastest way to fix it.
    </p>
    <p class="muted small">
      Corrections go into a queue, are reviewed by hand, and land in the public
      dataset as a recorded change: see the <a href="/corrections/log/">corrections log</a>.
      The page images themselves are scans of the printed edition and are not edited.
    </p>
  </div>

  {!configured && (
    <div class="notice" role="status">
      <strong>Corrections are not configured in this build.</strong>
      The endpoint or the Turnstile key is missing, so the form below is
      disabled. This is expected in local development.
    </div>
  )}

  <form id="correction-form" class="ui" novalidate>
    <p id="target-fixed" class="field" hidden>Reporting on: <strong id="target-label"></strong> ·
      <a href="/corrections/">choose something else</a></p>
    <div class="field" id="piece-row">
      <label for="pieceId">Which piece?</label>
      <select id="pieceId" name="pieceId" required>
        <option value="">Choose a piece…</option>
        {pieces.map((p) => (
          <option value={p.slug} data-title={p.title} data-incipit={p.incipit ?? ""} data-mode={p.mode ?? ""}
                  data-genre={p.genre} data-printed-pages={`${p.printedPages[0]}-${p.printedPages[1]}`}>
            {p.label} · {p.incipit ?? p.title} ({pagesLabel(p)})
          </option>
        ))}
      </select>
    </div>

    <div class="field">
      <label for="field">What is wrong?</label>
      <select id="field" name="field" required>
        {FIELDS.map((f) => <option value={f.value} data-hint={f.hint}>{f.label}</option>)}
      </select>
      <p id="field-hint" class="small muted"></p>
      <p id="field-now" class="small" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="proposedValue">What should it be?</label>
      <input id="proposedValue" name="proposedValue" type="text" required
             autocomplete="off" maxlength="160" />
    </div>

    <div class="field">
      <label for="note">Anything else? <span class="muted">(optional, not published)</span></label>
      <textarea id="note" name="note" rows="3" maxlength="2000"
                placeholder="How do you know? A source reference helps most."></textarea>
      <p class="small muted">
        Notes are read by the maintainer during review and are never shown on the
        site.
      </p>
    </div>

    {configured && (
      <div class="cf-turnstile" data-sitekey={TURNSTILE_SITE_KEY} data-theme="auto"></div>
    )}

    <button id="submit" type="submit" disabled={!configured}>Send correction</button>
    <p id="form-status" class="small" role="status" aria-live="polite"></p>
  </form>

  <section class="queue">
    <h2>Recent corrections</h2>
    <p class="small muted">
      Recent reports and what happened to them. The piece or item, field,
      proposed value and status are shown — never the submitter's note.
    </p>
    <div id="queue-list" aria-live="polite">
      <p class="muted small">Loading…</p>
    </div>
  </section>
</Layout>

{configured && (
  <script is:inline async defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>
)}

<style>
  form { max-width: var(--measure); margin: var(--s-4) 0; }
  .field { margin-bottom: var(--s-4); }
  label { display: block; margin-bottom: var(--s-1); font-size: var(--step--1); }
  input, select, textarea {
    width: 100%; font: inherit; font-family: var(--font-ui);
    min-height: var(--tap-min); padding: var(--s-2) var(--s-3);
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule); border-radius: var(--radius);
  }
  textarea { min-height: 5rem; resize: vertical; }
  .field p { margin: var(--s-1) 0 0; }
  #form-status { margin-top: var(--s-2); min-height: 1.4em; }
  #form-status[data-state="error"] { color: var(--warn-ink); }
  #form-status[data-state="ok"] { color: var(--accent); }
  .cf-turnstile { margin-bottom: var(--s-3); }

  .queue { margin-top: var(--s-6); padding-top: var(--s-3); border-top: 1px solid var(--rule); }
  .queue table { width: 100%; border-collapse: collapse; font-family: var(--font-ui); font-size: var(--step--1); }
  .queue th { text-align: left; font-weight: 600; color: var(--ink-muted); padding: var(--s-1) var(--s-2); border-bottom: 1px solid var(--rule); }
  .queue td { padding: var(--s-2); border-bottom: 1px solid var(--rule); vertical-align: top; }
  .queue .status { text-transform: capitalize; white-space: nowrap; }
  .queue .accepted { color: var(--accent); }
  .queue-scroll { overflow-x: auto; }
</style>

<script>
  import { CORRECTIONS_ENDPOINT } from "../../lib/config";
  import { describeTarget } from "../../lib/admin/targets";
  import type { Targets } from "../../lib/admin/targets";

  interface PublicRow {
    readonly id: number;
    readonly pieceId: string;
    readonly target?: string | null;
    readonly field: string;
    readonly proposedValue: string;
    readonly status: string;
    readonly createdAt: string;
  }

  const form = document.getElementById("correction-form") as HTMLFormElement | null;
  const status = document.getElementById("form-status");
  const submit = document.getElementById("submit") as HTMLButtonElement | null;
  const hint = document.getElementById("field-hint");
  const fieldSelect = document.getElementById("field") as HTMLSelectElement | null;
  const queue = document.getElementById("queue-list");

  function say(message: string, state: "ok" | "error" | "" = ""): void {
    if (!status) return;
    status.textContent = message;
    if (state) status.setAttribute("data-state", state);
    else status.removeAttribute("data-state");
  }

  const pieceSelect = document.getElementById("pieceId") as HTMLSelectElement | null;
  const now = document.getElementById("field-now");
  const CURRENT: Readonly<Record<string, string>> = {
    title: "title", incipit: "incipit", mode: "mode", genre: "genre", printedPages: "printedPages",
  };

  // The chosen field's current value for the chosen piece, so the reader sees
  // what they are about to change; Mode is greyed out for a Proper, whose
  // parts each have their own mode.
  /** A report on a part or Vespers item: what it names, fixed. */
  let fixed: { target: string; pieceId: string; values: Readonly<Record<string, string>> } | null = null;

  function syncHint(): void {
    if (fixed) { syncFixed(); return; }
    const option = fieldSelect?.selectedOptions[0];
    if (hint) hint.textContent = option?.dataset["hint"] ?? "";
    const piece = pieceSelect?.selectedOptions[0];
    const proper = piece?.dataset["genre"] === "proper";
    const modeOption = fieldSelect?.querySelector<HTMLOptionElement>('option[value="mode"]');
    if (modeOption) modeOption.disabled = proper;
    // Masses also have named sections; allow reports of missing ones even
    // when the catalogue has not listed any yet.
    const sectionsOption = fieldSelect?.querySelector<HTMLOptionElement>('option[value="sections"]');
    if (sectionsOption) sectionsOption.disabled = Boolean(piece?.value) && !proper && piece?.dataset["genre"] !== "mass_ordinary";
    if (proper && fieldSelect?.value === "mode") {
      if (now) now.textContent = "A Proper has no single mode: each of its parts has its own. Choose another field.";
      return;
    }
    const key = CURRENT[fieldSelect?.value ?? ""];
    const value = piece && piece.value && key ? piece.dataset[key] ?? "" : "";
    if (now) now.textContent = piece && piece.value && key ? `Now: ${value || "(none)"}` : "";
  }
  fieldSelect?.addEventListener("change", syncHint);
  pieceSelect?.addEventListener("change", syncHint);
  syncHint();

  // Deep links: /corrections/?target=piece:<slug> from a piece page, or a
  // part (part:<slug>/<part>) or Vespers item (vespers:...) from its "Report" link.
  const params = new URLSearchParams(location.search);
  const askedTarget = params.get("target");
  const piece = params.get("piece") ?? (askedTarget?.startsWith("piece:") ? askedTarget.slice(6) : null);
  const field = params.get("field");
  if (piece && pieceSelect) pieceSelect.value = piece;
  if (field && fieldSelect) fieldSelect.value = field;
  if (piece || field) syncHint();

  const KIND_FIELDS: Readonly<Record<string, readonly { value: string; label: string; hint: string; key: string }[]>> = {
    part: [
      { value: "startSystem", label: "Where it starts", hint: "the system of the piece it starts on, counting from 1", key: "start_system" },
      { value: "gregobaseId", label: "Its chant (GregoBase id)", hint: "the number in gregobase.selapa.net/chant.php?id=…, or none", key: "chant" },
      { value: "sections", label: "It is mislabelled, or a part is missing", hint: "which system, and what the book prints there, e.g. it is the Tract (Tract. VIII), on system 26", key: "" },
    ],
    pairing: [
      { value: "gregobaseId", label: "Its chant (GregoBase id)", hint: "the number in gregobase.selapa.net/chant.php?id=…; leave the chant's page open to copy it", key: "chant" },
    ],
    vespers: [
      { value: "tone", label: "Tone", hint: "as the book prints it, e.g. VIII.G or IV.A*", key: "tone" },
      { value: "gregobaseId", label: "Its chant (GregoBase id)", hint: "the number in gregobase.selapa.net/chant.php?id=…, or none", key: "chant" },
    ],
  };

  let targetIndex: Promise<Targets | null> | null = null;
  function loadTargets(): Promise<Targets | null> {
    return targetIndex ??= fetch("/corrections/targets.json")
      .then(async (response) => response.ok ? (await response.json()) as Targets : null)
      .catch(() => null);
  }

  async function fixTarget(target: string): Promise<void> {
    const kind = target.split(":", 1)[0] ?? "";
    const fields = KIND_FIELDS[kind];
    const targets = await loadTargets();
    const info = targets && fields ? describeTarget(targets, target) : null;
    if (!info || !fields || !fieldSelect) {
      say("We couldn't find that item; choose it below.", "error");
      return;
    }
    fixed = { target: info.target, pieceId: info.slug ?? "vespers", values: info.values };
    document.getElementById("target-label")!.textContent = info.label;
    document.getElementById("target-fixed")!.hidden = false;
    document.getElementById("piece-row")!.hidden = true;
    fieldSelect.replaceChildren(...fields.map((f) => {
      const option = document.createElement("option");
      option.value = f.value;
      option.textContent = f.label;
      option.dataset["hint"] = f.hint;
      option.dataset["key"] = f.key;
      return option;
    }));
    syncFixed();
  }

  function syncFixed(): void {
    if (!fixed || !fieldSelect) return;
    const option = fieldSelect.selectedOptions[0];
    if (hint) hint.textContent = option?.dataset["hint"] ?? "";
    const current = fixed.values[option?.dataset["key"] ?? ""] ?? "";
    if (now) now.textContent = option?.dataset["key"] ? `Now: ${current || "(none)"}` : "";
  }
  fieldSelect?.addEventListener("change", () => { if (fixed) syncFixed(); });
  if (askedTarget && !askedTarget.startsWith("piece:")) void fixTarget(askedTarget);

  async function loadQueue(): Promise<void> {
    if (!queue || CORRECTIONS_ENDPOINT.length === 0) {
      if (queue) queue.textContent = "The corrections queue is not available in this build.";
      return;
    }
    try {
      const response = await fetch(CORRECTIONS_ENDPOINT, { headers: { accept: "application/json" } });
      if (!response.ok) throw new Error(String(response.status));
      const body = (await response.json()) as { corrections?: PublicRow[] };
      const rows = body.corrections ?? [];
      if (rows.length === 0) {
        queue.textContent = "No corrections have been submitted yet.";
        return;
      }

      // Built with createElement and textContent throughout. These values were
      // validated by the Worker on the way out, but the page must not depend on
      // that being true: never innerHTML for data that came from a stranger.
      const table = document.createElement("table");
      const head = document.createElement("tr");
      for (const label of ["Piece or item", "Field", "Proposed", "Status"]) {
        const th = document.createElement("th");
        th.textContent = label;
        head.append(th);
      }
      table.append(head);

      const targetCells: { cell: HTMLTableCellElement; target: string }[] = [];
      for (const row of rows) {
        const tr = document.createElement("tr");
        const cell = document.createElement("td");
        cell.textContent = row.target ?? row.pieceId;
        tr.append(cell);
        targetCells.push({ cell, target: row.target ?? `piece:${row.pieceId}` });
        for (const value of [row.field, row.proposedValue]) {
          const td = document.createElement("td");
          td.textContent = value;
          tr.append(td);
        }
        const td = document.createElement("td");
        td.textContent = row.status;
        td.className = `status ${row.status === "accepted" ? "accepted" : ""}`;
        tr.append(td);
        table.append(tr);
      }

      const scroll = document.createElement("div");
      scroll.className = "queue-scroll";
      scroll.append(table);
      queue.replaceChildren(scroll);
      // Labels enrich an already visible queue. A slow or failed catalogue
      // request must not hide the reports themselves.
      void loadTargets().then((targets) => {
        if (!targets) return;
        for (const { cell, target } of targetCells) {
          const label = describeTarget(targets, target)?.label;
          if (label) cell.textContent = label;
        }
      });
    } catch {
      queue.textContent = "The corrections queue could not be loaded just now.";
    }
  }
  void loadQueue();

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submit) return;

    const data = new FormData(form);
    const pieceId = fixed ? fixed.pieceId : String(data.get("pieceId") ?? "");
    if (!pieceId) {
      say("Choose which piece the correction applies to.", "error");
      return;
    }
    if (fieldSelect?.value === "mode" && pieceSelect?.selectedOptions[0]?.dataset["genre"] === "proper") {
      say("A Proper has no single mode: each of its parts has its own. Choose another field.", "error");
      return;
    }
    const proposedValue = String(data.get("proposedValue") ?? "").trim();
    if (!proposedValue) {
      say("Say what the value should be.", "error");
      return;
    }

    const token = String(data.get("cf-turnstile-response") ?? "");
    if (!token) {
      say("Please complete the anti-spam check just above the button.", "error");
      return;
    }

    submit.disabled = true;
    say("Sending…");

    try {
      const response = await fetch(CORRECTIONS_ENDPOINT, {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          pieceId,
          ...(fixed ? { target: fixed.target } : {}),
          field: String(data.get("field") ?? ""),
          proposedValue,
          note: String(data.get("note") ?? ""),
          turnstileToken: token,
        }),
      });

      const body = (await response.json().catch(() => ({}))) as
        { error?: string; duplicate?: boolean };

      if (response.status === 503) {
        say("Corrections are paused at the moment. Please try again later.", "error");
      } else if (response.status === 429) {
        say(body.error ?? "Too many corrections from this connection just now.", "error");
      } else if (!response.ok) {
        say(body.error ?? `Could not send the correction (${response.status}).`, "error");
      } else if (body.duplicate) {
        say("That correction is already in the queue — thank you.", "ok");
        form.reset();
      } else {
        say("Thank you. Your correction is in the queue for review.", "ok");
        form.reset();
        syncHint();
        void loadQueue();
      }
    } catch {
      say("Could not reach the corrections service. Nothing was sent.", "error");
    } finally {
      submit.disabled = false;
      const turnstile = (window as { turnstile?: { reset: () => void } }).turnstile;
      turnstile?.reset();
    }
  });
</script>
