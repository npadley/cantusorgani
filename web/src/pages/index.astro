---
import Layout from "../components/Layout.astro";
import { allPieces, hymnIndex } from "../lib/catalog";
import { DIVISIONS, divisionsWithContent } from "../lib/indexes";

const present = divisionsWithContent(allPieces());
const presentSet = new Set(present.map((d) => d.division));
// Named honestly, not linked: books whose volumes have not been catalogued yet.
const pending = DIVISIONS.filter((d) => !presentSet.has(d.division));
const withMusic = allPieces().filter((p) => p.systems.length > 0).length;
---

<Layout
  title="Cantus Organi"
  description="Organ accompaniment to Gregorian chant from the Nova Organi Harmonia (Mechelen, 1942), free and in the public domain."
>
  <div class="prose">
    <h1>Cantus Organi</h1>
    <p>
      Organ accompaniment to Gregorian chant from the
      <em>Nova Organi Harmonia ad Graduale Romanum</em> (Mechelen, 1942) —
      readable in the browser, and exportable as a PDF for the organ bench.
    </p>
  </div>

  <a class="calendar-card ui" href="/calendar/">
    <span class="card-title">What is sung today?</span>
    <span class="muted small">Find the Mass for any date under the 1962 rubrics, with its music.</span>
  </a>

  <h2>The books</h2>
  <ul class="divisions ui">
    <li>
      <a href="/hymns/">
        <span class="card-title">Hymns</span>
        <span class="la muted">Hymni</span>
        <span class="muted small">Hymns across the books, including alternate settings and tones.</span>
        <span class="count small">{hymnIndex().length} settings</span>
      </a>
    </li>
    {present.map((d) => (
      <li>
        <a href={`/${d.slug}/`}>
          <span class="card-title">{d.en}</span>
          <span class="la muted">{d.la}</span>
          <span class="muted small">{d.blurb}</span>
          <span class="count small">{d.count} {d.count === 1 ? "piece" : "pieces"}</span>
        </a>
      </li>
    ))}
  </ul>

  {pending.length > 0 && (
    <p class="pending small muted">
      Still to be catalogued: {pending.map((d) => d.en).join(", ")}. Each appears
      here as soon as its volume is processed. {withMusic} pieces are available now.
    </p>
  )}
</Layout>

<style>
  h2 { margin-top: var(--s-5); padding-bottom: var(--s-2); border-bottom: 1px solid var(--rule); }
  .calendar-card, .divisions a {
    display: flex; flex-direction: column; gap: var(--s-1);
    padding: var(--s-3); border: 1px solid var(--rule); border-radius: var(--radius);
    color: var(--ink); text-decoration: none;
  }
  .calendar-card { margin: var(--s-4) 0; border-left: 3px solid var(--accent); }
  .calendar-card:hover, .divisions a:hover { background: color-mix(in srgb, var(--rule) 20%, transparent); }
  .card-title { font-family: var(--font-text); font-size: var(--step-1); }
  .la { font-style: italic; }
  .count { color: var(--accent); }
  .divisions {
    list-style: none; margin: var(--s-3) 0 0; padding: 0;
    display: grid; gap: var(--s-3); grid-template-columns: repeat(auto-fill, minmax(16rem, 1fr));
  }
  .pending { margin-top: var(--s-4); }
</style>
