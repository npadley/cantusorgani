---
import Crumbs from "../../../components/Crumbs.astro";
import MovementNav from "../../../components/MovementNav.astro";
import { hasNotation } from "../../../lib/chants";
import ServiceRail from "../../../components/ServiceRail.astro";
import SystemStack from "../../../components/SystemStack.astro";
import SourceBlock from "../../../components/SourceBlock.astro";
import TypesetSwitch from "../../../components/TypesetSwitch.astro";
import { hasTypeset } from "../../../lib/typeset";
import { musicView } from "../../../lib/music";
import { buildDayTable, pdfTitle, resolveDate } from "../../../lib/dayService";
import { exportSegments, seasonGroup, unavailableMusic } from "../../../lib/exportParts";
import Layout from "../../../components/Layout.astro";
import PartLinks from "../../../components/PartLinks.astro";
import PieceList from "../../../components/PieceList.astro";
import { allPieces, jumpTargets, ordinaryMasses } from "../../../lib/catalog";
import { catalogedDays, pieceHref } from "../../../lib/indexes";
import {
  COLOR_LABELS, classLabel, findNextDate, isoOf, kyrialeFor, loadYear, observance, seasonForDate, today,
} from "../../../lib/liturgy";
import { consoleLine, hymnSettingsForDay, isSunday, lineupFor, lineupHref, loadLineup, nextFirstVespers, nextLineupDate } from "../../../lib/vespers";

// A page for each calendar day that has catalogued music. The date lookup and
// the Proper indexes link here.
export function getStaticPaths() {
  return catalogedDays(allPieces()).map((key) => {
    const [flex, name] = key.split(":");
    return { params: { flex: flex || "feria", name: name ?? "" }, props: { key } };
  });
}

interface Props { readonly key: string }
const { key } = Astro.props;
const o = observance(key);
const forDay = allPieces().filter((p) => p.days.includes(key));
// The Mass and the Office are listed apart; the export is the Mass.
// A piece that only lends parts to the day's own Proper (St Michael's Introit
// on the Guardian Angels) is reached through those parts, not listed whole.
const lenders = new Set(forDay.filter((p) => !p.linkedDays.includes(key)).flatMap((p) =>
  p.parts.flatMap((x) => (x.kind === "borrowed" && x.borrowedFrom ? [x.borrowedFrom] : []))));
const pieces = forDay.filter((p) => p.division !== "vesperale"
  && !(p.linkedDays.includes(key) && lenders.has(p.slug)));
const vespers = forDay.filter((p) => p.division === "vesperale");
const officeHymns = hymnSettingsForDay(key);
const title = o?.titleEn ?? key;

// The Ordinary depends on the season and the weekday, so it is suggested for a
// real date: the next one this day falls on after the build.
const date = o ? await findNextDate(key, today()) : null;
const buildYear = today().year;
const years = Object.fromEntries(await Promise.all(Array.from({ length: 4 }, async (_, i) => {
  const year = buildYear + i;
  return [year, await loadYear(year) ?? {}] as const;
})));
const table = o ? buildDayTable(o, buildYear, years, d => ({ suggestion: kyrialeFor(o, d), group: seasonGroup(seasonForDate(d)) })) : { start: `${buildYear}-01-01`, end: `${buildYear + 3}-12-31`, options: [], groups: [] };
const service = resolveDate(null, table, date ? isoOf(date) : null);
const candidates = table.options.map(option => ({ option,
  piece: ordinaryMasses().find(m => m.label === option.mass) ?? null,
}));
const properSegments = exportSegments(pieces);
const segments = [...properSegments, ...candidates.flatMap(({ option, piece }) =>
  piece ? exportSegments([piece]).map(s => ({ ...s, id: `${option.key}:${s.id}`, ordinaryOption: option.key })) : [])];
const exportPieces = [...pieces, ...candidates.flatMap(c => c.piece ? [c.piece] : [])];
const musicPieces = pieces.map(p => musicView(p));
const unavailable = unavailableMusic(pieces);
const hasMusic = segments.length > 0;
const chantPiece = [...musicPieces, ...exportPieces].find(p => jumpTargets(p).some(t => hasNotation(t.chantId)));
// The full order of Vespers, where the lineup has this day (release 1: the
// green Sundays whose Magnificat tone NOH8 prints).
const vespersDate = date ? nextLineupDate(key, isoOf(date)) : null;
const vespersDay = vespersDate ? lineupFor(vespersDate) : undefined;
const vespersLong = vespersDate
  ? new Date(`${vespersDate}T00:00:00Z`).toLocaleDateString("en-GB", {
      weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC" })
  : null;
const magnificatAntiphon = vespersDay?.items.find((i) => i.kind === "magnificat-antiphon");
const firstDate = date ? nextFirstVespers(key, isoOf(date)) : null;
const firstDay = firstDate ? loadLineup().firstVespers.get(firstDate) : undefined;
const longDate = date
  ? new Date(Date.UTC(date.year, date.month - 1, date.day)).toLocaleDateString("en-GB", {
      weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
    })
  : null;
---

<Layout title={title} description={`${title} — organ accompaniment from Nova Organi Harmonia.`} skipTo={hasMusic ? "music" : undefined}>
  <div class="reader-layout">
  {hasMusic && <ServiceRail pieces={exportPieces} {...(forDay[0] ? { occasion: forDay[0] } : {})} title={pdfTitle(title, service.option?.mass ?? null, service.iso)}
    segments={segments} season={date ? seasonForDate(date) : null} dateLabel={longDate}
    dayService={{ table, buildDefaultIso: service.iso, title, unavailable }}>
    <div slot="reader-tools">
      {chantPiece && <MovementNav piece={chantPiece} variant="tools" />}
      <TypesetSwitch show={exportPieces.some(p => hasTypeset(p))} />
    </div>
  </ServiceRail>}
  <article class="reading-column">
  <div class="prose">
    <Crumbs><a href="/">Cantus Organi</a> · <a href="/calendar/">Calendar</a></Crumbs>
    <h1>{title}</h1>
    {o && <p class="lede" lang="la">{o.titleLa}</p>}
    {o && (
      <p class="meta ui small muted">
        {classLabel(o.rank)} · {o.colors.map((c) => COLOR_LABELS[c] ?? c).join(" / ")}
        {date && longDate && <> · next on <a href={`/calendar/?date=${isoOf(date)}`}>{longDate}</a></>}
      </p>
    )}
    {hasMusic && <p class="ui small day-message" data-day-message hidden></p>}
  </div>

  {pieces.length > 0 && (
    <>
      <h2 class="ui">Proper</h2>
      <PieceList pieces={pieces} />
      <PartLinks pieces={pieces} inPage={(p) => { const i = pieces.indexOf(p); return musicPieces[i]?.systems.length ? `proper-${i}-` : null; }} />
    </>
  )}

  <div id="music" tabindex="-1">
      {musicPieces.map((piece, index) => <>
        {musicPieces.length > 1 && <h2 class="piece-name" lang="la">{piece.incipit ?? piece.title}</h2>}
        <SystemStack piece={piece} exportParts={properSegments} id={`proper-${index}`} anchorPrefix={`proper-${index}-`} />
      </>)}

  {candidates.length > 0 && <h2 class="ui">Ordinary</h2>}
  {candidates.map(({ option, piece }) => (
    <section class="ordinary" data-ordinary-option={option.key} hidden={option.key !== service.option?.key}>
      {piece ? <p lang="la"><a href={pieceHref(piece)}>Missa {piece.label}{piece.incipit ? ` — ${piece.incipit}` : ""}</a></p>
        : <p>{option.candidates.length ? `Missa ${option.candidates.join(" or ")}` : "No single Mass is assigned"}</p>}
      <p class="small muted">Kyriale heading: <span lang="la">“{option.heading}”</span>{longDate && <> (for <span data-service-date>{longDate}</span>)</>}.
        {option.note && ` ${option.note}`}</p>
      {piece && <>
        <SystemStack piece={piece} exportParts={segments.filter(s => s.ordinaryOption === option.key)}
          id={`music-${option.key}`} anchorPrefix={`${option.key}-`} hiddenCandidate={option.key !== service.option?.key} />
      </>}
    </section>
  ))}
  </div>
  {hasMusic && (candidates.length === 0 ? <SourceBlock pieces={pieces} /> : candidates.map(({ option, piece }) => (
    <div data-ordinary-option={option.key} hidden={option.key !== service.option?.key}>
      <SourceBlock pieces={piece ? [...pieces, piece] : pieces} idPrefix={`${option.key}-`} />
    </div>
  )))}

  {vespersDay ? (
    <section class="vespers">
      <h2 class="ui">Vespers</h2>
      <p class="ui small">{consoleLine(vespersDay)}{magnificatAntiphon && <> · Magnificat antiphon <em>{magnificatAntiphon.label}</em></>}</p>
      <p><a href={lineupHref(vespersDay)}>{vespersDay.vespers === "I" ? "I Vespers" : "Full Vespers"}, in the order sung</a>{vespersLong && <span class="small muted"> ({vespersLong})</span>}</p>
      {firstDay && <p><a href={lineupHref(firstDay)}>I Vespers, the evening before</a></p>}
    </section>
  ) : vespers.length > 0 && (
    <section class="vespers">
      <h2 class="ui">Vespers</h2>
      <PieceList pieces={vespers} />
      {isSunday(key) && <p class="small muted">NOH VIII does not print the full order of Vespers for this day.</p>}
    </section>
  )}

  {officeHymns.length > 0 && (
    <section class="office-hymns no-print">
      <h2 class="ui">Hymns for the Office</h2>
      <p class="small muted">Additional printed settings in Book VII. The Vespers page above keeps its own accompaniment.</p>
      <PieceList pieces={officeHymns} />
      <p class="small"><a href="/hymns/">All hymns across the books</a></p>
    </section>
  )}

  </article>
  </div>
</Layout>

<style>
  [hidden] { display: none !important; }
  @media print { .reader-layout { display: block; } }
  .reading-column { min-width: 0; }
  @media screen and (width < 62rem) {
    .reader-layout { display: flex; flex-direction: column; }
    .reader-layout > :global(.service-rail) { order: 1; }
  }
  @media screen and (min-width: 62rem) {
    .reader-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: var(--s-4); align-items: start; }
    .reading-column { grid-column: 2; grid-row: 1; }
    .reader-layout > :global(.service-rail) { grid-column: 1; grid-row: 1; }
  }
  .lede { font-style: italic; font-size: var(--step-1); margin: 0 0 var(--s-1); }
  .meta { margin: 0 0 var(--s-4); }
  h2 { margin: var(--s-4) 0 var(--s-2); font-size: var(--step-0); color: var(--ink-muted);
       text-transform: uppercase; letter-spacing: 0.06em; }
  .piece-name { margin: var(--s-4) 0 var(--s-2); font-family: var(--font-text); font-size: var(--step-1);
                color: var(--ink); text-transform: none; letter-spacing: normal; }
  .day-message { margin: calc(-1 * var(--s-3)) 0 var(--s-4); }
  .ordinary p { margin: 0 0 var(--s-1); }
</style>
