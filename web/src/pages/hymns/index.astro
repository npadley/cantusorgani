---
import Crumbs from "../../components/Crumbs.astro";
import Layout from "../../components/Layout.astro";
import { hymnIndex, loadCatalog } from "../../lib/catalog";
import { pieceHref } from "../../lib/indexes";
import { hymnPairing } from "../../lib/hymnpairings";

const hymns = hymnIndex();
const volumes = loadCatalog().volumes;
---

<Layout title="Hymns" description="Hymns across the books of Nova Organi Harmonia, with their organ accompaniments.">
  <div class="prose">
    <Crumbs><a href="/">Cantus Organi</a></Crumbs>
    <h1>Hymns <span class="la muted" lang="la">Hymni</span></h1>
    <p>Hymns across the books, in alphabetical order. Each link opens the accompaniment where it is printed.
      Different settings and tones are listed separately.</p>
    <p class="small muted">GregoBase matches were checked against the opening melody and words.
      Follow each book’s printed verses; pairings that need review are labelled.</p>
    <p class="small muted">{hymns.length} printed settings. See <a href="/varia/">Varia</a> for Book VII’s sequences,
      antiphons, litanies, psalms, and other music.</p>
  </div>
  <div class="hymn-filter ui" hidden data-hymn-filter data-pagefind-ignore>
    <label for="hymn-filter">Filter hymns</label>
    <input id="hymn-filter" type="search" autocomplete="off" />
    <p data-hymn-count role="status" aria-live="polite"></p>
    <div data-hymn-empty hidden>
      <button type="button" data-hymn-clear>Clear</button>
    </div>
  </div>
  <ul class="hymns ui">
    {hymns.map((h) => { const chant = hymnPairing(h.ref); return (
      <li data-filter={`${h.title}${h.piece.genre !== "hymn" ? ` ${h.piece.title}` : ""}`}>
        <a href={`${pieceHref(h.piece)}${h.anchor ? `#${h.anchor}` : ""}`}>{h.title}</a>
        <span class="muted small">NOH {volumes[h.piece.volume]?.part} · p. {h.printedPage}
          {h.piece.genre !== "hymn" && <> · {h.piece.title}</>}</span>
        {chant?.id && <a class="small" href={`https://gregobase.selapa.net/chant.php?id=${chant.id}`} target="_blank" rel="noopener">
          GregoBase{chant.status === "unverified" ? " · pairing needs review" : ""}
          <span class="sr-only"> for {h.title} (opens in new tab)</span>
        </a>}
        {chant?.status === "unresolved" && <span class="small muted">No matching GregoBase chant found</span>}
      </li>
    ); })}
  </ul>
</Layout>

<style>
  .la { font-weight: 400; font-size: var(--step-1); font-style: italic; }
  .hymns { list-style: none; margin: var(--s-4) 0 0; padding: 0; columns: 2 18rem; }
  .hymns li { break-inside: avoid; display: flex; flex-direction: column; padding: var(--s-2) 0;
    border-bottom: 1px solid var(--rule); }
  .hymns li[hidden] { display: none; }
  .hymn-filter { margin-top: var(--s-4); }
  label { display: block; margin-bottom: var(--s-1); font-size: var(--step--1); color: var(--ink-muted); }
  input {
    width: 100%; font: inherit; font-family: var(--font-ui);
    min-height: var(--tap-min); padding: var(--s-2) var(--s-3);
    background: var(--paper); color: var(--ink);
    border: 1px solid var(--control-border); border-radius: var(--radius);
  }
  .hymns a { display: flex; align-items: center; min-height: var(--tap-min); }
  @media print { .hymn-filter { display: none; } }
</style>

<script>
  import { initHymnFilter } from "../../scripts/hymnFilter";
  initHymnFilter(document.body);
</script>
