---
import Layout from "../../components/Layout.astro";
import { hymnIndex, loadCatalog } from "../../lib/catalog";
import { pieceHref } from "../../lib/indexes";

const hymns = hymnIndex();
const volumes = loadCatalog().volumes;
---

<Layout title="Hymns" description="Hymns across the books of Nova Organi Harmonia, with their organ accompaniments.">
  <div class="prose">
    <p class="crumb small muted ui"><a href="/">Cantus Organi</a></p>
    <h1>Hymns <span class="la muted">Hymni</span></h1>
    <p>Hymns across the books, in alphabetical order. Each link opens the accompaniment where it is printed.
      Different settings and tones are listed separately.</p>
    <p class="small muted">{hymns.length} printed settings. See <a href="/varia/">Varia</a> for Book VII’s sequences,
      antiphons, litanies, psalms, and other music.</p>
  </div>
  <ul class="hymns ui">
    {hymns.map((h) => (
      <li>
        <a href={`${pieceHref(h.piece)}${h.anchor ? `#${h.anchor}` : ""}`}>{h.title}</a>
        <span class="muted small">NOH {volumes[h.piece.volume]?.part} · p. {h.printedPage}
          {h.piece.genre !== "hymn" && <> · {h.piece.title}</>}</span>
      </li>
    ))}
  </ul>
</Layout>

<style>
  .crumb { margin: 0 0 var(--s-1); }
  .crumb a { color: var(--ink-muted); }
  .la { font-weight: 400; font-size: var(--step-1); font-style: italic; }
  .hymns { list-style: none; margin: var(--s-4) 0 0; padding: 0; columns: 2 18rem; }
  .hymns li { break-inside: avoid; display: flex; flex-direction: column; padding: var(--s-2) 0;
    border-bottom: 1px solid var(--rule); }
  .hymns a { display: flex; align-items: center; min-height: var(--tap-min); }
</style>
