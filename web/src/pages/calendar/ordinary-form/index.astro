---
import Crumbs from "../../../components/Crumbs.astro";
import Layout from "../../../components/Layout.astro";
import { allOrdinaryFormParts, ordinaryFormOccasions, ordinaryFormHref } from "../../../lib/ordinaryFormPieces";
import { partAnchor } from "../../../lib/catalog";
import { pieceHref } from "../../../lib/indexes";

const choices = ["A", "B", "C"] as const;
const occasions = Object.fromEntries(ordinaryFormOccasions().map(row => [row.key, {
  key: row.key, titleEn: row.title_en, titleLa: row.title_la, color: row.color, rank: row.rank,
  assignmentStatus: row.assignment_status, rubric: row.rubric_en ?? null,
  partsByCycle: Object.fromEntries(choices.map(cycle => [cycle, allOrdinaryFormParts(row.key, cycle).map(part => ({
    slot: part.slot, sourceSlot: part.sourceSlot, kind: part.kind, variant: part.variant, years: part.years, seasons: part.seasons,
    gregobaseId: part.gregobaseId, incipit: part.incipit, label: part.label,
    href: part.lender ? `${pieceHref(part.lender.piece)}#${partAnchor(part.lender.section.part, part.lender.section.variant)}` : null,
  }))])),
}]));
const [first, last] = [2024, 2050];
const additionalKeys = new Set(["christmas-vigil", "christmas-night", "christmas-dawn", "christmas-day", "easter-vigil", "pentecost-vigil"]);
const calendarPages = ordinaryFormOccasions().filter(row => !additionalKeys.has(row.key) && row.rank !== "weekday");
const weekdayPages = ordinaryFormOccasions().filter(row => row.rank === "weekday");
const additionalPages = ordinaryFormOccasions().filter(row => additionalKeys.has(row.key));
---

<Layout title="Ordinary Form Calendar" description="Find the Ordinary Form celebration, cycles and Graduale Romanum (1974) chants for a date, with available Nova Organi Harmonia accompaniments.">
  <div class="prose">
    <Crumbs><a href="/">Cantus Organi</a></Crumbs>
    <h1>Calendar: Ordinary Form</h1>
    <p class="muted">Choose a date to see the celebration, Sunday and weekday cycles, and the chants assigned in the 1974 <em>Graduale Romanum</em>.</p>
  </div>

  <div id="of-calendar" class="ui" data-calendar-root>
    <form id="picker" class="picker no-print" novalidate>
      <label for="date" class="sr-only">Date</label>
      <input id="date" name="date" type="date" min={`${first}-01-01`} max={`${last}-12-31`} aria-describedby="date-feedback" />
      <div class="buttons">
        <button type="button" data-step="-1" aria-label="Previous day">‹ Day</button>
        <button type="button" data-go="today">Today</button>
        <button type="button" data-go="sunday">Next Sunday</button>
        <button type="button" data-step="1" aria-label="Next day">Day ›</button>
      </div>
    </form>
    <p id="date-feedback" class="feedback"></p>

    <p id="calendar-status" class="sr-only" role="status"></p>
    <article id="result">
      <noscript><p class="notice">The calendar needs JavaScript to look up a date.</p></noscript>
    </article>
  </div>

  <details class="occasion-directory ui">
    <summary>Browse Ordinary Form chant sets</summary>
    <p>Every link leads to a static occasion page that is available without selecting a date or enabling JavaScript.</p>
    <h2>Calendar Sundays, feasts, and solemnities</h2>
    <ul>{calendarPages.map(row => <li><a href={ordinaryFormHref(row.key)}>{row.title_en}</a></li>)}</ul>
    <h2>Seasonal weekdays</h2>
    <p>Weekday Masses of Advent, Christmas, Lent and Easter printed in the 1974 <em>Graduale Romanum</em>. On other seasonal weekdays the Sunday's chants are repeated.</p>
    <ul>{weekdayPages.map(row => <li><a href={ordinaryFormHref(row.key)}>{row.title_en}</a></li>)}</ul>
    <h2>Vigils and Christmas Mass choices</h2>
    <p>These are additional evening and Mass options, not separate calendar days.</p>
    <ul>{additionalPages.map(row => <li><a href={ordinaryFormHref(row.key)}>{row.title_en}</a></li>)}</ul>
  </details>

  <p class="source small muted">
    Calendar follows the General Roman Calendar. The only supported national variations are the transfers of Epiphany, Ascension and Corpus Christi.
    Assignments are based on <a href="https://github.com/bbloomf/jgabc">jgabc</a> and reviewed overrides for the 1974 <em>Graduale Romanum</em>;
    they do not imply that every chant has a NOH accompaniment. NOH source pages remain the authority for the accompaniment and corrections.
    The Ordinary Form calendar is not a complete national or diocesan calendar.
  </p>

  <script type="application/json" id="of-occasion-index" set:html={JSON.stringify(occasions).replace(/</g, "\\u003c")} />
  <script>
    import { mountOrdinaryFormCalendar } from "../../../lib/ordinaryFormCalendarClient";
    const root = document.querySelector<HTMLElement>("[data-calendar-root]");
    if (root) mountOrdinaryFormCalendar(root);
  </script>
</Layout>

<style>
  .picker { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; margin: var(--s-4) 0 var(--s-1); }
  .picker input { font: inherit; min-height: var(--tap-min); padding: var(--s-1) var(--s-2); background: var(--paper); color: var(--ink); border: 1px solid var(--control-border); border-radius: var(--radius); }
  .buttons { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .buttons button { min-height: var(--tap-min); }
  .feedback { min-height: 1.5em; margin: 0; color: var(--warn-ink); }
  .source { margin-top: var(--s-6); border-top: 1px solid var(--rule); padding-top: var(--s-3); }
  .occasion-directory { margin: var(--s-5) 0; border-top: 1px solid var(--rule); padding-top: var(--s-3); }
  .occasion-directory summary { min-height: var(--tap-min); display: flex; align-items: center; cursor: pointer; font-weight: 600; }
  .occasion-directory h2 { font-size: var(--step-1); margin: var(--s-3) 0 var(--s-1); }
  .occasion-directory ul { columns: 2; column-gap: var(--s-5); margin-top: var(--s-1); }
  .occasion-directory li { break-inside: avoid; margin-bottom: var(--s-1); }
  @media (max-width: 40rem) { .occasion-directory ul { columns: 1; } }
</style>

<style is:global>
  #result .date-heading { margin: var(--s-4) 0 var(--s-1); }
  #result .season { margin: 0 0 var(--s-4); color: var(--ink-muted); font-family: var(--font-ui); }
  #result .observance { padding: var(--s-3) 0; border-top: 1px solid var(--rule); }
  #result .observance h2 { margin: 0; }
  #result .latin { font-style: italic; margin: var(--s-1) 0; }
  #result .meta { font-family: var(--font-ui); font-size: var(--step--1); color: var(--ink-muted); display: flex; align-items: center; gap: var(--s-2); flex-wrap: wrap; }
  #result .music { margin: var(--s-3) 0 0; }
  #result .music dt { font-family: var(--font-ui); font-size: var(--step--1); color: var(--ink-muted); }
  #result .music dd { margin: 0 0 var(--s-2); }
  #result .note, #result .alternatives { font-size: var(--step--1); color: var(--ink-muted); margin: var(--s-1) 0 0; }
  #result .accompaniments { display: inline-block; margin-top: var(--s-2); padding: var(--s-2) var(--s-3); border: 1px solid var(--accent); border-radius: var(--radius); font-family: var(--font-ui); font-weight: 600; }
  #result .occasion-options { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-2); }
</style>
