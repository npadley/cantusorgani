---
import Layout from "../../../components/Layout.astro";
import { allPieces, pieceBySlug } from "../../../lib/catalog";
import { pieceHref } from "../../../lib/indexes";
import { REVIEWED } from "../../../lib/admin/reviews";
import { suspectParts } from "../../../lib/admin/suspects";

// Proper parts whose start looks wrong, built with the site: each links to the
// edit page, which shows the scan. Behind Cloudflare Access with /admin/.
const pieces = suspectParts(allPieces(), REVIEWED);
const count = pieces.reduce((n, p) => n + p.parts.length, 0);
const edit = (target: string) => `/admin/edit/?target=${encodeURIComponent(target)}`;
---

<Layout title="Admin: parts to check" noindex>
  <div class="admin ui">
    <p class="small muted"><a href="/admin/">Corrections</a></p>
    <h1>Parts to check</h1>
    <p class="muted small prose">
      {count} Proper part{count === 1 ? "" : "s"} in {pieces.length} piece{pieces.length === 1 ? "" : "s"} whose start
      may be wrong: guessed from the order of the parts, or much shorter than that kind of part usually is. A part runs
      from the system it starts on until the next part starts, so a short part often means the next one starts too
      early. Open a part to see its scan and correct it, or <strong>Sections</strong> to add, remove or relabel the
      piece's sections; a part you correct, or mark <strong>Looks right</strong>,
      leaves this list once it is published. These are also on the <a href="/admin/review/">Review</a> page.
    </p>
    <div id="status" class="status small" role="status" aria-live="polite"></div>
    {pieces.length === 0 ? <p>Nothing to check.</p> : (
      <ol class="suspects" id="suspects">
        {pieces.map((piece) => {
          const found = pieceBySlug(piece.slug);
          return (
            <li>
              <h2>{found ? <a href={pieceHref(found)}>{piece.label}</a> : piece.label} <span class="muted small">({piece.volume})</span>
                <a class="small" href={`/admin/sections/?piece=${encodeURIComponent(piece.slug)}`}>Sections</a></h2>
              <ul>
                {piece.parts.map((p) => (
                  <li data-review-target={p.target} data-review-seen={p.fingerprint}>
                    <h3 tabindex="-1" class="part-name"><a href={edit(p.target)}>{p.name}</a></h3>
                    <span class="muted small"> · starts on system {p.start}, runs for {p.length}</span>
                    <p class="small">{p.reasons.map((r) => `${r[0]?.toUpperCase()}${r.slice(1)}.`).join(" ")}</p>
                    <div class="review-actions"><button type="button" data-act="looks-right">Looks right</button>
                      <button type="button" data-act="skip">Skip…</button></div>
                    <p class="review-state small" aria-live="polite"></p>
                  </li>
                ))}
              </ul>
            </li>
          );
        })}
      </ol>
    )}
  </div>
</Layout>

<style>
  .admin { max-width: var(--measure); }
  h1 { margin: 0 0 var(--s-2); }
  .suspects { padding-left: 0; list-style: none; }
  .suspects > li { border-top: 1px solid var(--rule); padding: var(--s-3) 0; }
  .suspects h2 { font-size: var(--step-0); margin: 0 0 var(--s-1); }
  .suspects ul { margin: 0; padding-left: var(--s-4); }
  .suspects ul li { margin: 0 0 var(--s-2); }
  .suspects ul li a { display: inline-flex; align-items: center; min-height: var(--tap-min); }
  .suspects p { margin: 0; }
  .part-name { display: inline; font-size: var(--step-0); margin: 0; font-weight: normal; }
  .review-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-1); }
  .status { min-height: 1.4em; margin: var(--s-2) 0; }
  .status[data-state="error"] { color: var(--warn-ink); }
  :global(.review-state .reason) { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: end; }
  :global(.review-state .reason label) { display: block; width: 100%; }
  :global(.review-state .reason input) { flex: 1 1 16rem; font: inherit; min-height: var(--tap-min);
    padding: var(--s-2) var(--s-3); background: var(--paper); color: var(--ink); border: 1px solid var(--rule);
    border-radius: var(--radius); }
  :global(.review-state button.link) { background: none; border: 0; padding: 0; min-height: var(--tap-min);
    color: var(--accent); text-decoration: underline; cursor: pointer; font: inherit; }
</style>

<script>
  import { wireReviews } from "../../../lib/admin/reviewClient";

  const list = document.getElementById("suspects");
  if (list) void wireReviews(list, document.getElementById("status"));
</script>
