---
import AdminNav from "../../components/AdminNav.astro";
import Layout from "../../components/Layout.astro";
import { MELODY_AUDIT_COUNTS } from "../../lib/admin/melodyAudit";

// The admin home: what is waiting on every list (/admin/api/summary), then the
// corrections queue. Static: everything on it is loaded from /admin/api,
// behind Cloudflare Access. Search engines and the site search skip it.
---

<Layout title="Admin" noindex>
  <div class="admin ui">
    <AdminNav current="home" />
    <p class="who small muted" id="who">Admin</p>
    <h1>Admin</h1>
    <div id="status" class="status small" role="status" aria-live="polite"></div>

    <section aria-labelledby="waiting-h">
      <h2 id="waiting-h">What's waiting</h2>
      <div class="scroll">
        <table class="waiting">
          <tbody>
            <tr class="publish-row">
              <th scope="row">Ready to publish</th>
              <td id="batch-text">Loading…</td>
              <td><button type="button" class="primary" id="publish" disabled>Publish changes</button></td>
            </tr>
            <tr>
              <th scope="row">Readers' reports</th><td data-sum="reports">…</td>
              <td><a href="#pending-h">Answer them below</a></td>
            </tr>
            <tr>
              <th scope="row">Review: can be corrected here</th><td data-sum="fix">…</td>
              <td><a href="/admin/review/?group=fix">Open Review</a></td>
            </tr>
            <tr>
              <th scope="row">Review: check against the scan</th><td data-sum="check">…</td>
              <td><a href="/admin/review/?group=check">Open the checks</a></td>
            </tr>
            <tr>
              <th scope="row">Typeset: which part is it?</th><td data-sum="matches">…</td>
              <td><a href="/admin/typeset/?queue=matches">Choose parts</a></td>
            </tr>
            <tr>
              <th scope="row">Typeset: files LilyPond can't draw</th><td data-sum="errors">…</td>
              <td><a href="/admin/typeset/?queue=errors">Fix the files</a></td>
            </tr>
            <tr>
              <th scope="row">Typeset: proofreading</th><td data-sum="proofreading">…</td>
              <td><a href="/admin/typeset/?queue=proofreading">Proofread</a></td>
            </tr>
            <tr>
              <th scope="row">Typeset: melody audit</th>
              <td>{MELODY_AUDIT_COUNTS.checked}/{MELODY_AUDIT_COUNTS.remaining} checked · {MELODY_AUDIT_COUNTS.agreement} agree ·
                {MELODY_AUDIT_COUNTS.attention} need attention · {MELODY_AUDIT_COUNTS.noReference} without chant reference ·
                {MELODY_AUDIT_COUNTS.unchecked} unchecked</td>
              <td><a href="/admin/typeset/?queue=proofreading">See proofreading</a></td>
            </tr>
          </tbody>
        </table>
      </div>
      <details class="how small">
        <summary>How publishing works</summary>
        <p class="prose">Whatever you approve here, mark on Review or choose on Typeset music waits under{" "}
          <strong>Approved</strong> below. <strong>Publish changes</strong> sends it all to GitHub as one pull request.
          It merges itself once the site's checks pass, unless it moves systems between pieces or holds 25 changes or more:
          then it waits for the owner to merge it. The site changes a few minutes after the merge.{" "}
          <a href="/about/#corrections">How corrections work</a>.</p>
      </details>
    </section>

    <section aria-labelledby="pending-h">
      <h2 id="pending-h">Readers' reports</h2>
      <div id="pending"><p class="muted small">Loading…</p></div>
    </section>

    <section aria-labelledby="approved-h">
      <h2 id="approved-h">Approved, waiting to publish</h2>
      <div id="approved"></div>
    </section>

    <section aria-labelledby="batches-h">
      <h2 id="batches-h">On GitHub</h2>
      <div id="batches"></div>
    </section>

    <section aria-labelledby="history-h">
      <h2 id="history-h">History</h2>
      <button type="button" id="show-history">Show the last 100</button>
      <div id="history"></div>
    </section>
  </div>
</Layout>

<style>
  .admin { max-width: 60rem; }
  .who { margin: 0 0 var(--s-1); }
  h1 { margin: 0 0 var(--s-2); }
  h2 { margin-top: var(--s-5); padding-bottom: var(--s-2); border-bottom: 1px solid var(--rule); font-size: var(--step-1); }
  .status { min-height: 1.4em; margin: var(--s-3) 0; }
  .status[data-state="error"] { color: var(--warn-ink); }
  .waiting { width: 100%; border-collapse: collapse; }
  .waiting th, .waiting td { text-align: left; padding: var(--s-2) var(--s-3) var(--s-2) 0; border-bottom: 1px solid var(--rule);
                             vertical-align: middle; }
  .waiting th { font-weight: 400; }
  .waiting td:nth-child(2) { font-variant-numeric: tabular-nums; }
  .waiting td:last-child { text-align: right; padding-right: 0; white-space: nowrap; }
  .waiting .publish-row th { font-weight: 600; }
  @media (max-width: 40rem) {
    .waiting, .waiting tbody { display: block; }
    .waiting tr { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: var(--s-3);
                  padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); }
    .waiting th { grid-column: 1 / -1; }
    .waiting th, .waiting td { border-bottom: 0; padding: 0; }
  }
  .how { margin-top: var(--s-2); }
  .how summary { cursor: pointer; padding: var(--s-2) 0; }
  :global(.primary) { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  :global(.primary:disabled) { background: var(--paper); color: var(--ink-muted); border-color: var(--rule); }
  :global(.item) { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-2);
                   padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 60rem) {
    :global(.item.has-scan) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s-4); }
    :global(.item.has-scan .scan) { grid-column: 2; grid-row: 1 / span 4; }
  }
  :global(.item h3) { margin: 0; font-size: var(--step-0); }
  :global(.item h3:focus) { outline: 2px solid var(--accent); outline-offset: 2px; }
  :global(.values) { display: grid; grid-template-columns: max-content minmax(0, 1fr); gap: var(--s-1) var(--s-3);
                     align-items: center; margin: 0; }
  :global(.values dt) { color: var(--ink-muted); font-size: var(--step--1); }
  :global(.values dd) { margin: 0; }
  :global(.values input), :global(.values select), :global(.reason input), :global(.admin-form input), :global(.admin-form select),
  :global(.admin-form textarea) {
    width: 100%; font: inherit; font-family: var(--font-ui); min-height: var(--tap-min); padding: var(--s-2) var(--s-3);
    background: var(--paper); color: var(--ink); border: 1px solid var(--rule); border-radius: var(--radius);
  }
  :global(.values input) { font-size: var(--step-1); font-weight: 600; }
  :global(.actions) { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  :global(.reason) { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: end; }
  :global(.reason label) { display: block; width: 100%; font-size: var(--step--1); }
  :global(.scan figure) { margin: 0 0 var(--s-2); }
  :global(.scan img) { display: block; width: 100%; height: auto; }
  :global(.scan figcaption) { margin-top: var(--s-1); }
  :global(.history-table) { width: 100%; border-collapse: collapse; font-size: var(--step--1); margin-top: var(--s-3); }
  :global(.history-table th), :global(.history-table td) { text-align: left; padding: var(--s-2); border-bottom: 1px solid var(--rule); vertical-align: top; }
  :global(.scroll) { overflow-x: auto; }
</style>

<script>
  import { api, drafts, fixLink, h, loadScans, loadTargets, say, scanFigures, signInAgain, whenTypingPauses } from "../../lib/admin/client";
  import type { Fix } from "../../lib/admin/client";
  import type { QueueItem } from "../../lib/admin/api";
  import { namedSystems } from "../../lib/admin/scans";
  import type { Scans } from "../../lib/admin/scans";
  import { FIELD_LABELS, describeTarget, notFor, sectionsSummary, startNote } from "../../lib/admin/targets";
  import type { Targets } from "../../lib/admin/targets";
  import type { Count, Summary } from "../../lib/admin/summary";
  import { onSummary, refreshSummary } from "../../lib/admin/summaryClient";

  interface Queue {
    pending: QueueItem[]; approved: QueueItem[];
    batches: { batch: string; pr: number | null; items: QueueItem[] }[]; lastReviewed: string | null;
  }
  interface Me { email: string; owner: boolean; publishing: boolean }

  const status = document.getElementById("status");
  const REPO = "https://github.com/npadley/cantusorgani";
  let me: Me | null = null;
  let targets: Targets | null = null;
  let scans: Scans | null = null;
  let loadedOnce = false;

  function fail(result: { status: number; error: string; fix?: Fix }): void {
    if (result.status === 401) signInAgain(status);
    else say(status, result.error, "error");
    if (result.fix) status?.append(" ", fixLink(result.fix));
  }

  /** A row's value in words: a list of sections as its summary. */
  function valueText(item: QueueItem): string {
    if (item.field === "source") return "Source edit";
    return item.field === "sections" && item.source === "editor" ? sectionsSummary(item.proposed) : item.proposed;
  }

  /** The Sections screen for a row's piece; a reader's report is named, so saving there settles it. */
  function sectionsLink(item: QueueItem): HTMLElement {
    const slug = (item.resolvedTarget ?? "").slice("sections:".length);
    return h("a", { href: `/admin/sections/?piece=${encodeURIComponent(slug)}&report=${item.id}` }, "Open the Sections screen");
  }

  function label(item: QueueItem): string {
    const field = FIELD_LABELS[item.resolvedField ?? ""] ?? item.field;
    return `${item.label ?? item.resolvedTarget ?? item.target ?? item.piece_id} · ${field}`;
  }

  /** The systems the report names, now and as proposed; without the scan
   * index, the piece's first system. */
  function scan(item: QueueItem, field: string, proposed: string): HTMLElement | null {
    const found = targets && item.resolvedTarget ? describeTarget(targets, item.resolvedTarget) : null;
    if (!found) return null;
    if (scans) return scanFigures(namedSystems(scans, found, field, proposed), found.href);
    return found.stem ? scanFigures([{ ref: "", stem: found.stem, aspect: found.aspect, caption: "First system" }], found.href) : null;
  }

  /** The heading to focus once the list is drawn again: the next report's, or
   * the previous one's, or the section's when none is left. */
  function nextHeadingId(from: HTMLElement): string {
    const items = [...document.querySelectorAll<HTMLElement>("#pending .item h3")];
    const at = items.findIndex((el) => from.contains(el));
    return (items[at + 1] ?? items[at - 1])?.id ?? "pending-h";
  }

  function focusAfterLoad(id: string): void {
    const target = document.getElementById(id) ?? document.getElementById("pending-h");
    if (target && !target.hasAttribute("tabindex")) target.setAttribute("tabindex", "-1");
    target?.focus();
  }

  function pendingItem(item: QueueItem): HTMLElement {
    const heading = h("h3", { tabindex: "-1", id: `item-${item.id}` }, label(item));
    const article = h("article", { class: "item", "aria-labelledby": `item-${item.id}` }, heading);
    let picture: HTMLElement | null = null;
    const draftKey = `row:${item.id}`;
    // A reader's "a part is missing or mislabelled" is fixed on the Sections screen.
    const sections = item.field === "sections";
    const piece = item.kind !== null && !sections && item.field !== "issue";
    const input = h("input", { type: "text", id: `value-${item.id}`, maxlength: "200",
                               value: drafts.get(draftKey) ?? item.proposed }) as HTMLInputElement;
    input.addEventListener("input", () => drafts.set(draftKey, input.value));
    // The reader may have filed it under the wrong field (a mode under Title):
    // the editor can say which field it really corrects before accepting.
    const fieldSelect = h("select", { id: `field-${item.id}` },
      h("option", { value: "" }, "Choose…"),
      ...item.fields.map((f) => h("option", { value: f, selected: f === item.resolvedField }, FIELD_LABELS[f] ?? f))) as HTMLSelectElement;
    const now = h("dd", {}, item.current || "—");
    const fieldNote = h("p", { class: "small muted", id: `field-note-${item.id}` });
    const syncField = () => {
      const f = fieldSelect.value;
      now.textContent = item.values[f] || "—";
      const info = targets && item.resolvedTarget ? describeTarget(targets, item.resolvedTarget) : null;
      fieldNote.textContent = info ? (notFor(f, info.genre, info.kind) ??
        (f === "start_system" ? info.fixed ?? startNote(info) : "")) : "";
      if (f !== (item.resolvedField ?? "")) fieldNote.textContent ||= `The reader filed this under “${item.field}”.`;
    };
    // The pictures follow the field and the value: a start moved to system 7
    // shows system 7 beside the one it starts on now (redrawn as typing pauses).
    const syncScan = () => {
      const next = scan(item, fieldSelect.value || (item.resolvedField ?? ""), piece ? input.value : item.proposed);
      if (picture && next) picture.replaceWith(next);
      else if (picture) picture.remove();
      else if (next) article.append(next);
      picture = next;
      article.classList.toggle("has-scan", Boolean(next));
    };
    fieldSelect.addEventListener("change", () => { syncField(); syncScan(); });
    input.addEventListener("input", whenTypingPauses(syncScan));
    article.append(h("dl", { class: "values" },
      h("dt", {}, h("label", { for: `field-${item.id}` }, "Field")), h("dd", {}, piece ? fieldSelect : item.field),
      h("dt", {}, "Now"), now,
      h("dt", {}, h("label", { for: `value-${item.id}` }, "Proposed")), h("dd", {}, piece ? input : item.proposed)));
    article.append(fieldNote);
    syncField();
    if (item.note) article.append(h("p", { class: "small muted" }, `Reader's note: ${item.note}`));
    if (item.reason) article.append(h("p", { class: "small muted" }, item.reason));
    if (item.field === "issue" && item.target) article.append(h("p", { class: "notice" }, item.problem ?? "", " ",
      h("a", { href: `/admin/typeset/edit/?file=${encodeURIComponent(item.target.slice(8))}&report=${item.id}` }, "Open the source editor")));
    else if (sections && item.resolvedTarget) article.append(h("p", { class: "notice" }, item.problem ?? "", " ", sectionsLink(item)));
    else if (item.problem && (!piece || item.resolvedField)) article.append(h("p", { class: "notice" }, item.problem));
    else if (item.problem) article.append(h("p", { class: "small muted" }, `${item.problem} Or choose the field it was meant to correct.`));
    syncScan();

    const actions = h("div", { class: "actions" });
    const act = async (verb: string, body: Record<string, string>, done: string) => {
      actions.querySelectorAll("button").forEach((b) => { (b as HTMLButtonElement).disabled = true; });
      const result = await api<{ warning?: string; fix?: Fix }>(`/rows/${item.id}/${verb}`, body);
      if (!result.ok) {
        fail(result);
        actions.querySelectorAll("button").forEach((b) => { (b as HTMLButtonElement).disabled = result.status === 409; });
        // Also beside the report itself: on a phone the page's status line is out of sight.
        article.querySelector(".item-error")?.remove();
        if (result.status !== 401) article.append(h("p", { class: "notice item-error" }, result.error));
        return;
      }
      drafts.clear(draftKey);
      // A part moved past a neighbour still to be moved: approved, and said so.
      say(status, `${label(item)}: ${done}.${result.data.warning ? ` ${result.data.warning}` : ""}`,
          result.data.warning ? "error" : "ok");
      if (result.data.fix) status?.append(" ", fixLink(result.data.fix));
      const next = nextHeadingId(article);
      await load();
      focusAfterLoad(next);
    };
    if (piece) {
      const accept = h("button", { type: "button", class: "primary" }, "Accept");
      accept.addEventListener("click", () => void act("approve", { field: fieldSelect.value, value: input.value }, "approved"));
      actions.append(accept);
    }
    const reject = h("button", { type: "button", "aria-expanded": "false" }, "Reject");
    const duplicate = h("button", { type: "button" }, "Duplicate");
    duplicate.addEventListener("click", () => void act("duplicate", {}, "marked as a duplicate"));
    actions.append(reject, duplicate);
    article.append(actions);

    reject.addEventListener("click", () => {
      if (article.querySelector(".reason")) return;
      reject.setAttribute("aria-expanded", "true");
      const why = h("input", { type: "text", id: `reason-${item.id}`, maxlength: "300", required: true }) as HTMLInputElement;
      const confirm = h("button", { type: "button" }, "Reject with this reason");
      const form = h("div", { class: "reason" }, h("label", { for: `reason-${item.id}` }, "Why? (kept in the log)"), why, confirm);
      confirm.addEventListener("click", () => {
        if (!why.value.trim()) { say(status, "Say briefly why it is rejected.", "error"); why.focus(); return; }
        void act("reject", { reason: why.value }, "rejected");
      });
      article.append(form);
      why.focus();
    });
    return article;
  }

  function approvedItem(item: QueueItem): HTMLElement {
    const withdraw = h("button", { type: "button" }, item.source === "editor" ? "Withdraw" : "Back to review");
    withdraw.addEventListener("click", async () => {
      const result = await api(`/rows/${item.id}/unapprove`, {});
      if (!result.ok) { fail(result); return; }
      say(status, `${label(item)}: withdrawn.`, "ok");
      await load();
    });
    return h("article", { class: "item" }, h("h3", {}, label(item)),
      item.field === "reviewed"
        ? h("p", { class: "small" }, h("strong", {}, "Looks right"), ` · marked by ${item.editor_email ?? "?"}`,
            item.note ? `: “${item.note}”` : "")
        : h("p", { class: "small" }, `${item.current || "—"} → `, h("strong", {}, valueText(item)),
            ` · ${item.source === "editor" ? "your fix" : "a reader's report"}, approved by ${item.editor_email ?? "?"}`),
      item.field === "source" && item.target ? h("p",{},h("a",{href:`/admin/typeset/edit/?file=${encodeURIComponent(item.target.slice(8))}`} ,"Inspect approved source")) : null,
      item.reason ? h("p", { class: "notice" }, item.reason) : null,
      h("div", { class: "actions" }, withdraw));
  }

  async function load(): Promise<void> {
    const [queue, loaded, pictures] = await Promise.all([api<Queue>("/queue"), loadTargets(), loadScans()]);
    targets = loaded;
    scans = pictures;
    if (!queue.ok) { fail(queue); document.getElementById("pending")?.replaceChildren(); return; }
    const { pending, approved, batches, lastReviewed } = queue.data;

    const pendingBox = document.getElementById("pending");
    pendingBox?.replaceChildren(...(pending.length
      ? pending.map((i) => pendingItem(i))
      : [h("p", { class: "muted small" }, `No pending corrections.${lastReviewed ? ` Last reviewed ${lastReviewed} UTC.` : ""} `,
           h("a", { href: "#history-h" }, "History"))]));
    document.getElementById("pending-h")!.textContent = `Readers' reports (${pending.length})`;

    document.getElementById("approved")?.replaceChildren(...(approved.length ? approved.map(approvedItem)
      : [h("p", { class: "muted small" }, "Nothing approved yet.")]));

    document.getElementById("batches")?.replaceChildren(...(batches.length ? batches.map((b) => h("p", { class: "small" },
      b.pr ? h("a", { href: `${REPO}/pull/${b.pr}` }, `PR #${b.pr}`) : "Opening the pull request…",
      ` · ${b.items.length} correction${b.items.length === 1 ? "" : "s"} · `,
      b.pr ? "open: merges itself when its checks pass, unless it waits for the owner" : "this takes about a minute")) : [h("p", { class: "muted small" }, "No open pull requests.")]));

    const text = document.getElementById("batch-text");
    const publish = document.getElementById("publish") as HTMLButtonElement | null;
    if (text && publish) {
      const open = batches[0];
      if (open) {
        text.textContent = open.pr ? `PR #${open.pr} open: merges itself when its checks pass, unless it waits for the owner.` : "Opening the pull request…";
        publish.disabled = true;
      } else if (approved.length === 0) {
        text.textContent = "Nothing waiting to publish";
        publish.disabled = true;
      } else if (me && !me.publishing) {
        text.textContent = `${approved.length} change${approved.length === 1 ? "" : "s"} ready · publishing is not set up yet`;
        publish.disabled = true;
      } else {
        text.textContent = `${approved.length} change${approved.length === 1 ? "" : "s"} ready`;
        publish.disabled = false;
      }
    }
    // The navigation fetched the counts as the page opened; after an action, again.
    if (loadedOnce) refreshSummary(0);
    loadedOnce = true;
  }

  /** The counts in "What's waiting", from the summary every admin page shares. */
  function fillWaiting(s: Summary): void {
    const cell = (key: string) => document.querySelector<HTMLElement>(`[data-sum="${key}"]`);
    const words = (c: Count, noun = "left") => [`${c.left} ${noun}`, c.skipped ? `${c.skipped} skipped` : "",
      c.waiting ? `${c.waiting} marked, to publish` : ""].filter(Boolean).join(" · ");
    const reports = cell("reports");
    if (reports) reports.textContent = s.reports ? `${s.reports} to answer` : "None";
    for (const key of ["fix", "check", "matches", "errors"] as const) {
      const el = cell(key);
      if (el) el.textContent = s.lists[key].total || s.lists[key].left ? words(s.lists[key]) : "None";
    }
    const proof = cell("proofreading");
    if (proof) {
      const p = s.proofreading;
      proof.textContent = `${p.proofread.toLocaleString("en")} of ${p.parts.toLocaleString("en")} proofread` +
        (s.lists.proofreading.skipped ? ` · ${s.lists.proofreading.skipped} with a problem noted` : "");
    }
  }
  onSummary(fillWaiting);

  document.getElementById("publish")?.addEventListener("click", async (event) => {
    const button = event.currentTarget as HTMLButtonElement;
    button.disabled = true;
    say(status, "Publishing…");
    const result = await api<{ batch: string; count: number }>("/publish", {});
    if (!result.ok) {
      fail(result);
      button.disabled = false;
      return;
    }
    say(status, `Sent ${result.data.count} correction(s) to GitHub as ${result.data.batch}. The pull request appears under "On GitHub" in about a minute.`, "ok");
    await load();
  });

  document.getElementById("show-history")?.addEventListener("click", async (event) => {
    (event.currentTarget as HTMLButtonElement).disabled = true;
    const result = await api<{ items: QueueItem[] }>("/history");
    const box = document.getElementById("history");
    if (!result.ok) { fail(result); return; }
    if (result.data.items.length === 0) { box?.replaceChildren(h("p", { class: "muted small" }, "Nothing yet.")); return; }
    const rows = result.data.items.map((i) => h("tr", {},
      h("td", {}, i.updated_at ?? i.created_at), h("td", {}, label(i)), h("td", {}, valueText(i)),
      h("td", {}, i.status), h("td", {}, i.editor_email ?? ""),
      h("td", {}, i.commit_sha ? h("a", { href: `${REPO}/commit/${i.commit_sha}` }, i.commit_sha.slice(0, 7)) : (i.reason ?? ""))));
    box?.replaceChildren(h("div", { class: "scroll" }, h("table", { class: "history-table" },
      h("thead", {}, h("tr", {}, ...["When (UTC)", "What", "Value", "Outcome", "Editor", "Commit or reason"].map((t) => h("th", { scope: "col" }, t)))),
      h("tbody", {}, ...rows))));
  });

  void (async () => {
    const who = await api<Me>("/me");
    if (!who.ok) { fail(who); document.getElementById("pending")?.replaceChildren(); return; }
    me = who.data;
    document.getElementById("who")!.textContent = `Admin · signed in as ${me.email}${me.owner ? " (owner)" : ""}`;
    await load();
  })();
</script>
