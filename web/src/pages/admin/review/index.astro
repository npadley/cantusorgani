---
import AdminNav from "../../../components/AdminNav.astro";
import Layout from "../../../components/Layout.astro";
import { GROUP_LABELS, GROUP_ORDER } from "../../../lib/admin/reviewKinds";
import { reviewEntries } from "../../../lib/admin/reviews";

// Everything the pipeline was not sure of, and the parts whose start looks
// wrong, built with the site: an editor confirms each against the scan (Looks
// right), corrects it, or skips it with a note. Behind Cloudflare Access with
// /admin/; the buttons talk to /admin/api.
const all = reviewEntries();
// What the site cannot act on is listed apart, compactly, with nothing to press.
const entries = all.filter((e) => e.group !== "info");
const info = all.filter((e) => e.group === "info");
const infoKinds = [...new Set(info.map((e) => e.kind))].map((k) => info.filter((e) => e.kind === k));
const groups = GROUP_ORDER.filter((g) => g !== "info");
// Correct opens the edit form, which offers the way back to this item.
const edit = (target: string, from: string) =>
  `/admin/edit/?target=${encodeURIComponent(target)}&from=review&item=${encodeURIComponent(from)}`;
const count = (group: string) => entries.filter((e) => e.group === group).length;
const volumes = [...new Set(entries.map((e) => e.volume))].sort();
const kinds = [...new Map(entries.map((e) => [e.kind, e.label])).entries()];
const anchor = (target: string) => `h-${target.replace(/[^a-z0-9]/gi, "-")}`;
---

<Layout title="Admin: review" noindex>
  <div class="admin ui">
    <AdminNav current="review" />
    <h1>Review</h1>
    <details class="how small">
      <summary>How Review works</summary>
      <p class="prose">What the pipeline was not sure of when it read the scans, and the parts whose start looks wrong.
        Look at each against its scan. The first button confirms it as it is (its words say what you are
        confirming); <strong>Correct</strong> opens the edit form; <strong>Skip with a note</strong> leaves it for
        the next editor. Confirmations are published with the next <strong>Publish changes</strong> on the{" "}
        <a href="/admin/">Admin</a> page, and an item comes back here if a later rebuild changes it.</p>
    </details>

    <form class="filters" id="filters" aria-label="Show">
      <fieldset>
        <legend class="small">Show</legend>
        {groups.map((group, i) => (
          <label class="choice"><input type="radio" name="group" value={group} checked={i === 0} data-label={GROUP_LABELS[group]} />
            {GROUP_LABELS[group]}{" "}<span>(<span data-count={group}>{count(group)}</span>)<span class="muted small" data-skipped={group}></span></span></label>
        ))}
      </fieldset>
      <label class="small">Volume
        <select name="volume"><option value="">All</option>{volumes.map((v) => <option value={v}>{v}</option>)}</select>
      </label>
      <label class="small">Kind
        <select name="kind"><option value="">All</option>{kinds.map(([k, l]) => <option value={k} data-label={l}>{l}</option>)}</select>
      </label>
      <label class="choice small"><input type="checkbox" name="done" /> Show what is already done</label>
    </form>

    <section aria-labelledby="waiting-h" class="waiting">
      <h2 id="waiting-h" class="small">What is waiting</h2>
      <p class="small muted">Each kind is one sort of check. Choose one to work through it on its own.</p>
      <ul id="breakdown" class="small"></ul>
    </section>

    <div id="status" class="status small" role="status" aria-live="polite"></div>
    <p class="small muted" id="shown" aria-live="polite"></p>

    <div id="items">
      {entries.map((e) => (
        <article class:list={["item", e.scans.length > 0 && "has-scan"]} data-review-target={e.target}
                 data-review-seen={e.fingerprint} data-group={e.group} data-volume={e.volume} data-kind={e.kind} data-label={e.label}
                 aria-labelledby={anchor(e.target)}>
          <h3 tabindex="-1" id={anchor(e.target)}>{e.label}: {e.about}</h3>
          <p class="small">{e.look}</p>
          {e.detail && <p class="small muted">{e.detail}</p>}
          {e.scans.length > 0 && (
            <div class="scan">
              {e.scans.map((s) => (
                <figure>
                  {s.stem && <img src={`${s.stem}.webp`} alt={`${s.caption}, as printed`} loading="lazy"
                                  width={s.aspect?.[0]} height={s.aspect?.[1]} />}
                  <figcaption class="small muted">{s.caption}</figcaption>
                </figure>
              ))}
            </div>
          )}
          <div class="actions review-actions">
            <button type="button" class="primary" data-act="looks-right">{e.confirm}</button>
            {e.correct && <a class="button" href={edit(e.correct, e.target)}>Correct</a>}
            {e.sections && <a class="small" href={e.sections}>Edit the sections</a>}
            <button type="button" class="link" data-act="skip">Skip with a note…</button>
            {e.href && <a class="small" href={e.href}>Open the page</a>}
          </div>
          <p class="review-state small" aria-live="polite"></p>
        </article>
      ))}
    </div>
    <div id="none" class="none" hidden>
      <p id="none-text" class="muted"></p>
      <div class="actions"><button type="button" id="none-next" hidden></button>
        <button type="button" id="none-clear" class="link" hidden>Clear the filters</button>
        <a id="none-home" href="/admin/" hidden>Back to the Admin page</a></div>
    </div>

    {info.length > 0 && (
      <section class="info" aria-labelledby="info-h">
        <h2 id="info-h">Things the site can't act on ({info.length})</h2>
        <p class="small muted prose">The pipeline noted these; none of them needs an answer. They are listed so you
          know they are known.</p>
        {infoKinds.map((items) => (
          <details>
            <summary>{items[0]!.label} ({items.length})</summary>
            <p class="small prose">{items[0]!.look}</p>
            <div class="scroll">
              <table class="small">
                <thead><tr><th scope="col">What</th><th scope="col">Volume</th><th scope="col"><span class="sr-only">Page</span></th></tr></thead>
                <tbody>
                  {items.map((e) => (
                    <tr><td>{e.about}</td><td>{e.volume}</td><td>{e.href && <a href={e.href}>Open the page</a>}</td></tr>
                  ))}
                </tbody>
              </table>
            </div>
          </details>
        ))}
      </section>
    )}
  </div>
</Layout>

<style>
  .admin { max-width: 60rem; }
  h1 { margin: 0 0 var(--s-2); }
  .how summary, .info summary { cursor: pointer; padding: var(--s-2) 0; }
  .how p { margin: 0 0 var(--s-2); }
  .none { margin: var(--s-4) 0; }
  .none p { margin: 0 0 var(--s-2); }
  .info { margin-top: var(--s-6); }
  .info h2 { font-size: var(--step-1); padding-bottom: var(--s-2); border-bottom: 1px solid var(--rule); }
  .info details { border-bottom: 1px solid var(--rule); }
  .info table { width: 100%; border-collapse: collapse; margin: var(--s-2) 0 var(--s-3); }
  .info th, .info td { text-align: left; padding: var(--s-1) var(--s-2) var(--s-1) 0; border-bottom: 1px solid var(--rule); vertical-align: top; }
  .scroll { overflow-x: auto; }
  .filters { display: flex; flex-wrap: wrap; gap: var(--s-3); align-items: end; margin: var(--s-3) 0;
             padding: var(--s-2) 0; border-top: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .filters fieldset { border: 0; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-3); }
  .filters legend { padding: 0; margin-bottom: var(--s-1); }
  .filters select { display: block; font: inherit; font-family: var(--font-ui); min-height: var(--tap-min);
                    padding: var(--s-1) var(--s-2); background: var(--paper); color: var(--ink);
                    border: 1px solid var(--rule); border-radius: var(--radius); }
  .waiting h2 { margin: var(--s-2) 0 0; font-family: var(--font-ui); }
  .waiting p { margin: 0 0 var(--s-1); }
  #breakdown { list-style: none; margin: 0 0 var(--s-2); padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-2); }
  :global(#breakdown button) { font: inherit; font-family: var(--font-ui); min-height: var(--tap-min); padding: 0 var(--s-2);
    background: var(--paper); color: var(--ink); border: 1px solid var(--rule); border-radius: var(--radius); cursor: pointer; }
  :global(#breakdown button[aria-pressed="true"]) { border-color: var(--accent); outline: 1px solid var(--accent); }
  .choice { display: inline-flex; align-items: center; gap: var(--s-1); min-height: var(--tap-min); }
  .status { min-height: 1.4em; margin: var(--s-2) 0; }
  .status[data-state="error"] { color: var(--warn-ink); }
  .item { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--s-2);
          padding: var(--s-3) 0; border-bottom: 1px solid var(--rule); }
  @media (min-width: 60rem) {
    .item.has-scan { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--s-4); }
    .item.has-scan .scan { grid-column: 2; grid-row: 1 / span 5; }
  }
  .item h3 { margin: 0; font-size: var(--step-0); }
  .item h3:focus { outline: 2px solid var(--accent); outline-offset: 2px; }
  .item p { margin: 0; }
  .item[data-done] { opacity: 0.7; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center; }
  .button { display: inline-flex; align-items: center; min-height: var(--tap-min); padding: 0 var(--s-3);
            border: 1px solid var(--rule); border-radius: var(--radius); color: var(--ink); text-decoration: none; }
  .scan figure { margin: 0 0 var(--s-2); }
  .scan img { display: block; width: 100%; height: auto; }
  .scan figcaption { margin-top: var(--s-1); }
  :global(.review-state .reason) { display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: end; }
  :global(.review-state .reason label) { display: block; width: 100%; }
  :global(.review-state .reason input) { flex: 1 1 16rem; font: inherit; font-family: var(--font-ui);
    min-height: var(--tap-min); padding: var(--s-2) var(--s-3); background: var(--paper); color: var(--ink);
    border: 1px solid var(--rule); border-radius: var(--radius); }
  :global(.review-state button.link) { background: none; border: 0; padding: 0; min-height: var(--tap-min);
    color: var(--accent); text-decoration: underline; cursor: pointer; font: inherit; }
</style>

<script>
  import { wireReviews } from "../../../lib/admin/reviewClient";
  import { refreshSummary } from "../../../lib/admin/summaryClient";

  const form = document.getElementById("filters") as HTMLFormElement | null;
  const list = document.getElementById("items");
  const none = document.getElementById("none");
  const shown = document.getElementById("shown");
  const all = [...document.querySelectorAll<HTMLElement>("#items [data-review-target]")];

  /** Shows the items the filters choose, and each group's count of what is left to do. */
  function apply(): void {
    if (!form) return;
    const data = new FormData(form);
    const group = String(data.get("group") ?? "fix");
    const volume = String(data.get("volume") ?? "");
    let kind = String(data.get("kind") ?? "");
    // A kind belongs to one group: choosing another group shows all of its kinds.
    if (kind && !all.some((el) => el.dataset["group"] === group && el.dataset["kind"] === kind)) {
      (form.elements.namedItem("kind") as HTMLSelectElement).value = "";
      kind = "";
    }
    const done = data.get("done") !== null;
    let visible = 0;
    for (const el of all) {
      const show = el.dataset["group"] === group && (!volume || el.dataset["volume"] === volume) &&
        (!kind || el.dataset["kind"] === kind) && (done || !el.dataset["done"] || "recent" in el.dataset);
      el.hidden = !show;
      if (show) visible++;
    }
    breakdown(group, volume, kind);
    // Left: not marked and not skipped (summary.ts counts the same way); skipped said apart.
    for (const counter of document.querySelectorAll<HTMLElement>("[data-count]")) {
      const g = counter.dataset["count"];
      counter.textContent = String(all.filter((el) => el.dataset["group"] === g && !el.dataset["done"]).length);
    }
    for (const el of document.querySelectorAll<HTMLElement>("[data-skipped]")) {
      const n = all.filter((i) => i.dataset["group"] === el.dataset["skipped"] && i.dataset["done"] === "skipped").length;
      el.textContent = n ? ` · ${n} skipped` : "";
    }
    if (none) none.hidden = visible > 0;
    if (visible === 0) emptyState(group, volume, kind, done);
    if (shown) shown.textContent = `${visible} shown`;
  }

  const LABELS: Record<string, string> = Object.fromEntries(
    [...(form?.querySelectorAll<HTMLInputElement>("input[name=group]") ?? [])]
      .map((r) => [r.value, r.dataset["label"] ?? r.value]));

  /** When nothing is shown: done with this list (and where next), or filters that hide everything. */
  function emptyState(group: string, volume: string, kind: string, done: boolean): void {
    const text = document.getElementById("none-text");
    const next = document.getElementById("none-next");
    const clear = document.getElementById("none-clear");
    const home = document.getElementById("none-home");
    if (!text || !next || !clear || !home) return;
    const filtered = Boolean(volume || kind);
    const left = (g: string) => all.filter((el) => el.dataset["group"] === g && !el.dataset["done"]).length;
    const other = Object.keys(LABELS).find((g) => g !== group && left(g) > 0);
    clear.hidden = !filtered;
    next.hidden = filtered || !other;
    home.hidden = filtered || Boolean(other);
    if (filtered) text.textContent = "Nothing to show with these choices.";
    else if (other) {
      text.textContent = `All done in “${LABELS[group] ?? group}”${done ? "" : " (tick “Show what is already done” to see it)"}.`;
      next.textContent = `Next: ${LABELS[other] ?? other} (${left(other)})`;
      next.dataset["group"] = other;
    } else text.textContent = "Review is clear: nothing left on either list.";
  }

  document.getElementById("none-next")?.addEventListener("click", (event) => {
    const g = (event.currentTarget as HTMLElement).dataset["group"];
    const radio = [...(form?.querySelectorAll<HTMLInputElement>("input[name=group]") ?? [])].find((r) => r.value === g);
    if (radio) { radio.checked = true; apply(); document.querySelector<HTMLElement>("#items article:not([hidden]) h3")?.focus(); }
  });
  document.getElementById("none-clear")?.addEventListener("click", () => {
    if (!form) return;
    (form.elements.namedItem("kind") as HTMLSelectElement).value = "";
    (form.elements.namedItem("volume") as HTMLSelectElement).value = "";
    apply();
  });

  /** The kinds waiting in this group (and volume), each with how many are left
   * to do: a button that shows that kind alone, and the same counts in the
   * Kind list. A kind with nothing in this group is left out of both. */
  function breakdown(group: string, volume: string, chosen: string): void {
    const select = form?.elements.namedItem("kind") as HTMLSelectElement | null;
    const box = document.getElementById("breakdown");
    if (!select || !box) return;
    const left = new Map<string, number>();
    // A kind's words can differ by group ("No chant linked" is information only
    // on a Proper): take them from this group's own items.
    const words = new Map<string, string>();
    for (const el of all) {
      if (el.dataset["group"] !== group) continue;
      const kind = el.dataset["kind"] ?? "";
      if (!words.has(kind)) words.set(kind, el.dataset["label"] ?? kind);
      if ((volume && el.dataset["volume"] !== volume) || el.dataset["done"]) continue;
      left.set(kind, (left.get(kind) ?? 0) + 1);
    }
    box.replaceChildren();
    for (const option of [...select.options]) {
      if (!option.value) continue;
      const n = left.get(option.value) ?? 0;
      const label = words.get(option.value) ?? option.dataset["label"] ?? option.value;
      option.textContent = `${label} (${n})`;
      option.hidden = n === 0 && option.value !== chosen;
      if (n === 0) continue;
      const button = document.createElement("button");
      button.type = "button";
      button.textContent = `${label} (${n})`;
      button.setAttribute("aria-pressed", String(option.value === chosen));
      button.addEventListener("click", () => {
        select.value = option.value === select.value ? "" : option.value;
        apply();
      });
      const item = document.createElement("li");
      item.append(button);
      box.append(item);
    }
  }

  // Opened at a list: /admin/review/?group=check, or ?kind=part_to_check (its group follows).
  const params = new URLSearchParams(location.search);
  const askedKind = params.get("kind") ?? "";
  const kindGroup = all.find((el) => el.dataset["kind"] === askedKind)?.dataset["group"];
  const askedGroup = kindGroup ?? params.get("group") ?? "";
  const radio = [...(form?.querySelectorAll<HTMLInputElement>("input[name=group]") ?? [])].find((r) => r.value === askedGroup);
  if (radio) radio.checked = true;
  if (form && kindGroup) (form.elements.namedItem("kind") as HTMLSelectElement).value = askedKind;

  form?.addEventListener("change", apply);
  apply();
  // After the editor acts, the counts every admin page shares are fetched again.
  let ready = false;
  const changed = (): void => { apply(); if (ready) refreshSummary(); };
  // Back from a correction: ?after=<item> goes on to the next item still to do, ?at=<item> to the item itself.
  const onTo = params.get("after") ?? params.get("at");
  const after = all.find((el) => el.dataset["reviewTarget"] === onTo);
  if (after && !kindGroup) {
    const r = [...(form?.querySelectorAll<HTMLInputElement>("input[name=group]") ?? [])].find((x) => x.value === after.dataset["group"]);
    if (r) { r.checked = true; apply(); }
  }
  if (list) void wireReviews(list, document.getElementById("status"), changed).then(() => {
    ready = true;
    if (!after) return;
    const rest = params.has("at") ? after : all.slice(all.indexOf(after) + 1).find((el) => !el.hidden && !el.dataset["done"]);
    const heading = (rest ?? after).querySelector<HTMLElement>("h3");
    heading?.scrollIntoView({ block: "start" });
    heading?.focus();
  });
</script>
