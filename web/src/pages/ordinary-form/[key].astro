---
import Crumbs from "../../components/Crumbs.astro";
import ServiceRail from "../../components/ServiceRail.astro";
import SourceBlock from "../../components/SourceBlock.astro";
import { exportSegments } from "../../lib/exportParts";
import { gregobaseUrl } from "../../lib/catalog";
import Layout from "../../components/Layout.astro";
import MovementNav from "../../components/MovementNav.astro";
import SystemStack from "../../components/SystemStack.astro";
import TypesetSwitch from "../../components/TypesetSwitch.astro";
import { allOrdinaryFormParts, ordinaryFormOccasions, ordinaryFormPiece } from "../../lib/ordinaryFormPieces";
import { musicView } from "../../lib/music";
import { hasTypeset } from "../../lib/typeset";
import { goodFridayHref } from "../../lib/goodFriday";

export function getStaticPaths() {
  return ordinaryFormOccasions().map(row => ({ params: { key: row.key }, props: { key: row.key } }));
}

interface Props { readonly key: string }
const { key } = Astro.props;
const piece = ordinaryFormPiece(key);
if (!piece) return Astro.redirect("/404/", 302);
const score = musicView(piece);
const parts = allOrdinaryFormParts(key);
const missing = parts.filter(part => !part.lender).length;
const unmapped = piece.sourceNote === "chants not yet mapped";
const chantsOnly = goodFridayHref(key);
const exportParts = exportSegments([piece]);
// The composed piece has volume "ordinary-form", not a printed edition.
const sources = [...new Map(parts.flatMap(part => part.lender ? [[part.lender.piece.slug, part.lender.piece] as const] : [])).values()];
---

<Layout title={piece.title} description={`${piece.title} — Ordinary Form chants assigned in the Graduale Romanum (1974), with available Nova Organi Harmonia accompaniments.`} skipTo={score.systems.length > 0 ? "music" : undefined}>
  <div class="reader-layout">
  <ServiceRail pieces={[piece]} title={piece.title}>
    <p slot="heading-summary" id="selection-summary" class="small muted ui"></p>
    <div slot="reader-tools">
      <MovementNav piece={score} variant="tools" />
      <TypesetSwitch show={hasTypeset(score)} />
    </div>
  </ServiceRail>
  <article class="reading-column" data-of-page>
    <header class="head">
      <Crumbs><a href="/">Cantus Organi</a> · <a href="/calendar/ordinary-form/">Ordinary Form calendar</a></Crumbs>
      <h1>{piece.title}</h1>
      <p class="latin" lang="la">{ordinaryFormOccasions().find(row => row.key === key)?.title_la}</p>
      {ordinaryFormOccasions().find(row => row.key === key)?.rubric_en && <p class="rubric ui small">{ordinaryFormOccasions().find(row => row.key === key)?.rubric_en}</p>}
    </header>

    {chantsOnly && (
      <p class="notice ui" role="note">
        <strong>The organ is silent on Good Friday.</strong> The settings below are borrowed from other
        days. For the liturgy itself, see <a href={chantsOnly}>the chants of Good Friday</a>, unaccompanied.
      </p>
    )}

    {/* Below 40rem the year and jump links share one row, so the first system still shows above the foot bar. */}
    <div class="reading-nav">
      <div id="cycle-alternatives" class="ui">
        {score.systems.length > 0 && exportParts.length > 0 && (
          <nav class="cycle-links" aria-label="Lectionary year">
            <span class="small muted" aria-hidden="true">Year</span>
            {["A", "B", "C"].map(cycle => <a href={`?cycle=${cycle}`} data-cycle={cycle} aria-label={`Year ${cycle}`}>{cycle}</a>)}
          </nav>
        )}
        <p id="of-export-note" class="small muted" aria-live="polite"><span data-of-scope>All years · all seasons</span><span class="sr-only">. Every applicable alternative starts selected; choose the chants required for this celebration.</span></p>
      </div>
      <MovementNav piece={score} variant="links" />
    </div>
    <SystemStack piece={score} exportParts={exportParts} id="music" />
    <section id="missing-lender" class="small muted ui">
      <h2>About this set</h2>
      <p class="meta">Graduale Romanum (1974) · {parts.length} assigned chant{parts.length === 1 ? "" : "s"}{missing ? ` · ${missing} without a NOH match` : ""}</p>
      {score.systems.length > 0 && <p>Every applicable alternative starts selected, and the music for other years and seasons stays on the page. Choose the chants required for this celebration.</p>}
      <p>
        This page assembles available Nova Organi Harmonia music for chants assigned in the 1974 Graduale Romanum.
        {missing > 0 && ` ${missing} assigned chant${missing === 1 ? " is" : "s are"} not in Nova Organi Harmonia.`}
        {unmapped && " chants not yet mapped."}
      </p>
      {missing > 0 && <ul>{parts.filter(part => !part.lender).map(part => (
        <li data-missing-label={part.label}>
          {part.label}: Not in Nova Organi Harmonia{gregobaseUrl(part.gregobaseId) && <> — <a href={gregobaseUrl(part.gregobaseId)!} target="_blank" rel="noopener">Open chant {part.gregobaseId} on GregoBase</a></>}
        </li>
      ))}</ul>}
    </section>
    <SourceBlock pieces={sources} />
    <p class="small muted ui source-note">Chant assignments follow the Graduale Romanum (1974). Each NOH section remains linked to its printed source and correction target.</p>
  </article>
  </div>
  <script>
    import { mountOrdinaryFormPage } from "../../lib/ordinaryFormPageClient";
    const root = document.querySelector<HTMLElement>("[data-of-page]");
    if (root) mountOrdinaryFormPage(root);
  </script>
</Layout>

<style>
  @media print { .reader-layout { display: block; } }
  .reading-column { min-width: 0; }
  @media screen and (width < 62rem) {
    .reader-layout { display: flex; flex-direction: column; }
    .reader-layout > :global(.service-rail) { order: 1; }
  }
  @media screen and (min-width: 62rem) {
    .reader-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: var(--s-4); align-items: start; }
    .reading-column { grid-column: 2; grid-row: 1; }
    .reader-layout > :global(.service-rail) { grid-column: 1; grid-row: 1; }
  }
  .reading-column :global(.movements) { flex-wrap: nowrap; overflow-x: auto; margin: 0; gap: var(--s-1); }
  .reading-column :global(.movements > *) { flex-shrink: 0; }
  .head { margin-bottom: var(--s-1); }
  #cycle-alternatives { display: flex; flex-wrap: wrap; align-items: center; gap: 0 var(--s-3); margin: 0 0 var(--s-1); }
  @media (width < 40rem) {
    .reading-nav { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; column-gap: var(--s-3); }
    .reading-nav #cycle-alternatives { display: contents; }
    .cycle-links { grid-column: 1; grid-row: 1; }
    .reading-nav :global(.movements) { grid-column: 2; grid-row: 1; }
    #of-export-note { grid-column: 1 / -1; grid-row: 2; }
  }
  .cycle-links { display: flex; align-items: center; gap: var(--s-1); }
  .cycle-links a { display: inline-flex; align-items: center; justify-content: center; min-height: var(--tap-min); min-width: var(--tap-min); }
  .cycle-links a[aria-current] { font-weight: 700; color: var(--ink); text-decoration-thickness: 2px; }
  #of-export-note { margin: 0; }
  .reading-column :global(#music > .part-head:first-of-type) { margin-top: var(--s-1); }
  #missing-lender { margin-top: var(--s-4); }
  #missing-lender h2 { font-size: var(--step-0); }
  #missing-lender a { display: inline-flex; align-items: center; min-height: var(--tap-min); }
  h1 { margin-bottom: var(--s-1); }
  .latin { margin: 0; font-style: italic; }
  .source-note { margin-top: var(--s-4); }
</style>
