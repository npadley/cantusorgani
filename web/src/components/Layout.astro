---
import "../styles/base.css";

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly skipTo?: string;
  /** Keep the page out of search engines and the site search (admin pages). */
  readonly noindex?: boolean;
}

const { title, description, skipTo, noindex = false } = Astro.props;
const fullTitle = title === "Cantus Organi" ? title : `${title} — Cantus Organi`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Typeset music or the scans, page-wide (TypesetSwitch.astro): applied
      // before the page draws, so nothing flashes. Per viewer; storage may throw.
      try { if (localStorage.getItem("typeset-view") === "scans") document.documentElement.setAttribute("data-view", "scans"); } catch (e) { /* ignore */ }
    </script>
  </head>
  <body>
    {skipTo && <a class="skip-link ui" href={`#${skipTo}`}>Skip to music</a>}

    <nav class="nav no-print ui">
      <div class="nav-inner">
        <a class="brand" href="/">Cantus Organi</a>
        <div class="nav-links">
          <a href="/calendar/">Calendar</a>
          <a href="/search/">Search</a>
          <a href="/about/">About</a>
          <a href="/corrections/">Corrections</a>
          <button id="polarity" type="button" aria-pressed="false"
                  title="Invert the scans for a dark organ loft">Invert</button>
        </div>
      </div>
    </nav>

    <main class="page" data-pagefind-ignore={noindex ? "all" : undefined}>
      <slot />
    </main>

    <footer class="footer no-print">
      <p class="page small muted ui">
        Music from <em>Nova Organi Harmonia</em> (Mechelen, 1942), in the public domain ·
        <a href="/about/#sources">Sources and attributions</a> ·
        <a href="/corrections/">Report an error</a>
      </p>
    </footer>

    <script is:inline>
      // Per-viewer convenience only: which way round the scans read. Wrapped
      // because storage throws outright in some privacy modes.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("polarity");
        var stored = null;
        try { stored = localStorage.getItem("scan-polarity"); } catch (e) { /* ignore */ }
        if (stored === "inverted" || stored === "normal") {
          root.setAttribute("data-scan-polarity", stored);
        }
        function sync() {
          var on = root.getAttribute("data-scan-polarity") === "inverted";
          if (btn) btn.setAttribute("aria-pressed", on ? "true" : "false");
        }
        sync();
        if (btn) {
          btn.addEventListener("click", function () {
            var next = root.getAttribute("data-scan-polarity") === "inverted"
              ? "normal" : "inverted";
            root.setAttribute("data-scan-polarity", next);
            try { localStorage.setItem("scan-polarity", next); } catch (e) { /* ignore */ }
            sync();
          });
        }
      })();
    </script>
  </body>
</html>

<style>
  .nav {
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
  }
  .nav-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--s-2) var(--s-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-text);
    font-size: var(--step-0);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .nav-links {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .nav-links a {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
  }
  .footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--s-6);
    padding: var(--s-4) 0;
  }
  .footer .page { margin: 0 auto; padding: var(--s-2) var(--s-3); line-height: 1.6; }
</style>
