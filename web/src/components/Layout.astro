---
import "../styles/base.css";
import { canonicalUrl, indexablePath, SITE_DESCRIPTION, SITE_ORIGIN } from "../lib/seo";

interface Props {
  readonly title: string;
  readonly description?: string;
  readonly skipTo?: string;
  /** Keep the page out of search engines and the site search (admin pages). */
  readonly noindex?: boolean;
}

const { title, description = SITE_DESCRIPTION, skipTo } = Astro.props;
const noindex = (Astro.props.noindex ?? false) || !indexablePath(Astro.url.pathname);
const canonical = canonicalUrl(Astro.url.pathname);
const socialImage = `${SITE_ORIGIN}/social-card.png`;
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${SITE_ORIGIN}/#website`, url: `${SITE_ORIGIN}/`, name: "Cantus Organi", description: SITE_DESCRIPTION, inLanguage: "en" },
    { "@type": "WebPage", "@id": canonical, url: canonical, name: title, description,
      isPartOf: { "@id": `${SITE_ORIGIN}/#website` }, inLanguage: ["en", "la"] },
  ],
};
const fullTitle = title === "Cantus Organi" ? title : `${title} — Cantus Organi`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cantus Organi" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Cantus Organi — Gregorian chant organ accompaniments" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Cantus Organi — Gregorian chant organ accompaniments" />
    {!noindex && <script is:inline type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, "\\u003c")} />}
    {noindex && <meta name="robots" content={Astro.url.pathname.startsWith("/admin/") ? "noindex, nofollow" : "noindex, follow"} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Typeset music or the scans, page-wide (TypesetSwitch.astro): applied
      // before the page draws, so nothing flashes. Per viewer; storage may throw.
      try {
        var polarity = localStorage.getItem("scan-polarity");
        if (polarity === "normal" || polarity === "inverted") document.documentElement.setAttribute("data-scan-polarity", polarity);
      } catch (e) { /* ignore */ }
      try { if (localStorage.getItem("typeset-view") === "scans") document.documentElement.setAttribute("data-view", "scans"); } catch (e) { /* ignore */ }
    </script>
  </head>
  <body>
    {skipTo && <a class="skip-link ui" href={`#${skipTo}`}>Skip to music</a>}

    <nav class="nav no-print ui">
      <div class="nav-inner">
        <a class="brand" href="/">Cantus Organi</a>
        <div class="nav-links">
          <a href="/calendar/">Calendar</a>
          <a href="/search/">Search</a>
          <a href="/about/">About</a>
          <a href="/corrections/">Corrections</a>
          <button id="polarity" type="button" aria-pressed="false"
                  title="Switch the page and music between light and dark">Invert</button>
        </div>
      </div>
    </nav>

    <main class="page" data-pagefind-ignore={noindex ? "all" : undefined}>
      <slot />
    </main>

    <footer class="footer no-print">
      <p class="page small muted ui">
        Music from <em>Nova Organi Harmonia</em> (Mechelen, 1942), in the public domain ·
        <a href="/about/#sources">Sources and attributions</a> ·
        <a href="/corrections/">Report an error</a> ·
        <a href="/llms.txt">AI discovery guide</a>
      </p>
    </footer>

    <script is:inline>
      // Per-viewer theme for both the page and its music. Wrapped
      // because storage throws outright in some privacy modes.
      (function () {
        var root = document.documentElement;
        var btn = document.getElementById("polarity");
        var stored = null;
        try { stored = localStorage.getItem("scan-polarity"); } catch (e) { /* ignore */ }
        if (stored === "inverted" || stored === "normal") {
          root.setAttribute("data-scan-polarity", stored);
        }
        var systemTheme = window.matchMedia("(prefers-color-scheme: dark)");
        function inverted() {
          var choice = root.getAttribute("data-scan-polarity");
          return choice ? choice === "inverted" : systemTheme.matches;
        }
        function sync() {
          var on = inverted();
          if (btn) btn.setAttribute("aria-pressed", on ? "true" : "false");
        }
        sync();
        if (btn) {
          btn.addEventListener("click", function () {
            var next = inverted()
              ? "normal" : "inverted";
            root.setAttribute("data-scan-polarity", next);
            try { localStorage.setItem("scan-polarity", next); } catch (e) { /* ignore */ }
            sync();
          });
        }
      })();
    </script>

    <script data-goatcounter="https://cantusorgani.goatcounter.com/count" async src="//gc.zgo.at/count.js"></script>
  </body>
</html>

<style>
  .nav {
    border-bottom: 1px solid var(--rule);
    font-size: var(--step--1);
  }
  .nav-inner {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--s-2) var(--s-3);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .brand {
    font-family: var(--font-text);
    font-size: var(--step-0);
    color: var(--ink);
    text-decoration: none;
    letter-spacing: 0.01em;
  }
  .nav-links {
    display: flex;
    flex-wrap: wrap;
    min-width: 0;
    align-items: center;
    gap: var(--s-3);
  }
  .nav-links a {
    min-height: var(--tap-min);
    display: inline-flex;
    align-items: center;
  }
  .footer {
    border-top: 1px solid var(--rule);
    margin-top: var(--s-6);
    padding: var(--s-4) 0;
  }
  .footer .page { margin: 0 auto; padding: var(--s-2) var(--s-3); line-height: 1.6; }
</style>
