---
import VespersDates from "./VespersDates.astro";
import ServiceRail from "./ServiceRail.astro";
import DayMarker from "./DayMarker.astro";
import SourceBlock from "./SourceBlock.astro";
import Layout from "./Layout.astro";
import LineupStack from "./LineupStack.astro";
import { hasNotation } from "../lib/chants";
import { observance } from "../lib/liturgy";
import { hubHref, occasions, consoleLine, exportLineup, itemSystems, lineupHref, lineupTitle, loadLineup, sections } from "../lib/vespers";
import type { LineupDay } from "../lib/vespers";

// One Vespers in the order sung: II Vespers of a date (/vespers/<date>/), or
// I Vespers of a I class feast, sung the evening before (/vespers/<date>/i/).
interface Props { readonly day: LineupDay }
const { day } = Astro.props;
const o = observance(day.observance);
const title = lineupTitle(day);
const dates = occasions().find(group => group.office === day.office)?.days ?? [];
const colours: Readonly<Record<string, "white" | "red" | "violet" | "green" | "black" | "rose">> = {
  w: "white", r: "red", v: "violet", g: "green", b: "black", p: "rose",
};
const colour = colours[o?.colors[0] ?? ""];
function long(iso: string): string {
  const [y, m, d] = iso.split("-").map(Number);
  return new Date(Date.UTC(y ?? 1970, (m ?? 1) - 1, d ?? 1)).toLocaleDateString("en-GB", {
    weekday: "long", day: "numeric", month: "long", year: "numeric", timeZone: "UTC",
  });
}
const when = day.eveningOf ? `sung on the evening of ${long(day.eveningOf)}` : long(day.date);
const serviceTitle = `${day.vespers} Vespers — ${title}, ${when}`;
const sources = [...new Map(day.items.flatMap(item => itemSystems(item).map(system => [system.piece.slug, system.piece] as const))).values()];
const secs = sections(day);
const nav = secs.filter((s) => s.nav !== null);
const notation = day.items.some((i) => !i.repeat && hasNotation(i.chant));
const [flex, name] = (o?.key ?? day.office).split(":");
// 1962: when tomorrow is a I class feast, this evening's Vespers are its I Vespers.
const tomorrow = (() => {
  const [y, m, d] = day.date.split("-").map(Number);
  return new Date(Date.UTC(y ?? 1970, (m ?? 1) - 1, (d ?? 1) + 1)).toISOString().slice(0, 10);
})();
const evening = day.eveningOf ? undefined : [...loadLineup().firstVespers.values()].find((f) => f.eveningOf === day.date && f.date === tomorrow);
const eveningTitle = evening ? lineupTitle(evening) : null;
---


<Layout title={`${day.vespers} Vespers: ${title}`} skipTo="initium"
        description={`${day.vespers} Vespers of ${title}, ${when}, in the order sung — organ accompaniment from Nova Organi Harmonia, under the 1962 rubrics.`}>
  <div class="reader-layout">
  <ServiceRail pieces={[]} segments={exportLineup(day)} title={serviceTitle} railTitle={serviceTitle} showDayMarker={false} observanceKey={day.observance}>
    {notation && <label slot="reader-tools" class="chant-toggle ui small no-print">
      <input type="checkbox" data-chant-toggle />
      Show the chant with each antiphon and hymn
    </label>}
  </ServiceRail>
  <article class="reading-column">
  <div class="prose">
    <p class="crumb small muted ui">
      <a href="/">Cantus Organi</a> · <a href="/calendar/">Calendar</a> · <a href={`/day/${flex}/${name}/`}>{title}</a>
    </p>
    {colour && <p class="day-colour ui small"><DayMarker colour={colour} /></p>}
    <h1>{title}</h1>
    {o && <p class="lede" lang="la">{o.titleLa} · ad Vesperas</p>}
    <p class="meta ui small muted">{day.vespers} Vespers · {when} · 1962 rubrics · Nova Organi Harmonia VIII</p>
    <p class="console ui">{consoleLine(day)}</p>
    <p class="ui no-print"><a href={hubHref(day.office)}>All evenings of this occasion</a></p>
    {evening && (
      <p class="notice-quiet ui small">This evening the 1962 rubrics give <a href={lineupHref(evening)}>I Vespers of {eveningTitle}</a> (tomorrow is a I class feast); these are the Vespers of the day itself.</p>
    )}
  </div>

  <h2 id="order-of-vespers-heading" class="order-heading no-print">Order of Vespers</h2>
  <nav class="order ui no-print" aria-labelledby="order-of-vespers-heading">
    {nav.map((s) => <a href={`#${s.anchor}`}>{s.nav}</a>)}
  </nav>
  <LineupStack day={day} />

  <SourceBlock pieces={sources} />
  <VespersDates days={dates} heading="Coming evenings" />
  </article>
  </div>
</Layout>

<style>
  .reading-column { min-width: 0; }
  .order-heading { font-family: var(--font-text); font-size: var(--step-1); margin: 0 0 var(--s-1); }
  @media screen and (width < 62rem) {
    .reader-layout { display: flex; flex-direction: column; }
    .reader-layout > :global(.service-rail) { order: 1; }
  }
  @media screen and (min-width: 62rem) {
    .reader-layout { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 3fr); gap: var(--s-4); align-items: start; }
    .reading-column { grid-column: 2; grid-row: 1; }
    .reader-layout > :global(.service-rail) { grid-column: 1; grid-row: 1; }
  }
  @media print { .reader-layout { display: block; } }

  .day-colour { margin: 0 0 var(--s-1); }
  .crumb { margin: 0 0 var(--s-1); }
  .crumb a { color: var(--ink-muted); }
  .lede { font-style: italic; font-size: var(--step-1); margin: 0 0 var(--s-1); }
  .meta { margin: 0 0 var(--s-2); }
  .console { margin: 0 0 var(--s-3); font-weight: 600; }
  .notice-quiet { margin: 0 0 var(--s-3); padding-left: var(--s-3); border-left: 2px solid var(--rule); }
  .order {
    display: flex; flex-wrap: wrap; gap: 0 var(--s-2); align-items: center;
    margin: 0 0 var(--s-3); padding-bottom: var(--s-2); border-bottom: 1px solid var(--rule);
    scroll-margin-top: var(--s-4);
  }
  .order a {
    min-height: var(--tap-min); display: inline-flex; align-items: center; padding: 0 var(--s-2);
  }
  .chant-toggle {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: var(--tap-min); margin: 0 0 var(--s-3); cursor: pointer;
  }
  .chant-toggle input { width: 1.25rem; height: 1.25rem; margin: 0; }
</style>

<script>
  import { initChantNotation } from "../scripts/chantNotation";
  initChantNotation();
</script>
