---
// The admin pages' own navigation, under the site header on every admin page:
// where each list is, how much is left on it, and whether anything is waiting
// to publish. The counts come from /admin/api/summary (summary.ts), so every
// page shows the same numbers.
interface Props { current: "home" | "review" | "typeset" | "edit" | "sections" }
const { current } = Astro.props;
const links = [
  { key: "home", href: "/admin/", label: "Admin" },
  { key: "review", href: "/admin/review/", label: "Review" },
  { key: "typeset", href: "/admin/typeset/", label: "Typeset music" },
  { key: "edit", href: "/admin/edit/", label: "Make a correction" },
] as const;
---

<nav class="admin-nav ui small" aria-label="Admin">
  <ul>
    {links.map((l) => (
      <li>
        <a href={l.href} aria-current={l.key === current || (current === "sections" && l.key === "edit") ? "page" : undefined}>{l.label}</a>
        {l.key !== "edit" && <span class="count muted" data-nav-count={l.key}></span>}
      </li>
    ))}
    <li class="publish" hidden data-nav-publish><a href="/admin/#waiting-h"><span data-nav-count="publish"></span> ready to publish</a></li>
  </ul>
</nav>

<style>
  .admin-nav { margin: 0 0 var(--s-3); padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); }
  .admin-nav ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: var(--s-1) var(--s-4); }
  .admin-nav li { display: inline-flex; align-items: baseline; gap: var(--s-1); }
  .admin-nav a { display: inline-flex; align-items: center; min-height: var(--tap-min); }
  .admin-nav a[aria-current="page"] { font-weight: 600; color: var(--ink); text-decoration-thickness: 2px; }
  .admin-nav li[hidden] { display: none; }
  .admin-nav .publish a { font-weight: 600; }

  /* Shared by every admin page (each includes this navigation). */
  /* Inputs and buttons edged at 3:1 against the paper, so each control can be seen. */
  :global(.admin.ui button:not(.primary):not(.link)), :global(.admin.ui .button), :global(.admin.ui input),
  :global(.admin.ui select), :global(.admin.ui textarea) { border-color: var(--control-border); }
  :global(.admin .primary) { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  :global(.admin .primary:disabled) { background: var(--paper); color: var(--ink-muted); border-color: var(--rule); }
  :global(.admin button.link) { background: none; border: 0; padding: 0; min-height: var(--tap-min); color: var(--accent);
    text-decoration: underline; cursor: pointer; font: inherit; }
  /* The notice bar (client.ts): the last outcome, with Undo, in view whatever the scroll. */
  :global(.admin-notice) { position: fixed; z-index: 10; left: 50%; bottom: var(--s-3); transform: translateX(-50%);
    width: max-content; max-width: min(42rem, calc(100% - 2 * var(--s-3))); display: flex; flex-wrap: wrap;
    align-items: center; gap: var(--s-2) var(--s-3); padding: var(--s-2) var(--s-3); border-radius: var(--radius);
    background: var(--ink); color: var(--paper); box-shadow: 0 2px 8px rgb(0 0 0 / 0.25); }
  :global(.admin-notice[hidden]) { display: none; }
  /* Clicks pass through the bar to the page beneath, except on its own buttons; and
     scrolling to a control leaves room for the bar, so it never hides what is pressed. */
  :global(.admin-notice) { pointer-events: none; }
  :global(.admin-notice button) { pointer-events: auto; }
  :global(html:has(#admin-notice:not([hidden]))) { scroll-padding-bottom: 6rem; }
  :global(body:has(#admin-notice:not([hidden]))) { padding-bottom: 6rem; }
  :global(.admin-notice .dismiss) { font: inherit; min-height: var(--tap-min); min-width: var(--tap-min); padding: 0;
    background: transparent; color: inherit; border: 0; cursor: pointer; }
  :global(.admin-notice[data-state="error"]) { background: var(--warn-bg); color: var(--warn-ink); border: 1px solid var(--warn-ink); }
  :global(.admin-notice[data-state="error"]::before) { content: "Error: "; font-weight: 600; }
  :global(.admin-notice .undo) { font: inherit; font-weight: 600; min-height: var(--tap-min); padding: 0 var(--s-3);
    background: transparent; color: inherit; border: 1px solid currentColor; border-radius: var(--radius); cursor: pointer; }
</style>

<script>
  import { loadSummary, navCounts, onSummary } from "../lib/admin/summaryClient";

  onSummary((s) => {
    const counts = navCounts(s);
    for (const el of document.querySelectorAll<HTMLElement>("[data-nav-count]")) {
      const key = el.dataset["navCount"] as keyof typeof counts;
      const n = counts[key];
      el.textContent = key === "publish" ? String(n) : `(${n})`;
    }
    const publish = document.querySelector<HTMLElement>("[data-nav-publish]");
    if (publish) publish.hidden = counts.publish === 0;
  });
  void loadSummary();
</script>
