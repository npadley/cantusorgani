---
import ExportBar from "./ExportBar.astro";
import DayMarker from "./DayMarker.astro";
import type { Piece } from "../lib/catalog";
import { exportSegments } from "../lib/exportParts";
import { observance } from "../lib/liturgy";
interface Props {
  readonly pieces: readonly Piece[];
  readonly title: string;
  readonly occasion?: Piece;
}
const { pieces, title, occasion = pieces[0] } = Astro.props;
const hasMusic = exportSegments(pieces).length > 0;
const day = occasion?.days.map(key => observance(key)).find(Boolean);
// Calendar vocabulary stores colour codes, not CSS colour names. Never infer
// an occasion's colour from words in its title.
const colourNames: Readonly<Record<string, "white" | "red" | "violet" | "green" | "black" | "rose">> = {
  w: "white", r: "red", v: "violet", g: "green", b: "black", p: "rose",
};
const colour = colourNames[day?.colors[0] ?? ""];
---
{hasMusic ? <aside class="service-rail no-print" aria-label="PDF and reading controls">
  <header class="rail-heading">
    {colour && <p class="small ui"><DayMarker colour={colour} /></p>}
    <p class="rail-title" lang={day?.titleEn ? "en" : "la"}>{day?.titleEn ?? title}</p>
    <p class="small ui">Choose what goes into your PDF.</p>
  </header>
  <ExportBar pieces={pieces} title={title} variant="rail">
    <slot name="reader-tools" slot="reader-tools" />
  </ExportBar>
</aside> : <div class="no-print"><slot name="reader-tools" /></div>}
<style>
  .service-rail { min-width: 0; background: var(--paper); }
  .rail-heading .rail-title { font-family: var(--font-text); font-size: var(--step-1); margin: 0; }
  .rail-heading p { margin: 0 0 var(--s-2); }
  @media (min-width: 62rem) {
    .service-rail { position: sticky; top: var(--s-3); align-self: start; max-height: calc(100dvh - var(--s-4) - var(--s-3)); overflow: auto; scroll-padding: var(--s-3); padding: var(--s-1) var(--s-3) var(--s-3) var(--s-1); border-right: 1px solid var(--rule); }
  }
  @media (width < 62rem) {
    .rail-heading { display: none; }
    .service-rail { position: sticky; bottom: 0; z-index: 5; padding: var(--s-2) 0; max-height: calc(100dvh - var(--s-4)); overflow: auto; scroll-padding: var(--s-3); border-top: 1px solid var(--rule); }
  }
  @media print { .service-rail { display: none; } }
</style>
