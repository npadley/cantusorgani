---
import ExportBar from "./ExportBar.astro";
import DayMarker from "./DayMarker.astro";
import type { DayTable } from "../lib/dayService";
import type { Season } from "../lib/liturgy";
import type { ExportSegment } from "../lib/exportParts";
import type { Piece } from "../lib/catalog";
import { exportSegments } from "../lib/exportParts";
import { observance } from "../lib/liturgy";
interface Props {
  readonly pieces: readonly Piece[];
  readonly title: string;
  /** English reader heading when the service needs more context than the day name. */
  readonly railTitle?: string;
  readonly showDayMarker?: boolean;
  readonly occasion?: Piece;
  readonly observanceKey?: string;
  readonly segments?: readonly ExportSegment[];
  readonly season?: Season | null;
  readonly dateLabel?: string | null;
  readonly dayService?: { table: DayTable; buildDefaultIso: string | null; title: string; unavailable: readonly string[] };

}
const { pieces, title, occasion = pieces[0] } = Astro.props;
const hasMusic = (Astro.props.segments ?? exportSegments(pieces)).length > 0;
const day = Astro.props.observanceKey ? observance(Astro.props.observanceKey) : occasion?.days.map(key => observance(key)).find(Boolean);
// Calendar vocabulary stores colour codes, not CSS colour names. Never infer
// an occasion's colour from words in its title.
const colourNames: Readonly<Record<string, "white" | "red" | "violet" | "green" | "black" | "rose">> = {
  w: "white", r: "red", v: "violet", g: "green", b: "black", p: "rose",
};
const colour = colourNames[day?.colors[0] ?? ""];
---
{hasMusic ? <aside class="service-rail no-print" aria-label="PDF and reading controls">
  <header class="rail-heading">
    {colour && Astro.props.showDayMarker !== false && <p class="small ui"><DayMarker colour={colour} /></p>}
    <p class="rail-title" lang={Astro.props.railTitle || day?.titleEn ? "en" : "la"}>{Astro.props.railTitle ?? day?.titleEn ?? title}</p>
    <p class="small ui">Choose what goes into your PDF.</p>
    <slot name="heading-summary" />
  </header>
  <template data-woodcut-selection>
    <div class="woodcut-moment" data-selection-art>
      <img class="woodcut woodcut-small" loading="lazy" decoding="async" src="/art/v1/detail-chalice-360.webp" srcset="/art/v1/detail-chalice-360.webp 360w, /art/v1/detail-chalice-720.webp 720w" sizes="6rem" width="360" height="412" alt="" />
    </div>
  </template>
  <ExportBar pieces={pieces} title={title} variant="rail" {...(Astro.props.segments ? { segments: Astro.props.segments } : {})} season={Astro.props.season ?? null} dateLabel={Astro.props.dateLabel ?? null} {...(Astro.props.dayService ? { dayService: Astro.props.dayService } : {})}>
    <slot name="reader-tools" slot="reader-tools" />
  </ExportBar>
</aside> : <div class="no-print"><slot name="reader-tools" /></div>}
<style>
  .service-rail { min-width: 0; background: var(--paper); }
  .rail-heading .rail-title { font-family: var(--font-text); font-size: var(--step-1); margin: 0; }
  .rail-heading p { margin: 0 0 var(--s-2); }
  @media (min-width: 62rem) {
    .service-rail { position: sticky; top: var(--s-3); align-self: start; max-height: calc(100dvh - var(--s-4) - var(--s-3)); overflow: auto; scroll-padding: var(--s-3); padding: var(--s-1) var(--s-3) var(--s-3) var(--s-1); border-right: 1px solid var(--rule); }
  }
  @media (width < 62rem) {
    .rail-heading { display: none; }
    .service-rail { position: sticky; bottom: 0; z-index: 5; padding: var(--s-2) 0; max-height: calc(100dvh - var(--s-4)); overflow: auto; scroll-padding: var(--s-3); border-top: 1px solid var(--rule); }
  }
  @media screen and (width < 62rem) {
    .service-rail { padding: var(--s-1) 0; }
  }
  @media print { .service-rail { display: none; } }
</style>

<script>
  // Keep the art in the existing part list, which moves into the phone sheet.
  // Observe the summary so calendar defaults and Customize returns update it too.
  for (const rail of document.querySelectorAll<HTMLElement>(".service-rail")) {
    const template = rail.querySelector<HTMLTemplateElement>("[data-woodcut-selection]");
    const list = rail.querySelector<HTMLElement>("[data-part-list]");
    const status = rail.querySelector<HTMLElement>("#selection-status");
    if (!template || !list || !status) continue;
    // Single-part pages have no chooser: keep their empty state beside the
    // summary instead of putting it into the permanently hidden part list.
    const home = rail.querySelector("[data-choose-parts]") ? list
      : rail.querySelector<HTMLElement>("[data-selection-home]");
    if (!home) continue;
    const update = (): void => {
      const selected = list.querySelector('input[name="export-part"]:checked:not(:disabled)');
      const art = home.querySelector("[data-selection-art]");
      if (selected) art?.remove();
      else if (!art) home.append(template.content.cloneNode(true));
    };
    new MutationObserver(update).observe(status, { childList: true, characterData: true, subtree: true });
    update();
  }
</script>
