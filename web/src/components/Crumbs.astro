<!-- Keep each caller's trail and its structured data unchanged. -->
<nav aria-label="Breadcrumb" class="crumb ui"><slot /></nav>

<style>
  .crumb {
    margin: 0 0 var(--s-2);
    font-size: max(1rem, var(--step--1));
    line-height: 1.5;
    color: var(--ink-muted);
    overflow-wrap: anywhere;
    /* When the trail wraps, the row gap keeps one row's tap targets off the next. */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: 0.3em;
    row-gap: max(0rem, calc(var(--tap-min) - 1.5em));
  }
  /* A 44px tap target that overlaps the space around the line instead of
     adding to it, so the music starts higher on a phone. */
  .crumb :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap-min);
    margin-block: calc((1.5em - var(--tap-min)) / 2);
    color: inherit;
  }
</style>
