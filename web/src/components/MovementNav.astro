---
import { borrowedLinks, inPrintedOrder, jumpTargets } from "../lib/catalog";
import { hasNotation } from "../lib/chants";
import type { Piece } from "../lib/catalog";

// Jump links to the headings SystemStack prints above each movement, part and
// hymn. Both come from jumpTargets, so every link has a target. Parts printed
// elsewhere link to the page that prints them.
interface Props { readonly piece: Piece }
const { piece } = Astro.props;
const starts = jumpTargets(piece);
const movements = starts.filter((s) => s.kind === "movement");
const parts = starts.filter((s) => s.kind === "part");
const hymns = starts.filter((s) => s.kind === "hymn");
const borrowed = borrowedLinks(piece).filter((b) => b.href !== null);
const isProper = parts.length > 0 || borrowed.length > 0;
const label = isProper ? "Parts of the Proper" : hymns.length > 0 ? "Hymns" : "Movements";
// The switch appears only where there is notation to show.
const notation = starts.some((s) => hasNotation(s.chantId));
// The sections printed here in the book's order, those printed elsewhere
// slotted in by their place in the Mass.
const properLinks = inPrintedOrder(
  parts.map((s) => ({ order: s.order ?? 0, label: s.label, href: `#${s.anchor}`, borrowed: false,
                      lender: null as string | null, page: 0 })),
  borrowed.map((b) => ({ order: b.order, label: b.label, href: b.href ?? "", borrowed: true,
                         lender: b.lenderTitle, page: b.page })));
---

{(movements.length > 1 || hymns.length > 0 || parts.length + borrowed.length > 1) && (
  <nav class="movements ui no-print" aria-label={label}>
    <span class="small muted">Jump to</span>
    {movements.length > 1 && movements.map((s) => <a href={`#${s.anchor}`}>{s.label}</a>)}
    {properLinks.map((l) => l.borrowed
      ? <a class="borrowed" href={l.href}>{l.label} → {l.lender}, p.&nbsp;{l.page}</a>
      : <a href={l.href}>{l.label}</a>)}
    {hymns.length > 0 && <span class="small muted">Hymns</span>}
    {hymns.map((s) => <a class="hymn" href={`#${s.anchor}`}>{s.label}</a>)}
  </nav>
)}
{notation && (
  <label class="chant-toggle ui small no-print">
    <input type="checkbox" data-chant-toggle />
    Show the chant with each part
  </label>
)}

<style>
  .movements {
    display: flex; flex-wrap: wrap; gap: var(--s-2); align-items: center;
    margin: 0 0 var(--s-4); padding-bottom: var(--s-2);
    border-bottom: 1px solid var(--rule);
  }
  .movements .hymn, .movements .borrowed { font-style: italic; }
  .chant-toggle {
    display: inline-flex; align-items: center; gap: var(--s-2);
    min-height: var(--tap-min); margin: calc(-1 * var(--s-2)) 0 var(--s-3); cursor: pointer;
  }
  .chant-toggle input { width: 1.25rem; height: 1.25rem; margin: 0; }
  .movements a {
    min-height: var(--tap-min);
    display: inline-flex; align-items: center; padding: 0 var(--s-2);
  }
</style>

<script>
  import { initChantNotation } from "../scripts/chantNotation";
  initChantNotation();
</script>
