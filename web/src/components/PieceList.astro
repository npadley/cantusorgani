---
import { pieceHref } from "../lib/indexes";
import type { Piece } from "../lib/catalog";

interface Props {
  readonly pieces: readonly Piece[];
  /** Show the Roman numeral as a leading marker (Ordinaries of the Mass). */
  readonly numbered?: boolean;
}

const { pieces, numbered = false } = Astro.props;

// Secondary line: label and title, minus anything already said. For "Credo I"
// the label, title and name are identical and would otherwise print three times.
function subtitle(p: Piece): string {
  const name = p.incipit ?? p.title;
  const parts = (numbered ? [p.title] : [p.label, p.title])
    .filter((part, i, all) => part && part !== name && all.indexOf(part) === i);
  return parts.join(" · ");
}
---

<ul class="piece-list ui">
  {pieces.map((p) => (
    <li>
      <a href={pieceHref(p)}>
        {numbered && <span class="numeral">{p.label}</span>}
        <span class="titles">
          <span class="name">{p.incipit ?? p.title}</span>
          {subtitle(p) && <span class="sub muted small">{subtitle(p)}</span>}
        </span>
        <span class="pages muted small">pp. {p.printedPages[0]}–{p.printedPages[1]}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .piece-list { list-style: none; margin: 0; padding: 0; }
  li { border-bottom: 1px solid var(--rule); }
  li a {
    display: flex; align-items: baseline; gap: var(--s-3);
    min-height: var(--tap-min); padding: var(--s-2) var(--s-1);
    color: var(--ink); text-decoration: none;
  }
  li a:hover { background: color-mix(in srgb, var(--rule) 20%, transparent); }
  .numeral { min-width: 3.5rem; color: var(--accent); font-size: var(--step-1); }
  .titles { display: flex; flex-direction: column; flex: 1; }
  .name { font-family: var(--font-text); font-size: var(--step-0); }
  .sub { display: block; }
  .pages { white-space: nowrap; }
  @media (max-width: 34rem) { .pages { display: none; } }
</style>
