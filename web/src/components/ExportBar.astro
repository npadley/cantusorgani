---
import { MAX_EXPORT_SYSTEMS } from "../lib/config";
import { systemUrlStem } from "../lib/catalog";
import type { Piece } from "../lib/catalog";

// One piece, or several in order -- a day's Proper followed by its Ordinary.
interface Props { readonly pieces: readonly Piece[]; readonly title: string }
const { pieces, title } = Astro.props;

const count = pieces.reduce((n, p) => n + p.systems.length, 0);
// Rough page estimate so the button can say what you are about to get. Systems
// average a little under a quarter of an A4 page at export width.
const estimatedPages = Math.max(1, Math.ceil(count / 4.5));
const overCap = count > MAX_EXPORT_SYSTEMS;
// Full URL stems: the export worker cannot derive content-hashed keys either.
const stems = pieces.flatMap((piece) => piece.systems.map((_, i) => systemUrlStem(piece, i)));
---

{count > 0 && (
  <div class="export no-print ui" data-refs={stems.join(",")}
       data-title={`${title} — Nova Organi Harmonia`}>
    <button id="export-btn" type="button" disabled={overCap}>
      {overCap
        ? `Too many systems to export (${count})`
        : `Export PDF (${count} system${count === 1 ? "" : "s"}, ~${estimatedPages} page${estimatedPages === 1 ? "" : "s"})`}
    </button>

    <progress id="export-progress" max={count} value="0" hidden></progress>
    <p id="export-status" class="small" role="status" aria-live="polite"></p>

    {overCap && (
      <p class="small muted">
        Export is limited to {MAX_EXPORT_SYSTEMS} systems so it can be built on a
        tablet. Use the individual movement pages instead.
      </p>
    )}
  </div>
)}

<style>
  .export {
    display: flex; flex-direction: column; gap: var(--s-2);
    align-items: flex-start;
    margin: var(--s-4) 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  progress { width: min(100%, 22rem); height: 0.5rem; }
  #export-status { margin: 0; min-height: 1.4em; }
  #export-status[data-state="error"] { color: var(--warn-ink); }

  /* Reachable one-handed on a console-mounted tablet. */
  @media (max-width: 62rem) {
    .export {
      position: sticky; bottom: 0; z-index: 5;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      padding: var(--s-2) 0;
      margin-bottom: 0;
    }
  }
</style>

<script>
  import type { BuildRequest, BuildResponse } from "../workers/pdf.worker";

  const root = document.querySelector<HTMLElement>(".export");
  const button = document.getElementById("export-btn") as HTMLButtonElement | null;
  const status = document.getElementById("export-status");
  const progress = document.getElementById("export-progress") as HTMLProgressElement | null;

  if (root && button && status && progress) {
    const refs = (root.dataset["refs"] ?? "").split(",").filter(Boolean);
    const title = root.dataset["title"] ?? "Nova Organi Harmonia";
    const idleLabel = button.textContent ?? "Export PDF";

    button.addEventListener("click", () => {
      button.disabled = true;
      status.removeAttribute("data-state");
      status.textContent = "Preparing…";
      progress.value = 0;
      progress.hidden = false;
      root.setAttribute("aria-busy", "true");

      const worker = new Worker(
        new URL("../workers/pdf.worker.ts", import.meta.url),
        { type: "module" },
      );

      worker.onmessage = (event: MessageEvent<BuildResponse>) => {
        const message = event.data;
        if (message.kind === "progress") {
          progress.value = message.done;
          status.textContent = `Building PDF — system ${message.done} of ${message.total}`;
          return;
        }

        root.removeAttribute("aria-busy");
        progress.hidden = true;
        button.disabled = false;
        button.textContent = idleLabel;

        if (message.kind === "error") {
          status.setAttribute("data-state", "error");
          status.textContent = message.message;
          worker.terminate();
          return;
        }

        const bytes = new Uint8Array(message.bytes);
        const blob = new Blob([bytes.buffer as ArrayBuffer], { type: "application/pdf" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `${title.replace(/[^\w\- ]+/g, "").trim() || "export"}.pdf`;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        const size = (blob.size / 1_048_576).toFixed(1);
        status.textContent =
          `PDF ready — ${refs.length} systems, ${message.pages} pages, ${size} MB.`;
        worker.terminate();
      };

      const request: BuildRequest = { refs, base: "", title };
      worker.postMessage(request);
    });
  }
</script>
