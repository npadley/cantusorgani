---
import DisclosureCue from "./DisclosureCue.astro";
import ExportLayoutEditor from "./ExportLayoutEditor.astro";
import { approvedConversionFor, loadManifest } from "../lib/mei";
import { defaultTicked, defaultsNote, exportSegments, seasonGroup } from "../lib/exportParts";
import { pieceBySlug } from "../lib/catalog";
import type { Piece } from "../lib/catalog";
import { exportRuns } from "../lib/typeset";
import type { ExportRun } from "../lib/typeset";
import type { ExportSegment } from "../lib/exportParts";
import type { Season } from "../lib/liturgy";
import { estimatePages, validateSelection } from "../lib/pdf";

// One piece, or several in order -- a day's Proper followed by its Ordinary --
// divided into the parts the organist can tick. On a day page the defaults
// follow the season of the date shown (no Tract in October); on a piece page
// everything is ticked.
interface Props {
  readonly pieces: readonly Piece[];
  readonly title: string;
  readonly season?: Season | null;
  /** "Saturday, 3 October 2026": the date the defaults were chosen for. */
  readonly dateLabel?: string | null;
  /** Segments built elsewhere (a Vespers lineup, in sung order) instead of `pieces`'. */
  readonly segments?: readonly ExportSegment[];
}
const { pieces, title, season = null, dateLabel = null } = Astro.props;

const segments = Astro.props.segments ?? exportSegments(pieces);
const group = seasonGroup(season);
const ticked = segments.filter((s) => defaultTicked(s, segments, group));
const count = ticked.reduce((n, s) => n + s.systems, 0);
const refusal = segments.length > 0 ? validateSelection(count, ticked.map((s) => ({ label: s.label, systems: s.systems }))) : null;
const note = defaultsNote(segments, group, dateLabel);
// Which of each part's systems are typeset: those go into the PDF as the
// typeset music's own pages, unless the reader has switched them to the scans.
const runsOf = (s: ExportSegment): readonly ExportRun[] => {
  const piece = s.source ? pieceBySlug(s.source.slug) : undefined;
  return piece && s.source ? exportRuns(piece, s.source.start, s.source.end)
    : [{ count: s.systems, key: null, label: null, letter: null, a4: null, target: null, hash: null }];
};
// "Customize export" is offered only where a part on the page has an approved conversion (decision D5):
// anywhere else the editor would be a more elaborate paper picker for scans.
const manifest = loadManifest();
const customizable = segments.some((s) => runsOf(s).some((r) =>
  r.target !== null && r.hash !== null && approvedConversionFor(r.target, r.hash, manifest) !== null));
const label = (n: number) => `Export PDF (${n} system${n === 1 ? "" : "s"}, ~${estimatePages(n)} page${estimatePages(n) === 1 ? "" : "s"})`;
---

{segments.length > 0 && (
  <div class="export no-print ui" data-title={`${title} — Nova Organi Harmonia`}>
    <details class="parts" hidden={segments.length === 1}>
      <summary class="disclosure-summary"><DisclosureCue />Choose parts (<span data-ticked>{ticked.length}</span>{" "}of {segments.length})</summary>
      <fieldset>
        <legend>Parts to export</legend>
        {segments.map((s) => (
          <label class="part">
            <input type="checkbox" name="export-part" value={s.id}
                   checked={defaultTicked(s, segments, group)}
                   data-stems={s.stems.join(",")} data-systems={s.systems} data-label={s.label}
                   data-rubric={s.rubric} data-rubric-translation={s.rubricTranslation}
                   data-runs={JSON.stringify(runsOf(s))} />
            <span>{s.label}</span>
            <span class="muted small">{s.systems}</span>
          </label>
        ))}
      </fieldset>
    </details>
    {note && <p class="small muted note">{note}</p>}

    <div class="go">
      <button id="export-btn" type="button" disabled={refusal !== null}>
        {refusal !== null && count === 0 ? "Tick at least one part" : label(count)}
      </button>
      {customizable && <button id="export-customize" type="button" disabled={refusal !== null}>Customize export</button>}
      <label class="small paper">Paper
        <select id="export-paper">
          <option value="letter">Letter (8½ × 11)</option>
          <option value="a4">A4</option>
        </select>
      </label>
    </div>

    <progress id="export-progress" max={count} value="0" hidden></progress>
    <p id="export-status" class="small" role="status" aria-live="polite">{refusal ?? ""}</p>
  </div>
)}
{segments.length > 0 && customizable && <ExportLayoutEditor />}

<style>
  .export {
    display: flex; flex-direction: column; gap: var(--s-2);
    align-items: flex-start;
    margin: var(--s-4) 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  progress { width: min(100%, 22rem); height: 0.5rem; }
  #export-status { margin: 0; min-height: 1.4em; }
  .note { margin: 0; }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .paper { display: flex; align-items: center; gap: var(--s-1); min-height: var(--tap-min); }
  .paper select { min-height: var(--tap-min); }
  .parts summary { min-height: var(--tap-min); display: flex; align-items: center; cursor: pointer; }
  .parts fieldset { border: 1px solid var(--rule); margin: var(--s-1) 0 0; padding: var(--s-1) var(--s-2); }
  .parts legend { font-size: var(--step--1); color: var(--ink-muted); padding: 0 var(--s-1); }
  .part {
    display: flex; align-items: center; gap: var(--s-2);
    min-height: var(--tap-min); cursor: pointer;
  }
  .part input { width: 1.25rem; height: 1.25rem; margin: 0; }
  #export-status[data-state="error"] { color: var(--warn-ink); }

  /* Reachable one-handed on a console-mounted tablet. */
  @media (max-width: 62rem) {
    .export {
      position: sticky; bottom: 0; z-index: 5;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      padding: var(--s-2) 0;
      margin-bottom: 0;
    }
  }
</style>

<script>
  import type { BuildRequest, BuildResponse } from "../workers/pdf.worker";
  import { estimatePages, validateSelection } from "../lib/pdf";
  import type { Paper, TypesetInsert } from "../lib/pdf";
  import { readSelectionInput } from "../lib/exportSelection";
  import { trackExport } from "../lib/exportAnalytics";

  const root = document.querySelector<HTMLElement>(".export");
  const button = document.getElementById("export-btn") as HTMLButtonElement | null;
  const status = document.getElementById("export-status");
  const progress = document.getElementById("export-progress") as HTMLProgressElement | null;
  const tickedCount = root?.querySelector<HTMLElement>("[data-ticked]") ?? null;
  const paperSelect = document.getElementById("export-paper") as HTMLSelectElement | null;
  const customize = document.getElementById("export-customize") as HTMLButtonElement | null;
  const PAPER_KEY = "export-paper";

  // The paper size is remembered in this browser; Letter until chosen.
  if (paperSelect) {
    try {
      const saved = localStorage.getItem(PAPER_KEY);
      if (saved === "letter" || saved === "a4") paperSelect.value = saved;
    } catch { /* storage blocked: Letter */ }
    paperSelect.addEventListener("change", () => {
      try { localStorage.setItem(PAPER_KEY, paperSelect.value); } catch { /* not remembered */ }
    });
  }

  // Whether the reader sees the scans for a typeset segment: the page-wide
  // switch or the part's own, or the typeset music failed to load. The export
  // follows what they see.
  function showsScans(key: string): boolean {
    const seg = document.querySelector<HTMLElement>(`[data-typeset-key="${CSS.escape(key)}"]`);
    if (seg?.dataset["state"] === "error") return true;
    if (seg?.dataset["show"] === "scan") return true;
    if (seg?.dataset["show"] === "typeset") return false;
    return document.documentElement.getAttribute("data-view") === "scans";
  }

  if (root && button && status && progress) {
    const title = root.dataset["title"] ?? "Nova Organi Harmonia";
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[name="export-part"]')];

    // The ticked parts, in page order, with where each starts in the export.
    function selection() {
      const refs: string[] = [];
      const headings: import("../lib/pdf").PdfHeading[] = [];
      const parts: { label: string; systems: number }[] = [];
      const typeset: TypesetInsert[] = [];
      const paper: Paper = paperSelect?.value === "a4" ? "a4" : "letter";
      const ticked = readSelectionInput(boxes, title, showsScans).segments;
      for (const { stems, label, rubric, rubricTranslation, runs } of ticked) {
        const start = refs.length;
        if (ticked.length > 1 || rubric || rubricTranslation) headings.push({ index: start, label,
          ...(rubric ? { rubric } : {}), ...(rubricTranslation ? { rubricTranslation } : {}) });
        // The runs cover the part's systems in order; if they do not add up,
        // the part goes in as scans.
        if (runs.reduce((n, r) => n + r.count, 0) === stems.length) {
          let at = start;
          for (const run of runs) {
            const pdf = run[paper];
            if (runs.length > 1 && run.label && at !== start) headings.push({ index: at, label: run.label });
            if (pdf && run.key && !run.showsScans) {
              typeset.push({ index: at, count: run.count, pdf, label: run.label ?? label });
            }
            at += run.count;
          }
        }
        refs.push(...stems);
        parts.push({ label, systems: stems.length });
      }
      return { refs, headings, parts, typeset, paper, ticked: ticked.length };
    }

    function refresh(): void {
      const { refs, parts, ticked } = selection();
      if (tickedCount) tickedCount.textContent = String(ticked);
      const problem = validateSelection(refs.length, parts);
      button!.disabled = problem !== null;
      if (customize) customize.disabled = problem !== null;
      button!.textContent = refs.length === 0
        ? "Tick at least one part"
        : `Export PDF (${refs.length} system${refs.length === 1 ? "" : "s"}, ~${estimatePages(refs.length)} page${estimatePages(refs.length) === 1 ? "" : "s"})`;
      status!.removeAttribute("data-state");
      status!.textContent = problem ?? "";
    }
    boxes.forEach((b) => b.addEventListener("change", refresh));

    // The editor adds #customize-export while open. A stale one in a loaded URL is stripped, and never opens it.
    if (location.hash === "#customize-export") history.replaceState(history.state, "", location.pathname + location.search);

    // Everything the editor needs (the dialog code, the manifest, the selection snapshot) is imported on click:
    // until then this page loads no Verovio, workers, pdf.js or export fonts.
    customize?.addEventListener("click", async () => {
      if (customize.getAttribute("aria-busy") === "true") return;
      const idle = customize.textContent ?? "Customize export";
      customize.setAttribute("aria-busy", "true");
      customize.textContent = "Opening…";
      try {
        const [editor, mei, snapshot] = await Promise.all([
          import("../scripts/exportLayout"), import("../lib/mei"), import("../lib/export-layout/selection"),
        ]);
        await editor.stylesReady;
        const manifest = mei.loadManifest();
        const parts = snapshot.snapshotSelection(readSelectionInput(boxes, title, showsScans),
          (target, hash) => mei.approvedConversionFor(target, hash, manifest));
        editor.openExportEditor({
          parts,
          title: title.replace(/ — Nova Organi Harmonia$/, ""),
          opener: customize,
          onExported: (s) => trackExport("custom", {
            page: s.page, orientation: s.orientation, staff: s.staff,
            maxSystems: s.maxSystems === null ? "auto" : String(s.maxSystems), linePolicy: s.linePolicy,
          }),
        });
      } catch {
        status.setAttribute("data-state", "error");
        status.textContent = "Can't open the layout editor. Try again, or use Export PDF.";
      } finally {
        customize.removeAttribute("aria-busy");
        customize.textContent = idle;
      }
    });

    button.addEventListener("click", () => {
      const { refs, headings, typeset, paper } = selection();
      if (validateSelection(refs.length) !== null) return;
      const idleLabel = button.textContent ?? "Export PDF";
      button.disabled = true;
      status.removeAttribute("data-state");
      status.textContent = "Preparing…";
      progress.max = refs.length;
      progress.value = 0;
      progress.hidden = false;
      root.setAttribute("aria-busy", "true");

      const worker = new Worker(
        new URL("../workers/pdf.worker.ts", import.meta.url),
        { type: "module" },
      );

      worker.onmessage = (event: MessageEvent<BuildResponse>) => {
        const message = event.data;
        if (message.kind === "progress") {
          progress.value = message.done;
          status.textContent = `Building PDF — system ${message.done} of ${message.total}`;
          return;
        }

        root.removeAttribute("aria-busy");
        progress.hidden = true;
        button.disabled = false;
        button.textContent = idleLabel;

        if (message.kind === "error") {
          status.setAttribute("data-state", "error");
          status.textContent = message.message;
          worker.terminate();
          return;
        }

        const bytes = new Uint8Array(message.bytes);
        const blob = new Blob([bytes.buffer as ArrayBuffer], { type: "application/pdf" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `${title.replace(/[^\w\- ]+/g, "").trim() || "export"}.pdf`;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        const size = (blob.size / 1_048_576).toFixed(1);
        const missed = message.fallbacks.length > 0
          ? ` The typeset music for ${message.fallbacks.join(", ")} could not be fetched, so its scans are in the PDF.`
          : "";
        status.textContent = `PDF ready — ${refs.length} systems, ${message.pages} pages, ${size} MB.${missed}`;
        worker.terminate();
      };

      const request: BuildRequest = { refs, base: "", title, headings, paper, typeset };
      worker.postMessage(request);
      trackExport("quick", { paper });
    });
  }
</script>
