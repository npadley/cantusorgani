---
import { dateLabel as serviceDateLabel, formatDefaultsNote, resolveDate, serviceSummary } from "../lib/dayService";
import type { DayTable } from "../lib/dayService";
import DisclosureCue from "./DisclosureCue.astro";
import ExportLayoutEditor from "./ExportLayoutEditor.astro";
import { buildDayDefaults, defaultsNote, exportSegments, seasonGroup } from "../lib/exportParts";
import { defaultIncluded, selectionFromBoxes } from "../lib/selection";
import { pieceBySlug } from "../lib/catalog";
import type { Piece } from "../lib/catalog";
import { exportRuns } from "../lib/typeset";
import { segmentChants } from "../lib/exportChants";
import type { ExportRun } from "../lib/typeset";
import type { ExportSegment } from "../lib/exportParts";
import type { Season } from "../lib/liturgy";
import { estimatePages, validateSelection } from "../lib/pdf";

// One piece, or several in order -- a day's Proper followed by its Ordinary --
// divided into the parts the organist can tick. On a day page the defaults
// follow the season of the date shown (no Tract in October); on a piece page
// everything is ticked.
interface Props {
  readonly dayService?: { table: DayTable; buildDefaultIso: string | null; title: string; unavailable: readonly string[] };
  readonly variant?: "default" | "rail";
  readonly pieces: readonly Piece[];
  readonly title: string;
  readonly season?: Season | null;
  /** "Saturday, 3 October 2026": the date the defaults were chosen for. */
  readonly dateLabel?: string | null;
  /** Segments built elsewhere (a Vespers lineup, in sung order) instead of `pieces`'. */
  readonly segments?: readonly ExportSegment[];
}
const { pieces, title, season = null, dateLabel = null } = Astro.props;

const rail = Astro.props.variant === "rail";
const PartsTag = rail ? "div" : "details";
const segments = Astro.props.segments ?? exportSegments(pieces);
const dayService = Astro.props.dayService ? { ...Astro.props.dayService,
  defaults: buildDayDefaults(Astro.props.dayService.table, segments),
} : null;
const service = dayService ? resolveDate(null, dayService.table, dayService.buildDefaultIso) : null;
const activeSegments = segments.filter(s => !s.ordinaryOption || s.ordinaryOption === service?.option?.key);
const group = service?.group ?? seasonGroup(season);
const datedDefaults = dayService?.defaults.find(d => d.option === service?.option?.key && d.group === group);
const included = datedDefaults ? new Set(datedDefaults.included) : defaultIncluded(activeSegments, group);
const ticked = segments.filter((s) => included.has(s.id));
const count = ticked.reduce((n, s) => n + s.systems, 0);
const refusal = segments.length > 0 ? validateSelection(count, ticked.map((s) => ({ label: s.label, systems: s.systems }))) : null;
const note = service?.iso ? formatDefaultsNote(datedDefaults?.unticked ?? [], serviceDateLabel(service.iso))
  : defaultsNote(activeSegments, group, dateLabel);
// Which of each part's systems are typeset: those go into the PDF as the
// typeset music's own pages, unless the reader has switched them to the scans.
const runsOf = (s: ExportSegment): readonly ExportRun[] => {
  const piece = s.source ? pieceBySlug(s.source.slug) : undefined;
  return piece && s.source ? exportRuns(piece, s.source.start, s.source.end)
    : [{ count: s.systems, key: null, label: null, letter: null, a4: null, target: null, hash: null }];
};
const chantsOf = (s: ExportSegment) => {
  const piece = s.source ? pieceBySlug(s.source.slug) : undefined;
  return piece && s.source ? segmentChants(piece, s.source.start, s.source.end) : [];
};
const initialSelection = rail ? selectionFromBoxes(segments.map(s => ({ value: s.id, checked: included.has(s.id),
  dataset: { stems: s.stems.join(","), label: s.label, runs: JSON.stringify(runsOf(s)) },
})), title, () => false) : null;
const capability = (index: number) => {
  const runs = initialSelection?.segments[index]?.runs ?? [];
  return [...new Set(runs.map(r => r.representation === "scan" || r.capability === "scan" ? "Scans"
    : r.capability === "mei" ? "Customizable typeset" : "Typeset"))].join(" · ");
};
const daySummary = service && dayService ? serviceSummary(service,
  ticked.filter(s => ["gradual", "tract", "alleluia"].includes(s.part ?? "")).map(s => s.label),
  dayService.unavailable) : "";
const label = (n: number) => `Export PDF (${n} system${n === 1 ? "" : "s"}, ~${estimatePages(n)} page${estimatePages(n) === 1 ? "" : "s"})`;
---

{segments.length > 0 && (
  <div class:list={["export no-print ui", { "export--rail": rail }]} data-day-service={dayService ? JSON.stringify(dayService) : undefined} data-rail={rail || undefined} data-title={`${title} — Nova Organi Harmonia`}>
    {rail && segments.length > 1 && <button type="button" data-choose-parts aria-haspopup="dialog" aria-expanded="false" aria-controls="choose-parts-sheet" hidden>Choose parts (<span data-ticked>{ticked.length}</span> of <span data-total-parts>{activeSegments.length}</span>)</button>}
    <PartsTag class="parts" data-part-list={rail || undefined} hidden={rail || segments.length === 1}>
      {!rail && <summary class="disclosure-summary"><DisclosureCue />Choose parts (<span data-ticked>{ticked.length}</span>{" "}of <span data-total-parts>{activeSegments.length}</span>)</summary>}
      {rail && <p class="rail-choice-title">Choose parts (<span data-ticked>{ticked.length}</span> of <span data-total-parts>{activeSegments.length}</span>)</p>}
      <fieldset>
        <legend>Parts to export</legend>
        {rail && <div class="select-actions"><button type="button" data-select-all>Select all</button><button type="button" data-clear>Clear</button></div>}
        {segments.map((s, index) => (
          <label class="part" hidden={!!s.ordinaryOption && s.ordinaryOption !== service?.option?.key} data-ordinary-option={s.ordinaryOption}>
            <input type="checkbox" name="export-part" value={s.id} aria-labelledby={rail ? `part-name-${index}` : undefined} aria-describedby={rail ? `part-detail-${index}` : undefined}
                   checked={included.has(s.id)} disabled={!!s.ordinaryOption && s.ordinaryOption !== service?.option?.key}
                   data-ordinary-option={s.ordinaryOption} data-part={s.part} data-variant={s.variant}
                   data-stems={s.stems.join(",")} data-systems={s.systems} data-label={s.label}
                   data-years={s.years?.join(",")} data-seasons={s.seasons?.join(",")}
                   data-rubric={s.rubric} data-rubric-translation={s.rubricTranslation}
                   data-runs={JSON.stringify(runsOf(s))}
                   data-chants={JSON.stringify(chantsOf(s))} />
            <span>{rail ? <span id={`part-name-${index}`}><span class="sr-only">In PDF: </span>{s.label}</span> : s.label}{rail && <><br /><span class="muted small" id={`part-detail-${index}`}>{s.systems} system{s.systems === 1 ? "" : "s"} · <span data-capability={s.id}>{capability(index)}</span> · {initialSelection?.segments[index]?.setting.id === "noh" ? "NOH" : ""}</span></>}</span>
            {!rail && <span class="muted small">{s.systems}</span>}
          </label>
        ))}
      </fieldset>
    </PartsTag>
    {rail && <>
      <details class="reader-tools"><summary><DisclosureCue />Reading controls</summary><slot name="reader-tools" /></details>
      <div data-selection-home><p id="selection-status" class="small">{ticked.length} of <span data-total-parts>{activeSegments.length}</span> parts, {count} systems{refusal ? `. ${refusal}` : ""}</p></div>
      <dialog id="choose-parts-sheet" aria-labelledby="choose-parts-title">
        <header class="sheet-heading"><h2 id="choose-parts-title">Choose parts</h2><button type="button" data-parts-done>Done</button></header>
        <div data-sheet-list></div>
      </dialog>
      <noscript><p class="small">Export needs JavaScript.</p></noscript>
    </>}
    {(note || dayService) && <p class="small muted note" data-defaults-note hidden={!note}>{note}</p>}
    {dayService && <>
      <p class="small muted note" data-day-summary>{daySummary}</p>
      <p class="small note" data-day-message hidden></p>
    </>}

    <div class="go" hidden={rail}>
      <button id="export-btn" type="button" disabled={refusal !== null}>
        {refusal !== null && count === 0 ? "Tick at least one part" : label(count)}
      </button>
      <button type="button" data-return-customize hidden>Return to Customize</button>
      <button id="export-customize" type="button" disabled={refusal !== null}>Customize export</button>
      <label class="small paper">Paper
        <select id="export-paper">
          <option value="letter">Letter (8½ × 11)</option>
          <option value="a4">A4</option>
        </select>
      </label>
      {rail && <p class="small muted note export-foot-note">Accompaniment only — Customize for chant and page layout</p>}
    </div>

    <progress id="export-progress" max={count} value="0" hidden></progress>
    <p id="export-status" class:list={["small", { "sr-only": rail }]} role="status" aria-live="polite">{rail ? "" : refusal ?? ""}</p>
  </div>
)}
{/* On every page with an export bar (D23): parts with an approved conversion reflow, the rest are placed as they are. */}
{segments.length > 0 && <ExportLayoutEditor />}

<style>
  [hidden] { display: none !important; }
  .export {
    display: flex; flex-direction: column; gap: var(--s-2);
    align-items: flex-start;
    margin: var(--s-4) 0;
    padding-top: var(--s-3);
    border-top: 1px solid var(--rule);
  }
  progress { width: min(100%, 22rem); height: 0.5rem; }
  #export-status { margin: 0; min-height: 1.4em; }
  .note { margin: 0; }
  [data-day-summary], [data-day-message], [data-defaults-note] { grid-column: 1 / -1; }
  .export-foot-note { flex-basis: 100%; }
  .go { display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-2); }
  .paper { display: flex; align-items: center; gap: var(--s-1); min-height: var(--tap-min); }
  .paper select { min-height: var(--tap-min); }
  .parts summary { min-height: var(--tap-min); display: flex; align-items: center; cursor: pointer; }
  .parts fieldset { border: 1px solid var(--rule); margin: var(--s-1) 0 0; padding: var(--s-1) var(--s-2); }
  .parts legend { font-size: var(--step--1); color: var(--ink-muted); padding: 0 var(--s-1); }
  .part {
    display: flex; align-items: center; gap: var(--s-2);
    min-height: var(--tap-min); cursor: pointer;
  }
  .part input { width: 1.25rem; height: 1.25rem; margin: 0; }
  #export-status[data-state="error"] { color: var(--warn-ink); }

  .export--rail { margin: 0; padding: 0; border: 0; align-items: stretch; }
  .rail-choice-title { margin: 0 0 var(--s-2); font-weight: 600; }
  .export--rail .parts fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  .export--rail .part { padding: var(--s-2) 0; border-bottom: 1px solid var(--rule); }
  .export--rail .part input { flex-shrink: 0; }
  .export--rail .go { border-top: 1px solid var(--rule); padding-top: var(--s-2); }
  .select-actions { display: flex; flex-wrap: wrap; gap: var(--s-2); }
  .reader-tools summary { display: flex; align-items: center; min-height: var(--tap-min); cursor: pointer; }
  .reader-tools { border-top: 1px solid var(--rule); padding-top: var(--s-2); }
  #selection-status { margin: 0; }
  #choose-parts-sheet { inset: auto 0 0; width: 100%; max-width: none; max-height: 85dvh; margin: 0; padding: var(--s-3); overflow: auto; scroll-padding: var(--s-3); border: 1px solid var(--control-border); border-radius: var(--radius); background: var(--paper); color: var(--ink); }
  .sheet-heading { display: flex; justify-content: space-between; align-items: center; gap: var(--s-2); }
  .sheet-heading h2 { margin: 0; font-size: var(--step-1); }
  :global(html:has(#choose-parts-sheet[open])) { overflow: hidden; }
  @media (min-width: 62rem) {
    .export--rail [data-choose-parts] { display: none; }
    .export--rail .go { flex-direction: column; align-items: stretch; }
    .export--rail .export-foot-note { order: 1; }
    .export--rail [data-return-customize] { order: 2; }
    .export--rail #export-customize { order: 3; }
    .export--rail .paper { order: 4; }
  }
  @media (width < 62rem) {
    .export--rail > .parts, .rail-choice-title { display: none; }
    .export--rail { position: static; }
  }

  @media screen and (width < 62rem) {
    /* Three controls across, two export actions below, then the complete note.
       Let labels wrap rather than shrinking the targets or truncating copy. */
    .export--rail {
      display: grid; grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: var(--s-1); font-size: var(--step--1); line-height: 1.2;
    }
    .export--rail [data-choose-parts] { grid-column: 1 / 3; padding: 0 var(--s-1); }
    .export--rail .reader-tools { grid-column: 3 / 5; grid-row: 1; border: 0; padding: 0; min-width: 0; }
    .export--rail:not(:has([data-choose-parts])) .reader-tools { grid-column: 1 / 5; }
    .export--rail .reader-tools[open] { grid-column: 1 / -1; grid-row: auto; }
    .export--rail .go { display: contents; }
    .export--rail .paper { grid-column: 5 / 7; grid-row: 1; min-width: 0; }
    .export--rail .paper select { width: 100%; min-width: 0; font: inherit; }
    .export--rail #export-btn { grid-column: 1 / 4; padding: 0 var(--s-1); }
    .export--rail #export-customize { grid-column: 4 / 7; padding: 0 var(--s-1); }
    .export--rail .export-foot-note { grid-column: 1 / -1; margin: 0; line-height: 1.15; }
    .export--rail > :is(.note, noscript, progress, #export-status, [data-selection-home]),
    .export--rail [data-return-customize] { grid-column: 1 / -1; }
    /* Keep refusals visible, including while the live region reports progress.
       Inside the modal, the same count remains plain visible text. */
    .export--rail:not(:has(#export-customize:disabled)) [data-selection-home] {
      position: absolute; inline-size: var(--s-1); block-size: var(--s-1);
      overflow: hidden; clip-path: inset(50%); white-space: nowrap;
    }
  }

  /* Reachable one-handed on a console-mounted tablet. */
  @media (max-width: 62rem) {
    :global(html:has(.export)) {
      /* Leave room for the bar, including controls wrapping on narrow screens. */
      scroll-padding-bottom: 8rem;
    }
    .export:not(.export--rail) {
      position: sticky; bottom: 0; z-index: 5;
      background: var(--paper);
      border-top: 1px solid var(--rule);
      padding: var(--s-2) 0;
      margin-bottom: 0;
    }
  }
</style>

<script>
  import { dateLabel as serviceDateLabel, formatDefaultsNote, pdfTitle, resolveDate, serviceSummary } from "../lib/dayService";
  import type { DayDefaults, DayTable } from "../lib/dayService";
  import type { BuildRequest, BuildResponse } from "../workers/pdf.worker";
  import { estimatePages, validateSelection } from "../lib/pdf";
  import type { Paper } from "../lib/pdf";
  import { quickRequest, readQuickPaper, selectionFromBoxes } from "../lib/selection";
  import type { Selection } from "../lib/selection";
  import { trackExport } from "../lib/exportAnalytics";
  import { scrollToClearBar } from "../lib/focusClearance";

  const root = document.querySelector<HTMLElement>(".export");
  const button = document.getElementById("export-btn") as HTMLButtonElement | null;
  const status = document.getElementById("export-status");
  const progress = document.getElementById("export-progress") as HTMLProgressElement | null;
  const tickedCount = root?.querySelector<HTMLElement>("[data-ticked]") ?? null;
  const paperSelect = document.getElementById("export-paper") as HTMLSelectElement | null;
  const customize = document.getElementById("export-customize") as HTMLButtonElement | null;
  const PAPER_KEY = "export-paper";

  // A bar pinned to the bottom must not hide the focused element (WCAG 2.4.11).
  if (root) {
    document.addEventListener("focusin", (event) => {
      const target = event.target;
      if (!(target instanceof HTMLElement) || root.contains(target)) return;
      if (getComputedStyle(root.closest(".service-rail") ?? root).position !== "sticky") return;
      const bar = (root.closest(".service-rail") ?? root).getBoundingClientRect();
      if (Math.abs(bar.bottom - window.innerHeight) > 1) return;
      const by = scrollToClearBar(target.getBoundingClientRect(), bar);
      if (by > 0) window.scrollBy(0, by);
    });
  }

  // The paper size is remembered in this browser; Letter until chosen.
  if (paperSelect) {
    try {
      paperSelect.value = readQuickPaper(localStorage);
    } catch { /* storage blocked: Letter */ }
    paperSelect.addEventListener("change", () => {
      try { localStorage.setItem(PAPER_KEY, paperSelect.value); } catch { /* not remembered */ }
    });
  }

  // Whether the reader sees the scans for a typeset segment: the page-wide
  // switch or the part's own, or the typeset music failed to load. The export
  // follows what they see.
  function showsScans(key: string): boolean {
    const copies = [...document.querySelectorAll<HTMLElement>(`[data-typeset-key="${CSS.escape(key)}"]`)];
    if (copies.some((seg) => seg.dataset["state"] === "error" || seg.dataset["show"] === "scan")) return true;
    if (copies.length > 0 && copies.every((seg) => seg.dataset["show"] === "typeset")) return false;
    return document.documentElement.getAttribute("data-view") === "scans";
  }

  if (root && button && status && progress) {
    let title = root.dataset["title"] ?? "Nova Organi Harmonia";
    const day = root.dataset["dayService"] ? JSON.parse(root.dataset["dayService"]) as {
      table: DayTable; defaults: DayDefaults[]; buildDefaultIso: string | null; title: string; unavailable: string[];
    } : null;
    const service = day ? resolveDate(new URLSearchParams(location.search).get("date"), day.table, day.buildDefaultIso) : null;
    if (day && service) {
      title = `${pdfTitle(day.title, service.option?.mass ?? null, service.iso)} — Nova Organi Harmonia`;
      root.dataset["title"] = title;
      document.querySelectorAll<HTMLElement>("[data-ordinary-option]").forEach(node => {
        const active = node.dataset["ordinaryOption"] === service.option?.key;
        if (node instanceof HTMLInputElement) { node.disabled = !active; if (!active) node.checked = false; }
        else node.hidden = !active;
      });
      const message = root.querySelector<HTMLElement>("[data-day-message]")!;
      message.textContent = service.message;
      message.hidden = !service.message;
      document.querySelectorAll<HTMLElement>("[data-service-date]").forEach(node => { node.textContent = service.iso ? serviceDateLabel(service.iso) : "build default"; });
    }
    const rail = root.hasAttribute("data-rail");
    let suspended = false;
    let editorHandle: import("../scripts/exportLayout").EditorHandle | null = null;
    const returnButton = root.querySelector<HTMLButtonElement>("[data-return-customize]");
    returnButton?.addEventListener("click", () => editorHandle?.resume());
    if (rail) {
      root.querySelector<HTMLElement>(".go")!.hidden = false;
      const list = root.querySelector<HTMLElement>("[data-part-list]")!;
      const multiple = list.querySelectorAll('input[name="export-part"]').length > 1;
      list.hidden = !multiple;
      const opener = root.querySelector<HTMLButtonElement>("[data-choose-parts]");
      if (opener) opener.hidden = false;
      const wide = matchMedia("(min-width: 62rem)");
      root.querySelectorAll<HTMLElement>("[data-rail-tool]").forEach(tool => { tool.hidden = false; });
      const tools = root.querySelector<HTMLDetailsElement>(".reader-tools")!;
      tools.open = wide.matches;
      const sheet = root.querySelector<HTMLDialogElement>("#choose-parts-sheet")!;
      const home = list.parentElement!;
      const next = list.nextSibling;
      const selectionHome = root.querySelector<HTMLElement>("[data-selection-home]")!;
      const selectionStatus = document.getElementById("selection-status")!;
      const statusHome = status.parentElement!;
      let restoreTo: HTMLElement | null = null;
      let lastBox: HTMLInputElement | null = null;
      sheet.addEventListener("focusin", event => {
        if (event.target instanceof HTMLInputElement && event.target.name === "export-part") lastBox = event.target;
      });
      let closingSelector = false;
      sheet.addEventListener("close", () => {
        opener?.setAttribute("aria-expanded", "false");
        home.insertBefore(list, next);
        selectionHome.append(selectionStatus);
        statusHome.append(status);
        restoreTo?.focus({ preventScroll: true });
        restoreTo = null;
        if (suspended && !closingSelector) document.dispatchEvent(new Event("cx-selector-closed"));
        closingSelector = false;
      });
      function openSheet(): void {
        if (sheet.open) return;
        list.hidden = false;
        restoreTo = suspended ? returnButton : opener;
        lastBox = list.querySelector<HTMLInputElement>('input[name="export-part"]:not(:disabled)');
        sheet.querySelector("[data-sheet-list]")!.append(list, selectionStatus, status!);
        sheet.showModal();
        opener?.setAttribute("aria-expanded", "true");
        lastBox?.focus({ preventScroll: true });
      }
      opener?.addEventListener("click", () => {
        if (suspended) document.dispatchEvent(new Event("cx-selector-open"));
        openSheet();
      });
      root.addEventListener("cx-choose-parts", event => {
        suspended = true;
        if (returnButton) returnButton.hidden = false;
        selectionStatus.textContent = (event as CustomEvent<string>).detail;
        status.classList.add("sr-only");
        if (wide.matches) {
          list.hidden = false;
          list.querySelector<HTMLInputElement>('input[name="export-part"]:not(:disabled)')?.focus({ preventScroll: true });
          list.closest<HTMLElement>(".service-rail")?.scrollTo(0, 0);
        } else openSheet();
        status.textContent = selectionStatus.textContent;
      });
      root.addEventListener("cx-selector-close", event => {
        const resuming = (event as CustomEvent<{ resume: boolean }>).detail.resume;
        if (resuming) {
          suspended = false;
          if (returnButton) returnButton.hidden = true;
          announce(selection, false);
        }
        if (sheet.open) {
          closingSelector = true;
          restoreTo = resuming ? null : returnButton;
          sheet.close();
        } else if (!resuming) returnButton?.focus({ preventScroll: true });
      });
      root.querySelector("[data-parts-done]")?.addEventListener("click", () => {
        if (suspended) editorHandle?.resume();
        else sheet.close();
      });
      wide.addEventListener("change", event => {
        tools.open = event.matches;
        if (event.matches && sheet.open) { closingSelector = true; restoreTo = lastBox; sheet.close(); }
        else if (!event.matches && suspended && history.state?.cxParts) openSheet();
      });
    }
    if (!rail) {
      root.addEventListener("cx-choose-parts", event => {
        suspended = true;
        if (returnButton) returnButton.hidden = false;
        status.textContent = (event as CustomEvent<string>).detail;
        const list = root.querySelector<HTMLDetailsElement>(".parts");
        if (list) { list.hidden = false; list.open = true; }
        root.querySelector<HTMLInputElement>('input[name="export-part"]')?.focus({ preventScroll: true });
      });
      root.addEventListener("cx-selector-close", event => {
        const list = root.querySelector<HTMLDetailsElement>(".parts");
        if (list) list.open = false;
        if ((event as CustomEvent<{ resume: boolean }>).detail.resume) {
          suspended = false;
          status.textContent = "";
          if (returnButton) returnButton.hidden = true;
        } else returnButton?.focus({ preventScroll: true });
      });
    }
    const boxes = [...root.querySelectorAll<HTMLInputElement>('input[name="export-part"]')];

    const availableBoxes = () => boxes.filter(box => !box.disabled);
    if (service) {
      const available = availableBoxes();
      const defaults = day?.defaults.find(d => d.option === service.option?.key && d.group === service.group);
      if (defaults) {
        const included = new Set(defaults.included);
        available.forEach(box => { box.checked = included.has(box.value); });
      }
      root.querySelectorAll("[data-total-parts]").forEach(node => { node.textContent = String(available.length); });
      const note = formatDefaultsNote(defaults?.unticked ?? [], service.iso ? serviceDateLabel(service.iso) : null);
      const node = root.querySelector<HTMLElement>("[data-defaults-note]")!;
      node.textContent = note; node.hidden = !note;
    }
    function daySummary(): string {
      if (!service || !day) return "";
      const summary = serviceSummary(service,
        availableBoxes().filter(b => b.checked && ["gradual", "tract", "alleluia"].includes(b.dataset["part"] ?? "")).map(b => b.dataset["label"] ?? ""),
        day.unavailable);
      root!.querySelector<HTMLElement>("[data-day-summary]")!.textContent = summary;
      return summary;
    }
    daySummary();
    const inline = rail ? [...document.querySelectorAll<HTMLInputElement>("[data-inline-part]")] : [];
    inline.forEach(box => {
      const original = boxes.find(b => b.value === box.dataset["inlinePart"]);
      if (!original) return;
      box.checked = original.checked;
      box.closest<HTMLElement>(".include")!.hidden = false;
      box.addEventListener("change", () => {
        if (original.disabled) { box.checked = false; return; }
        original.checked = box.checked;
        original.dispatchEvent(new Event("change", { bubbles: true }));
      });
    });
    root.addEventListener("selectionchange", event => {
      const selected = (event as CustomEvent<Selection>).detail;
      inline.forEach(box => { box.checked = selected.segments.find(s => s.id === box.dataset["inlinePart"])?.included ?? false; });
      renderCapabilities(selected);
      announce(selected);
    });
    function renderCapabilities(selected: Selection): void {
      selected.segments.forEach(s => {
        const cap = root!.querySelector<HTMLElement>(`[data-capability="${CSS.escape(s.id)}"]`);
        if (cap) cap.textContent = [...new Set(s.runs.map(r => r.representation === "scan" || r.capability === "scan" ? "Scans" : r.capability === "mei" ? "Customizable typeset" : "Typeset"))].join(" · ");
      });
    }
    function announce(selected: Selection, live = true): void {
      if (!rail) return;
      const { refs, parts, ticked } = quickRequest(selected, paper());
      root!.querySelectorAll("[data-ticked]").forEach(node => { node.textContent = String(ticked); });
      const problem = validateSelection(refs.length, parts);
      const key = JSON.stringify([selected.segments.filter(s => s.included).map(s => s.id).sort(), problem]);
      daySummary();
      const summary = `${ticked} of ${selected.segments.length} parts, ${refs.length} systems${problem ? `. ${problem}` : ""}`;
      document.getElementById("selection-status")!.textContent = summary;
      if (!live) { status!.textContent = ''; return; }
      if (key === announcedSelection) return;
      announcedSelection = key;
      status!.classList.add("sr-only");
      status!.textContent = summary;
    }
    root.querySelector("[data-select-all]")?.addEventListener("click", () => setAll(true));
    root.querySelector("[data-clear]")?.addEventListener("click", () => setAll(false));
    function setAll(checked: boolean): void {
      boxes.forEach(box => { box.checked = checked && !box.disabled; });
      boxes[0]?.dispatchEvent(new Event("change", { bubbles: true }));
    }
    let selection: Selection = selectionFromBoxes(boxes, title, showsScans);
    const paper = (): Paper => paperSelect?.value === "a4" ? "a4" : "letter";
    // The server already rendered the summary. Representation changes keep the
    // same stems (and system count), so only inclusion or refusal changes announce.
    const initialRequest = quickRequest(selection, paper());
    let announcedSelection = JSON.stringify([selection.segments.filter(s => s.included).map(s => s.id).sort(),
      validateSelection(initialRequest.refs.length, initialRequest.parts)]);

    // The model is rebuilt on every change (a tick, the page-wide switch, a part's own switch, a part that
    // failed to load) and announced once per real change. The bar's own text and buttons still change only
    // when a tick does, so a switch mid-build never re-enables Export or clears its status.
    function update(): void {
      const next = selectionFromBoxes(boxes, title, showsScans);
      if (JSON.stringify(next) === JSON.stringify(selection)) return;
      selection = next;
      root!.dispatchEvent(new CustomEvent("selectionchange", { bubbles: true, detail: selection }));
    }

    function refresh(): void {
      update();
      const { refs, parts, ticked } = quickRequest(selection, paper());
      if (tickedCount) tickedCount.textContent = String(ticked);
      const problem = validateSelection(refs.length, parts);
      button!.disabled = problem !== null;
      if (customize) customize.disabled = problem !== null;
      button!.textContent = refs.length === 0
        ? "Tick at least one part"
        : `Export PDF (${refs.length} system${refs.length === 1 ? "" : "s"}, ~${estimatePages(refs.length)} page${estimatePages(refs.length) === 1 ? "" : "s"})`;
      status!.removeAttribute("data-state");
      if (!rail) status!.textContent = problem ?? "";
    }
    if (rail) { renderCapabilities(selection); announce(selection, false); }
    if (service) refresh();
    boxes.forEach((b) => b.addEventListener("change", refresh));
    document.addEventListener("typeset-view", update);
    new MutationObserver((changes) => {
      if (changes.some((c) => c.target instanceof HTMLElement && c.target.matches("[data-typeset-key]"))) update();
    }).observe(document.body, { subtree: true, attributes: true, attributeFilter: ["data-show", "data-state"] });

    // The editor adds #customize-export while open. A stale one in a loaded URL is stripped, and never opens it.
    if (location.hash === "#customize-export") history.replaceState(history.state, "", location.pathname + location.search);

    // Everything the editor needs (the dialog code, the manifest, the selection snapshot) is imported on click:
    // until then this page loads no Verovio, workers, pdf.js or export fonts.
    customize?.addEventListener("click", async () => {
      if (suspended && editorHandle) { editorHandle.resume(); return; }
      if (customize.getAttribute("aria-busy") === "true") return;
      const idle = customize.textContent ?? "Customize export";
      customize.setAttribute("aria-busy", "true");
      customize.textContent = "Opening…";
      try {
        const [editor, mei] = await Promise.all([
          import("../scripts/exportLayout"), import("../lib/mei"),
        ]);
        await editor.stylesReady;
        const manifest = mei.loadManifest();
        update();
        editorHandle = editor.openExportEditor({
          selection,
          readSelection: () => { update(); return selection; },
          lookup: (target, hash) => mei.approvedConversionFor(target, hash, manifest),
          title: title.replace(/ — Nova Organi Harmonia$/, ""),
          opener: customize,
          onExported: (s, printed) => trackExport("custom", {
            page: s.page, orientation: s.orientation, staff: s.staff,
            maxSystems: s.maxSystems === null ? "auto" : String(s.maxSystems), linePolicy: s.linePolicy,
            chant: s.chant, chantParts: String(printed),
          }),
        });
      } catch {
        status.classList.remove("sr-only");
        status.setAttribute("data-state", "error");
        status.textContent = "Can't open the layout editor. Try again, or use Export PDF.";
      } finally {
        customize.removeAttribute("aria-busy");
        customize.textContent = idle;
      }
    });

    button.addEventListener("click", () => {
      update();
      const chosenPaper = paper();
      const { refs, headings, typeset } = quickRequest(selection, chosenPaper);
      if (validateSelection(refs.length) !== null) return;
      const idleLabel = button.textContent ?? "Export PDF";
      button.disabled = true;
      status.removeAttribute("data-state");
      status.classList.remove("sr-only");
      status.textContent = "Preparing…";
      progress.max = refs.length;
      progress.value = 0;
      progress.hidden = false;
      root.setAttribute("aria-busy", "true");

      const worker = new Worker(
        new URL("../workers/pdf.worker.ts", import.meta.url),
        { type: "module" },
      );

      worker.onmessage = (event: MessageEvent<BuildResponse>) => {
        const message = event.data;
        if (message.kind === "progress") {
          progress.value = message.done;
          status.textContent = `Building PDF — system ${message.done} of ${message.total}`;
          return;
        }

        root.removeAttribute("aria-busy");
        progress.hidden = true;
        button.disabled = false;
        button.textContent = idleLabel;

        if (message.kind === "error") {
          status.setAttribute("data-state", "error");
          status.textContent = message.message;
          worker.terminate();
          return;
        }

        const bytes = new Uint8Array(message.bytes);
        const blob = new Blob([bytes.buffer as ArrayBuffer], { type: "application/pdf" });
        const url = URL.createObjectURL(blob);
        const link = document.createElement("a");
        link.href = url;
        link.download = `${title.replace(/[^\w\- ]+/g, "").trim() || "export"}.pdf`;
        document.body.appendChild(link);
        link.click();
        link.remove();
        URL.revokeObjectURL(url);

        const size = (blob.size / 1_048_576).toFixed(1);
        const missed = message.fallbacks.length > 0
          ? ` The typeset music for ${message.fallbacks.join(", ")} could not be fetched, so its scans are in the PDF.`
          : "";
        status.textContent = `PDF ready — ${refs.length} systems, ${message.pages} pages, ${size} MB.${missed}`;
        worker.terminate();
      };

      const request: BuildRequest = { refs, base: "", title, headings, paper: chosenPaper, typeset };
      worker.postMessage(request);
      trackExport("quick", { paper: chosenPaper });
    });
  }
</script>
