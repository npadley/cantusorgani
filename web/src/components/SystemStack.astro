---
import { jumpTargets, pagesLabel, systemUrlStem, volumeLabel, sectionName } from "../lib/catalog";
import { annotationFor, chantEntry } from "../lib/chants";
import type { JumpTarget, Piece } from "../lib/catalog";
import { segmentKey, segments } from "../lib/typeset";
import ReportLinks from "./ReportLinks.astro";

interface Props {
  readonly piece: Piece;
  readonly id?: string;
  readonly anchorPrefix?: string;
}

const { piece, id = "music", anchorPrefix = "" } = Astro.props;
const captionId = `${id}-caption`;

// Render every system at one consistent scale. At width:100% a short system
// would appear LARGER than a long one, inverting the relationship printed on the
// page — the Kyrie's half-length intonation would dwarf a full system.
const widest = Math.max(1, ...piece.systemAspect.map(([w]) => w));
// A heading above the first system of each movement and hymn: the jump links' targets.
const startsAt = new Map<number, JumpTarget[]>();
for (const t of jumpTargets(piece)) startsAt.set(t.index, [...(startsAt.get(t.index) ?? []), { ...t, anchor: `${anchorPrefix}${t.anchor}` }]);
// Typeset music, where a transcription is matched: each segment of systems is
// either drawn by LilyPond (with its scans behind a switch) or scanned.
const parts = segments(piece);
// What the book prints beside a section, where known: its margin label and its
// opening words ("2. Grad. I · In sole posuit"), less whatever the heading
// already says (a hymn is named by its opening words).
const printedAs = (t: { label: string; printed?: string | null; title?: string | null }): string =>
  [t.printed, t.title].filter((x): x is string => Boolean(x) && x !== t.label).join(" · ");
const partName = (start: number): string => (startsAt.get(start) ?? []).at(-1)?.label ?? piece.title;
---

{piece.systems.length === 0 ? (
  piece.reference ? null : (
    <div class="notice" role="status">
      <strong>No music of its own.</strong> The book gives this day at printed
      page {piece.printedPages[0]}{piece.pagination ? ` of its ${piece.pagination}` : ""} of {volumeLabel(piece)} without music of its own,
      usually with a rubric sending the reader to another Mass.
    </div>
  )
) : (
  <figure class="systems" id={id} role="group" aria-labelledby={captionId}>
    <figcaption id={captionId} class="sr-only">
      {piece.title}
      {piece.mode ? `, mode ${piece.mode}` : ", mode not recorded"},
      organ accompaniment from {volumeLabel(piece)}, {pagesLabel(piece)}, shown as
      {" "}{piece.systems.length} scanned music systems. These are images of a
      1942 printed score and cannot be read by a screen reader.
    </figcaption>

    {parts.map((seg) => (
      <>
      {Array.from({ length: seg.end - seg.start }, (_, k) => seg.start + k).map((i) => {
        const starts = i === seg.start ? startsAt.get(i) ?? [] : [];
        return starts.map((start) => {
          if (start.kind === "hymn") {
            return <h2 class={`movement-heading ${start.kind}`} id={start.anchor}>{start.label}</h2>;
          }
          const entry = chantEntry(start.chantId);
          const [annotation, mode] = entry ? annotationFor(entry.part, entry.mode) : ["", ""];
          return (
            <>
              <div class="part-head">
                {start.kind === "chant"
                  ? <span class="chant-only-label ui small muted" id={start.anchor}>Chant</span>
                  : <h2 class={`movement-heading ${start.kind}`} id={start.anchor}>{start.label}{printedAs(start) && (
                      <span class="printed-as"> · {printedAs(start)}</span>)}</h2>}
                {start.chantUrl && (
                  <a class="chant-link ui no-print" href={start.chantUrl} target="_blank" rel="noopener">
                    {start.kind === "chant" ? "GregoBase" : "Chant"}<span class="sr-only"> for the {start.label} (GregoBase, opens in new tab)</span>
                  </a>
                )}
                {start.target && <ReportLinks target={start.target} name={start.label} />}
              </div>
              {start.source && <p class="ui small muted source-page">Music from {start.source}.</p>}
              {entry && (
                <div class="chant-notation" hidden data-chant-id={entry.id} data-incipit={entry.incipit}
                     data-annotation={annotation} data-mode={mode}>
                  <p class="chant-credit ui small muted">Chant from <a href={start.chantUrl ?? "https://gregobase.selapa.net"}>GregoBase</a></p>
                </div>
              )}
            </>
          );
        });
      })}
      <div class={seg.render ? "segment typeset-segment" : "segment"} data-typeset={seg.render ? "" : undefined}
           data-typeset-key={seg.render ? segmentKey(piece, seg.start) : undefined}>
        {seg.render && (
          <div class="typeset">
            <picture>
              <source media="(min-width: 40rem)" srcset={seg.render.wide} type="image/svg+xml" />
              <img class="typeset-music" src={seg.render.narrow} alt={`${partName(seg.start)}: the music, typeset`}
                   loading={seg.start < 3 ? "eager" : "lazy"} decoding="async" data-first-system={seg.start + 1} />
            </picture>
            <p class="typeset-note ui small muted no-print">
              <span class="typeset-state">{seg.render.proofread ? "Typeset, proofread" : "Typeset, not yet proofread"}</span>
              · <a href="/about/#typeset">from the volunteers' transcription</a>
              · <button type="button" class="link show-scan" aria-expanded="false">Show the scan</button>
            </p>
          </div>
        )}
        <div class="scans">
          {Array.from({ length: seg.end - seg.start }, (_, k) => seg.start + k).map((i) => {
            const ref = piece.systems[i] ?? "";
            const aspect = piece.systemAspect[i] ?? [1600, 400];
            const relative = (aspect[0] / widest) * 100;
            const stem = systemUrlStem(piece, i);
            return (
              <div
                class="system-slot"
                style={`aspect-ratio:${aspect[0]}/${aspect[1]}; width:${relative.toFixed(2)}%`}
              >
                <img
                  class="system"
                  src={`${stem}.webp`}
                  srcset={`${stem}.webp 1x, ${stem}@2x.webp 2x`}
                  sizes="(min-width: 62rem) 60rem, 100vw"
                  width={aspect[0]}
                  height={aspect[1]}
                  loading={i < 2 && !seg.render ? "eager" : "lazy"}
                  decoding="async"
                  fetchpriority={i === 0 && !seg.render ? "high" : "auto"}
                  alt=""
                  data-ref={ref}
                  data-index={i + 1}
                  data-total={piece.systems.length}
                />
              </div>
            );
          })}
        </div>
      </div>
      </>
    ))}
  </figure>
)}

{piece.parts.filter((p) => p.kind === "borrowed").map((p) => (
  p.kind === "borrowed" && <p class="notice ui small" role="status">
    {sectionName(p)}: the book refers to {p.borrowedVolume ? volumeLabel({ ...piece, volume: p.borrowedVolume }) : "another volume"},
    printed page {p.borrowedPage}. The exact music systems for this reference have not yet been identified.
  </p>
))}

<style>
  .systems { margin: 0; padding: 0; }

  /* A jump link lands here: clear of the viewport edge, never under the music. */
  .movement-heading {
    font-family: var(--font-ui); font-size: var(--step-0); font-weight: 600;
    margin: var(--s-4) 0 var(--s-2); scroll-margin-top: var(--s-4);
  }
  .movement-heading.hymn { font-style: italic; font-weight: 500; }
  .printed-as { font-weight: 400; color: var(--ink-muted); }

  /* The heading is never the link: a stray tap mid-service stays on the music. */
  .part-head { display: flex; align-items: baseline; gap: var(--s-3); margin: var(--s-4) 0 var(--s-2); }
  .part-head .movement-heading { margin: 0; }
  .source-page { margin: 0 0 var(--s-2); }
  /* Exsurge draws in currentColor, so the chant follows the theme. */
  .chant-notation { color: var(--ink); margin: 0 0 var(--s-3); --exsurge-negative-fill: var(--paper); }
  .chant-notation :global(svg) { display: block; max-width: 100%; height: auto; }
  /* Glyph paths carry no fill: they take the <use> element's, black unless set. */
  .chant-notation :global(svg use) { fill: currentColor; }
  .chant-notation :global(.chant-error) { margin: 0; }
  .chant-credit { margin: var(--s-1) 0 0; }
  .chant-only-label { scroll-margin-top: var(--s-4); }
  .chant-link {
    font-size: var(--step--1); color: var(--ink-muted);
    min-height: var(--tap-min); display: inline-flex; align-items: center;
  }

  /* The slot reserves each system's exact height from its recorded aspect ratio.
     Without this the page reflows as slices load, which is the worst possible
     behaviour for someone following music on a tablet. */
  .system-slot {
    /* width is set inline, proportional to the widest system in the piece */
    max-width: 100%;
    margin: 0 0 var(--s-4);
    background: transparent;
    position: relative;
  }

  /* Typeset music. Its scans stay in the page, hidden (lazy images in a hidden
     block do not load), until the page-wide switch or the part's own asks. */
  .typeset { margin: 0 0 var(--s-4); }
  .typeset picture, .typeset-music { display: block; width: 100%; height: auto; }
  .typeset-note { margin: var(--s-1) 0 0; }
  .typeset-note .link { background: none; border: 0; padding: 0; min-height: var(--tap-min); font: inherit;
                        color: var(--accent); text-decoration: underline; cursor: pointer; }
  .typeset-segment .scans { display: none; }
  .typeset-segment[data-show="scan"] .scans { display: block; }
  .typeset-segment[data-show="scan"] .typeset picture { display: none; }
  :global(:root[data-view="scans"]) .typeset-segment:not([data-show="typeset"]) .scans { display: block; }
  :global(:root[data-view="scans"]) .typeset-segment:not([data-show="typeset"]) .typeset { display: none; }
  .typeset-segment[data-state="error"] .scans { display: block; }
  .typeset-segment[data-state="error"] .typeset picture { display: none; }

  .system {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Flat, not a shimmer: motion under sight-reading is worse than stillness. */
  .system-slot:has(img:not([data-loaded])) { background: color-mix(in srgb, var(--rule) 22%, transparent); }

  .system-slot[data-state="error"] { background: var(--warn-bg); }
  .system-slot[data-state="error"] img { display: none; }
  .system-slot[data-state="error"]::after {
    content: attr(data-message);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3);
    text-align: center;
    color: var(--warn-ink);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
</style>

<script is:inline>
  // Typeset music: a part's own "Show the scan" switch, and falling back to the
  // scans when the drawing cannot be loaded. The page-wide switch is in Layout.
  document.querySelectorAll("[data-typeset]").forEach(function (seg) {
    var button = seg.querySelector(".show-scan");
    var img = seg.querySelector("img.typeset-music");
    function scansShown() {
      var root = document.documentElement.getAttribute("data-view") === "scans";
      return seg.getAttribute("data-show") === "scan" || (root && seg.getAttribute("data-show") !== "typeset");
    }
    function sync() {
      if (!button) return;
      var on = scansShown();
      button.textContent = on ? "Show the typeset music" : "Show the scan";
      button.setAttribute("aria-expanded", on ? "true" : "false");
    }
    if (button) {
      button.addEventListener("click", function () {
        seg.setAttribute("data-show", scansShown() ? "typeset" : "scan");
        sync();
      });
    }
    document.addEventListener("typeset-view", sync);
    sync();
    function failed() {
      seg.setAttribute("data-state", "error");
      var note = seg.querySelector(".typeset-state");
      if (note) note.textContent = "The typeset music could not be loaded; the scan is shown";
      if (button) button.hidden = true;
    }
    if (img) {
      img.addEventListener("error", failed);
      // It may have failed before this ran.
      if (img.complete && img.naturalWidth === 0 && img.currentSrc) failed();
    }
  });

  // A missing slice must never collapse its slot: a silently absent system sends
  // an organist to the bench with a bar missing.
  document.querySelectorAll("img.system").forEach(function (img) {
    function loaded() { img.setAttribute("data-loaded", "true"); }
    if (img.complete && img.naturalWidth > 0) loaded();
    img.addEventListener("load", loaded);
    img.addEventListener("error", function () {
      var slot = img.closest(".system-slot");
      if (!slot) return;
      slot.setAttribute("data-state", "error");
      slot.setAttribute(
        "data-message",
        "System " + img.dataset.index + " of " + img.dataset.total +
          " could not be loaded. The rest of this piece is shown below."
      );
    });
  });
</script>
