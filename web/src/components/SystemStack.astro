---
import { jumpTargets, systemUrlStem, volumeLabel } from "../lib/catalog";
import type { JumpTarget, Piece } from "../lib/catalog";

interface Props {
  readonly piece: Piece;
  readonly id?: string;
}

const { piece, id = "music" } = Astro.props;
const captionId = `${id}-caption`;

// Render every system at one consistent scale. At width:100% a short system
// would appear LARGER than a long one, inverting the relationship printed on the
// page — the Kyrie's half-length intonation would dwarf a full system.
const widest = Math.max(1, ...piece.systemAspect.map(([w]) => w));
// A heading above the first system of each movement and hymn: the jump links' targets.
const startsAt = new Map<number, JumpTarget[]>();
for (const t of jumpTargets(piece)) startsAt.set(t.index, [...(startsAt.get(t.index) ?? []), t]);
---

{piece.systems.length === 0 ? (
  piece.reference ? null : (
    <div class="notice" role="status">
      <strong>No music of its own.</strong> The book gives this day at printed
      page {piece.printedPages[0]} of {volumeLabel(piece)} without music of its own,
      usually with a rubric sending the reader to another Mass.
    </div>
  )
) : (
  <figure class="systems" id={id} role="group" aria-labelledby={captionId}>
    <figcaption id={captionId} class="sr-only">
      {piece.title}
      {piece.mode ? `, mode ${piece.mode}` : ", mode not recorded"},
      organ accompaniment from Nova Organi Harmonia part V, printed pages
      {" "}{piece.printedPages[0]}–{piece.printedPages[1]}, shown as
      {" "}{piece.systems.length} scanned music systems. These are images of a
      1942 printed score and cannot be read by a screen reader.
    </figcaption>

    {piece.systems.map((ref, i) => {
      const aspect = piece.systemAspect[i] ?? [1600, 400];
      const relative = (aspect[0] / widest) * 100;
      const stem = systemUrlStem(piece, i);
      const starts = startsAt.get(i) ?? [];
      return (
        <>
        {starts.map((start) => start.kind === "part" ? (
          <div class="part-head">
            <h2 class="movement-heading part" id={start.anchor}>{start.label}</h2>
            {start.chantUrl && (
              <a class="chant-link ui no-print" href={start.chantUrl} target="_blank" rel="noopener">
                Chant<span class="sr-only"> for the {start.label} (GregoBase, opens in new tab)</span>
              </a>
            )}
          </div>
        ) : (
          <h2 class={`movement-heading ${start.kind}`} id={start.anchor}>{start.label}</h2>
        ))}
        <div
          class="system-slot"
          style={`aspect-ratio:${aspect[0]}/${aspect[1]}; width:${relative.toFixed(2)}%`}
        >
          <img
            class="system"
            src={`${stem}.webp`}
            srcset={`${stem}.webp 1x, ${stem}@2x.webp 2x`}
            sizes="(min-width: 62rem) 60rem, 100vw"
            width={aspect[0]}
            height={aspect[1]}
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
            fetchpriority={i === 0 ? "high" : "auto"}
            alt=""
            data-ref={ref}
            data-index={i + 1}
            data-total={piece.systems.length}
          />
        </div>
        </>
      );
    })}
  </figure>
)}

<style>
  .systems { margin: 0; padding: 0; }

  /* A jump link lands here: clear of the viewport edge, never under the music. */
  .movement-heading {
    font-family: var(--font-ui); font-size: var(--step-0); font-weight: 600;
    margin: var(--s-4) 0 var(--s-2); scroll-margin-top: var(--s-4);
  }
  .movement-heading.hymn { font-style: italic; font-weight: 500; }

  /* The heading is never the link: a stray tap mid-service stays on the music. */
  .part-head { display: flex; align-items: baseline; gap: var(--s-3); margin: var(--s-4) 0 var(--s-2); }
  .part-head .movement-heading { margin: 0; }
  .chant-link {
    font-size: var(--step--1); color: var(--ink-muted);
    min-height: var(--tap-min); display: inline-flex; align-items: center;
  }

  /* The slot reserves each system's exact height from its recorded aspect ratio.
     Without this the page reflows as slices load, which is the worst possible
     behaviour for someone following music on a tablet. */
  .system-slot {
    /* width is set inline, proportional to the widest system in the piece */
    max-width: 100%;
    margin: 0 0 var(--s-4);
    background: transparent;
    position: relative;
  }

  .system {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Flat, not a shimmer: motion under sight-reading is worse than stillness. */
  .system-slot:has(img:not([data-loaded])) { background: color-mix(in srgb, var(--rule) 22%, transparent); }

  .system-slot[data-state="error"] { background: var(--warn-bg); }
  .system-slot[data-state="error"] img { display: none; }
  .system-slot[data-state="error"]::after {
    content: attr(data-message);
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--s-3);
    text-align: center;
    color: var(--warn-ink);
    font-family: var(--font-ui);
    font-size: var(--step--1);
  }
</style>

<script is:inline>
  // A missing slice must never collapse its slot: a silently absent system sends
  // an organist to the bench with a bar missing.
  document.querySelectorAll("img.system").forEach(function (img) {
    function loaded() { img.setAttribute("data-loaded", "true"); }
    if (img.complete && img.naturalWidth > 0) loaded();
    img.addEventListener("load", loaded);
    img.addEventListener("error", function () {
      var slot = img.closest(".system-slot");
      if (!slot) return;
      slot.setAttribute("data-state", "error");
      slot.setAttribute(
        "data-message",
        "System " + img.dataset.index + " of " + img.dataset.total +
          " could not be loaded. The rest of this piece is shown below."
      );
    });
  });
</script>
