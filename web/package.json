{
  "name": "cantusorgani-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/with-public-env.ts astro dev",
    "build": "node scripts/with-public-env.ts astro build && node scripts/build-discovery.ts && rm -rf dist/systems && pagefind --site dist && node scripts/check-links.ts && node scripts/check-no-fixture.ts dist",
    "build:e2e": "E2E_TEST_PAGES=1 PUBLIC_MEI_MANIFEST=fixture PUBLIC_ASSET_BASE=/systems node scripts/with-public-env.ts astro build --outDir dist-e2e",
    "serve:device": "node scripts/serve-device-test.ts",
    "check:no-fixture": "node scripts/check-no-fixture.ts dist",
    "check:export-assets": "node scripts/check-export-assets.ts",
    "check:r2-headers": "node scripts/check-r2-headers.ts",
    "check:preview": "node scripts/check-preview.ts",
    "check:deploy-size": "node scripts/check-deploy-size.ts",
    "check:links": "node scripts/check-links.ts",
    "preview": "astro preview",
    "ui:screenshots": "node scripts/ui-screenshots.ts",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:export": "E2E_DIST=dist-e2e playwright test e2e/export- e2e/pdf-contents",
    "check:seo": "node scripts/build-discovery.ts"
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@pdf-lib/fontkit": "1.1.1",
    "@xmldom/xmldom": "0.9.12",
    "astro": "^7.4.2",
    "codemirror": "^6.0.2",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "verovio": "6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "pagefind": "^1.3.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
