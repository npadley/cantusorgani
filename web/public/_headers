/admin/*
  X-Robots-Tag: noindex, nofollow
/search/
  X-Robots-Tag: noindex, follow
/corrections/
  X-Robots-Tag: noindex, follow
/chant/*
  X-Robots-Tag: noindex
/corrections/targets.json
  X-Robots-Tag: noindex
https://cantusorgani.pages.dev/*
  X-Robots-Tag: noindex
# Cloudflare also supplies noindex for its preview deployments.
https://:preview.cantusorgani.pages.dev/*
  X-Robots-Tag: noindex

# Astro hashes these filenames; changed content gets a new URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
# Stable filenames need a bounded lifetime, including the export fonts.
/fonts/*
  Cache-Control: public, max-age=604800
/vendor/*
  Cache-Control: public, max-age=604800
