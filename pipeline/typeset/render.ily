% House style for rendering the site's pictures and PDFs: appended after a
% transcription by pipeline/typeset/render.py, so it overrides the file's own
% page settings. No titles or running heads: the site's page names the part,
% and the credit goes under the music.
\paper {
  bookTitleMarkup = ##f
  scoreTitleMarkup = ##f
  oddHeaderMarkup = ##f
  evenHeaderMarkup = ##f
  oddFooterMarkup = ##f
  evenFooterMarkup = ##f
  print-page-number = ##f
  tagline = ##f
  indent = 0
  short-indent = 0
  top-margin = 2\mm
  bottom-margin = 2\mm
  % Room for the brace and bracket at the start of each line.
  left-margin = 4\mm
  right-margin = 1\mm
}
