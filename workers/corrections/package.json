{
  "name": "cantusorgani-corrections",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "migrate:local": "wrangler d1 migrations apply cantusorgani-corrections --local",
    "migrate:remote": "wrangler d1 migrations apply cantusorgani-corrections --remote",
    "backup": "wrangler d1 export cantusorgani-corrections --output backups/$(date -u +%Y%m%dT%H%M%SZ).sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260928.1",
    "@vitest/coverage-v8": "^5.0.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.142.0"
  }
}
