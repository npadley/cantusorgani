{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "cantusorgani-web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "dev",
        "--port",
        "4321"
      ],
      "port": 4321
    },
    {
      "name": "cantusorgani-prod-preview",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "web",
        "preview",
        "--port",
        "4322"
      ],
      "port": 4322
    },
    {
      "name": "cantusorgani-web-public",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PUBLIC_ASSET_BASE=https://images.cantusorgani.org",
        "pnpm",
        "--dir",
        "web",
        "exec",
        "astro",
        "dev",
        "--port",
        "4323"
      ],
      "port": 4323
    },
    {
      "name": "cantusorgani-admin-local",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web && exec npx wrangler pages dev dist --port 8788 --binding EDITORS=editor@example.org --binding ADMIN_DEV_EMAIL=editor@example.org"
      ],
      "port": 8788
    }
  ]
}
