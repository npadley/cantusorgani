{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cantusorgani.org/schema/identities.json",
  "title": "Phase 1 identity registry, ledger and derived graph",
  "$comment": "Registry fields use the M1 validator; graph schemas also use anyOf and typed maps. Cross-record ownership, uniqueness, structural binding and coverage are checked by pipeline.identities.",
  "$ref": "#/$defs/sourceRegistry",
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "nullableText": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "sourceKey": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "nullableSourceKey": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^src_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "editionId": {
      "type": "string",
      "pattern": "^edn_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "source": {
      "type": "object",
      "required": [
        "id",
        "title",
        "short_title",
        "licence_reference"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/sourceId"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "short_title": {
          "$ref": "#/$defs/text"
        },
        "licence_reference": {
          "$ref": "#/$defs/nullableText"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "editionPolicy": {
      "type": "object",
      "required": [
        "show_related_hymns",
        "borrow_whole_reference",
        "related_hymns_heading",
        "reference_group"
      ],
      "properties": {
        "show_related_hymns": {
          "type": "boolean"
        },
        "borrow_whole_reference": {
          "type": "boolean"
        },
        "related_hymns_heading": {
          "$ref": "#/$defs/nullableText"
        },
        "reference_group": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "additionalProperties": false
    },
    "edition": {
      "type": "object",
      "required": [
        "id",
        "source_id",
        "legacy_volume",
        "title",
        "part",
        "citation_label",
        "short_label",
        "sort_order",
        "adapter",
        "scan_registry_key",
        "publication_note",
        "provenance_reference",
        "rights_reference",
        "rights_state",
        "policy"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/editionId"
        },
        "source_id": {
          "$ref": "#/$defs/sourceId"
        },
        "legacy_volume": {
          "$ref": "#/$defs/nullableSourceKey"
        },
        "title": {
          "$ref": "#/$defs/text"
        },
        "part": {
          "$ref": "#/$defs/nullableText"
        },
        "citation_label": {
          "$ref": "#/$defs/text"
        },
        "short_label": {
          "$ref": "#/$defs/text"
        },
        "sort_order": {
          "type": "integer"
        },
        "adapter": {
          "$ref": "#/$defs/sourceKey"
        },
        "scan_registry_key": {
          "$ref": "#/$defs/nullableSourceKey"
        },
        "publication_note": {
          "$ref": "#/$defs/nullableText"
        },
        "provenance_reference": {
          "$ref": "#/$defs/nullableText"
        },
        "rights_reference": {
          "$ref": "#/$defs/nullableText"
        },
        "rights_state": {
          "enum": [
            "unknown",
            "cleared",
            "withdrawn"
          ]
        },
        "policy": {
          "$ref": "#/$defs/editionPolicy"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "sourceRegistry": {
      "type": "object",
      "required": [
        "schema_version",
        "sources",
        "editions"
      ],
      "properties": {
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "editions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edition"
          }
        }
      },
      "additionalProperties": false
    },
    "ledger": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "namespace": {
          "$ref": "#/$defs/text"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ledgerEntry"
          }
        }
      },
      "required": [
        "schema_version",
        "namespace",
        "entries"
      ],
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "properties": {
        "schema_version": {
          "const": 1,
          "type": "integer"
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "editions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/edition"
          }
        },
        "works": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/work"
          }
        },
        "source_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceItem"
          }
        },
        "settings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          }
        },
        "representations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/representation"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/relation"
          }
        }
      },
      "required": [
        "schema_version",
        "sources",
        "editions",
        "works",
        "source_items",
        "settings",
        "representations",
        "relations"
      ],
      "additionalProperties": false
    },
    "itemId": {
      "type": "string",
      "pattern": "^itm_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^wrk_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "settingId": {
      "type": "string",
      "pattern": "^set_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "representationId": {
      "type": "string",
      "pattern": "^rep_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "assignmentId": {
      "type": "string",
      "pattern": "^asg_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "id": {
      "type": "string",
      "pattern": "^(src|edn|itm|wrk|set|rep|asg|tgt)_[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "origin": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/text"
        },
        "selector": {
          "type": "string"
        },
        "legacy_target": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "selector",
        "legacy_target"
      ],
      "additionalProperties": false
    },
    "ledgerLocator": {
      "type": "object",
      "properties": {
        "slug": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "$ref": "#/$defs/text"
        },
        "key": {
          "type": [
            "string",
            "null"
          ]
        },
        "n": {
          "type": [
            "integer",
            "null"
          ]
        },
        "variant": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "slug",
        "kind",
        "key",
        "n",
        "variant"
      ],
      "additionalProperties": false
    },
    "change": {
      "type": "object",
      "properties": {
        "reason": {
          "$ref": "#/$defs/text"
        },
        "old": {
          "$ref": "#/$defs/bindingChange"
        },
        "new": {
          "$ref": "#/$defs/bindingChange"
        }
      },
      "required": [
        "reason",
        "old",
        "new"
      ],
      "additionalProperties": false
    },
    "ledgerEntry": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "source",
            "edition",
            "item",
            "work",
            "setting",
            "representation"
          ]
        },
        "birth_seed": {
          "$ref": "#/$defs/text"
        },
        "state": {
          "enum": [
            "active",
            "retired"
          ]
        },
        "legacy_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "$ref": "#/$defs/text"
              },
              "id": {
                "$ref": "#/$defs/id"
              }
            },
            "required": [
              "role",
              "id"
            ],
            "additionalProperties": false
          }
        },
        "locator": {
          "anyOf": [
            {
              "$ref": "#/$defs/ledgerLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "row_ordinal": {
          "type": [
            "integer",
            "null"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      },
      "required": [
        "id",
        "kind",
        "birth_seed",
        "state",
        "legacy_keys",
        "links",
        "locator",
        "row_ordinal",
        "changes"
      ],
      "additionalProperties": false
    },
    "locator": {
      "type": "object",
      "properties": {
        "pagination": {
          "type": [
            "string",
            "null"
          ]
        },
        "printed_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "item_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "pdf_pages": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "integer"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "system_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "pagination",
        "printed_pages",
        "item_number"
      ],
      "additionalProperties": false
    },
    "externalRef": {
      "type": "object",
      "properties": {
        "authority": {
          "$ref": "#/$defs/text"
        },
        "value": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          }
        }
      },
      "required": [
        "authority",
        "value",
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "work": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/workId"
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string"
        },
        "identity_status": {
          "const": "provisional"
        },
        "external_refs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/externalRef"
          }
        }
      },
      "required": [
        "id",
        "title",
        "language",
        "kind",
        "identity_status",
        "external_refs"
      ],
      "additionalProperties": false
    },
    "sourceItem": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/itemId"
        },
        "edition_id": {
          "$ref": "#/$defs/editionId"
        },
        "parent_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/itemId"
            },
            {
              "type": "null"
            }
          ]
        },
        "classification": {
          "enum": [
            "container",
            "musical-unit",
            "reference",
            "unresolved"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "locator": {
          "$ref": "#/$defs/locator"
        },
        "setting_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/settingId"
          }
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "required": [
        "id",
        "edition_id",
        "parent_id",
        "classification",
        "title",
        "locator",
        "setting_ids",
        "origin"
      ],
      "additionalProperties": false
    },
    "setting": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/settingId"
        },
        "work_id": {
          "$ref": "#/$defs/workId"
        },
        "kind": {
          "enum": [
            "organ-accompaniment",
            "unaccompanied",
            "unspecified"
          ]
        },
        "source_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itemId"
          }
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "rights_reference": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_status": {
          "const": "provisional"
        }
      },
      "required": [
        "id",
        "work_id",
        "kind",
        "source_item_ids",
        "attribution",
        "rights_reference",
        "identity_status"
      ],
      "additionalProperties": false
    },
    "scanLocator": {
      "type": "object",
      "properties": {
        "system_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "asset_stems": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aspects": {
          "type": "array",
          "items": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "system_refs",
        "asset_stems",
        "aspects"
      ],
      "additionalProperties": false
    },
    "lilypondLocator": {
      "type": "object",
      "properties": {
        "source_path": {
          "type": "string"
        },
        "legacy_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "source_path",
        "legacy_target",
        "render_hash",
        "manifest_pointer"
      ],
      "additionalProperties": false
    },
    "meiLocator": {
      "type": "object",
      "properties": {
        "record_path": {
          "type": "string"
        },
        "legacy_target": {
          "type": [
            "string",
            "null"
          ]
        },
        "render_hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "manifest_pointer": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "record_path",
        "legacy_target",
        "render_hash",
        "artifact_sha256",
        "manifest_pointer"
      ],
      "additionalProperties": false
    },
    "representation": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/representationId"
            },
            "kind": {
              "const": "scan"
            },
            "setting_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/settingId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_item_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/itemId"
              }
            },
            "locator": {
              "$ref": "#/$defs/scanLocator"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/origin"
              }
            }
          },
          "required": [
            "id",
            "kind",
            "setting_id",
            "source_item_ids",
            "locator",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/representationId"
            },
            "kind": {
              "const": "lilypond"
            },
            "setting_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/settingId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_item_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/itemId"
              }
            },
            "locator": {
              "$ref": "#/$defs/lilypondLocator"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/origin"
              }
            }
          },
          "required": [
            "id",
            "kind",
            "setting_id",
            "source_item_ids",
            "locator",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/representationId"
            },
            "kind": {
              "const": "mei"
            },
            "setting_id": {
              "anyOf": [
                {
                  "$ref": "#/$defs/settingId"
                },
                {
                  "type": "null"
                }
              ]
            },
            "source_item_ids": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/itemId"
              }
            },
            "locator": {
              "$ref": "#/$defs/meiLocator"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/origin"
              }
            }
          },
          "required": [
            "id",
            "kind",
            "setting_id",
            "source_item_ids",
            "locator",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "relation": {
      "type": "object",
      "properties": {
        "from_id": {
          "$ref": "#/$defs/id"
        },
        "to_id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "borrows",
            "related-hymn",
            "candidate-same-work",
            "same-work"
          ]
        },
        "status": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/origin"
          },
          "minItems": 1
        }
      },
      "required": [
        "from_id",
        "to_id",
        "kind",
        "status",
        "evidence"
      ],
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/assignmentId"
        },
        "calendar": {
          "enum": [
            "ef1962",
            "of1970",
            "vespers1960"
          ]
        },
        "key": {
          "type": "string"
        },
        "slot": {
          "type": "string"
        },
        "variant": {
          "type": "string"
        },
        "years": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "seasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_item_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/itemId"
          }
        },
        "setting_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/settingId"
          }
        },
        "origin": {
          "$ref": "#/$defs/origin"
        }
      },
      "required": [
        "id",
        "calendar",
        "key",
        "slot",
        "variant",
        "years",
        "seasons",
        "source_item_ids",
        "setting_ids",
        "origin"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/text"
        },
        "entity_id": {
          "$ref": "#/$defs/id"
        },
        "legacy_target": {
          "$ref": "#/$defs/text"
        },
        "state": {
          "enum": [
            "active",
            "retired"
          ]
        }
      },
      "required": [
        "kind",
